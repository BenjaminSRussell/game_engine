#version 450

layout(local_size_x = 64) in;

// Includes
// (Assumed available via include handlers or simple structs)

struct InstanceData {
    mat4 model;
    vec4 color;
    uint texture_id;
    uint pad1;
    uint pad2;
    uint pad3;
};

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// Bindings
layout(std140, binding = 0) uniform CameraBuffer {
    mat4 view;
    mat4 projection;
    mat4 view_projection;
    vec4 frustum_planes[6];
    vec3 camera_pos;
} camera;

layout(std430, binding = 1) readonly buffer SourceInstances {
    InstanceData instances[];
};

// We use an atomic counter or a buffer to append visible instances
layout(std430, binding = 2) writeonly buffer VisibleInstanceIndices {
    uint visible_indices[];
};

// Indirect command buffer to update instanceCount
layout(std430, binding = 3) buffer IndirectDraws {
    DrawCommand draws[];
};

// Uniforms
layout(push_constant) uniform PushConstants {
    uint total_instance_count;
    uint batch_index; // Index into Draws array if multiple
    float culling_radius; // Simplified culling
} params;

bool is_visible(vec3 pos, float radius) {
    for (int i = 0; i < 6; i++) {
        if (dot(camera.frustum_planes[i], vec4(pos, 1.0)) < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_instance_count) return;

    // Get instance data
    InstanceData inst = instances[idx];
    
    // Extract position from model matrix (4th column)
    vec3 pos = vec3(inst.model[3][0], inst.model[3][1], inst.model[3][2]);
    
    // Perform culling
    if (is_visible(pos, params.culling_radius)) {
        // Atomic add to get output slot
        // Note: usage of DrawCommand.instanceCount as counter requires it to be reset to 0 before dispatch
        uint out_idx = atomicAdd(draws[params.batch_index].instanceCount, 1);
        
        // Store the original instance index so vertex shader knows which one to fetch
        visible_indices[out_idx] = idx; 
        
        // Note: The Vertex Shader will need to use gl_InstanceIndex to look up `visible_indices`, 
        // then use that to look up `instances`.
        // i.e., uint real_instance_id = visible_indices[gl_InstanceIndex];
        //       InstanceData data = instances[real_instance_id];
    }
}
