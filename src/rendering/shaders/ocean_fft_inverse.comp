#version 460 core

/**
 * =================================================================================================
 *                              OCEAN WATER COMPUTE SHADER - FFT INVERSE
 *                              Agent: AGENT_SHADER_2
 * =================================================================================================
 *
 * Compute shader for performing inverse FFT to convert frequency domain
 * spectrum to spatial domain displacement maps.
 *
 * =================================================================================================
 */

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform FFTInverseUBO {
    int resolution;
    int stage;
    int direction; // 1 for forward, -1 for inverse
    float scale;
} ubo;

layout(rgba32f, binding = 0) uniform image2D input_texture_real;
layout(rgba32f, binding = 1) uniform image2D input_texture_imag;
layout(rgba32f, binding = 2) uniform image2D output_texture_real;
layout(rgba32f, binding = 3) uniform image2D output_texture_imag;

/* =================================================================================================
 *                                    BUTTERFLY OPERATIONS
 * =================================================================================================
 */
vec2 complexMultiply(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

vec2 complexAdd(vec2 a, vec2 b) {
    return a + b;
}

vec2 complexSubtract(vec2 a, vec2 b) {
    return a - b;
}

/* =================================================================================================
 *                                    TWIDDLE FACTORS
 * =================================================================================================
 */
vec2 twiddleFactor(int k, int n) {
    float angle = -2.0 * PI * k / n * ubo.direction;
    return vec2(cos(angle), sin(angle));
}

/* =================================================================================================
 *                                    RADIX-2 BUTTERFLY
 * =================================================================================================
 */
void radix2Butterfly(ivec2 coord, int stride, int n) {
    // Calculate indices for butterfly operation
    int k = coord.x % stride;
    int m = coord.x / stride;
    
    ivec2 idx1 = ivec2(m * stride + k, coord.y);
    ivec2 idx2 = ivec2(m * stride + k + stride, coord.y);
    
    if (idx2.x >= ubo.resolution) return;
    
    // Load complex values
    vec4 real1 = imageLoad(input_texture_real, idx1);
    vec4 imag1 = imageLoad(input_texture_imag, idx1);
    vec4 real2 = imageLoad(input_texture_real, idx2);
    vec4 imag2 = imageLoad(input_texture_imag, idx2);
    
    vec2 val1 = vec2(real1.x, imag1.x);
    vec2 val2 = vec2(real2.x, imag2.x);
    
    // Calculate twiddle factor
    vec2 twiddle = twiddleFactor(k, n);
    
    // Apply twiddle factor to second value
    vec2 val2_twiddled = complexMultiply(val2, twiddle);
    
    // Butterfly operation
    vec2 out1 = complexAdd(val1, val2_twiddled);
    vec2 out2 = complexSubtract(val1, val2_twiddled);
    
    // Scale for inverse transform
    if (ubo.direction < 0) {
        out1 *= ubo.scale;
        out2 *= ubo.scale;
    }
    
    // Store results
    imageStore(output_texture_real, idx1, vec4(out1.x, 0.0, 0.0, 1.0));
    imageStore(output_texture_imag, idx1, vec4(out1.y, 0.0, 0.0, 1.0));
    imageStore(output_texture_real, idx2, vec4(out2.x, 0.0, 0.0, 1.0));
    imageStore(output_texture_imag, idx2, vec4(out2.y, 0.0, 0.0, 1.0));
}

/* =================================================================================================
 *                                    STOCKHAM FFT
 * =================================================================================================
 */
void stockhamFFT(ivec2 coord) {
    int n = ubo.resolution;
    int stride = 1 << ubo.stage;
    
    radix2Butterfly(coord, stride, n);
}

/* =================================================================================================
 *                                    MAIN COMPUTE SHADER
 * =================================================================================================
 */
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    
    if (coord.x >= ubo.resolution || coord.y >= ubo.resolution) {
        return;
    }
    
    // Perform FFT stage
    stockhamFFT(coord);
}
