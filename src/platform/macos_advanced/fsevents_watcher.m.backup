/**
 * =================================================================================================
 *                          FSEVENTS DIRECTORY WATCHER
 *                        macOS Native File System Monitoring
 * =================================================================================================
 *
 * This file implements FSEvents-based directory watching for hot-reload
 * functionality. FSEvents is more efficient than polling and supports watching
 * entire directory trees.
 *
 * Key Features:
 *   - Recursive directory watching with single FSEventStream
 *   - 200ms debounce to batch rapid file changes
 *   - Support for filtering by file extension
 *   - Thread-safe callback system
 *
 * Reference: Apple File System Events Programming Guide
 *
 * =================================================================================================
 */

#import <CoreServices/CoreServices.h>
#import <dispatch/dispatch.h>
#import <pthread.h>
#import <stdatomic.h>

// Lock-free event queue implementation
typedef struct EventQueueNode {
  FSWatchEvent event;
  struct EventQueueNode *next;
} EventQueueNode;

typedef struct LockFreeEventQueue {
  atomic_ptr_t head;
  atomic_ptr_t tail;
  size_t capacity;
  atomic_size_t size;
  EventQueueNode *nodes;
} LockFreeEventQueue;

// File change event types defined
//   - FILE_CREATED, FILE_MODIFIED, FILE_DELETED, FILE_RENAMED
//   - Include path, old_path (for renames), and event flags

// FSEventStreamContext with user data
//   - Store callback function pointer
//   - Store user-provided context
//   - Store filter patterns (extensions to watch)

static void fsevents_callback(ConstFSEventStreamRef streamRef,
                           void *clientCallBackInfo,
                           size_t numEvents,
                           void *eventPaths,
                           const FSEventStreamEventFlags eventFlags[],
                           const FSEventStreamEventId eventIds[]) {
    FSWatcher *watcher = (FSWatcher*)clientCallBackInfo;
    if (!watcher || !watcher->config.callback) return;
    
    char **paths = (char**)eventPaths;
    
    for (size_t i = 0; i < numEvents; i++) {
        FSWatchEvent event = {0};
        event.event_id = eventIds[i];
        event.timestamp_ns = (uint64_t)([[NSDate date] timeIntervalSince1970] * 1e9);
        strncpy(event.path, paths[i], sizeof(event.path) - 1);
        
        // Parse eventFlags to determine change type
        if (eventFlags[i] & kFSEventStreamEventFlagItemCreated) {
            event.type = FS_WATCH_EVENT_CREATED;
        } else if (eventFlags[i] & kFSEventStreamEventFlagItemRemoved) {
            event.type = FS_WATCH_EVENT_DELETED;
        } else if (eventFlags[i] & kFSEventStreamEventFlagItemRenamed) {
            event.type = FS_WATCH_EVENT_RENAMED;
        } else {
            event.type = FS_WATCH_EVENT_MODIFIED;
        }
        
        // Filter events by configured extensions
        if (watcher->config.extension_count > 0) {
            const char *ext = strrchr(paths[i], '.');
            if (ext) {
                bool matches = false;
                for (size_t j = 0; j < watcher->config.extension_count; j++) {
                    if (strcasecmp(ext, watcher->config.extensions[j]) == 0) {
                        matches = true;
                        break;
                    }
                }
                if (!matches) continue;
            }
        }
        
        // Batch events that occur within debounce window
        watcher->total_events++;
        
        // Lock-free queue operations
        static bool event_queue_init(LockFreeEventQueue *queue, size_t capacity) {
          queue->nodes = calloc(capacity, sizeof(EventQueueNode));
          if (!queue->nodes) return false;
          
          atomic_store(&queue->head, &queue->nodes[0]);
          atomic_store(&queue->tail, &queue->nodes[0]);
          atomic_store(&queue->size, 0);
          queue->capacity = capacity;
          return true;
        }

        static bool event_queue_push(LockFreeEventQueue *queue, const FSWatchEvent *event) {
          size_t current_size = atomic_load(&queue->size);
          if (current_size >= queue->capacity) return false;
          
          EventQueueNode *node = &queue->nodes[current_size];
          node->event = *event;
          node->next = NULL;
          
          EventQueueNode *prev_tail = atomic_exchange(&queue->tail, node);
          if (prev_tail) {
            atomic_store(&prev_tail->next, node);
          }
          
          atomic_fetch_add(&queue->size, 1);
          return true;
        }

        static bool event_queue_pop(LockFreeEventQueue *queue, FSWatchEvent *event) {
          EventQueueNode *head = atomic_load(&queue->head);
          if (!head) return false;
          
          EventQueueNode *next = atomic_load(&head->next);
          if (!next) return false;
          
          *event = next->event;
          atomic_store(&queue->head, next);
          atomic_fetch_sub(&queue->size, 1);
          return true;
        }

        static void event_queue_destroy(LockFreeEventQueue *queue) {
          if (queue->nodes) {
            free(queue->nodes);
            queue->nodes = NULL;
          }
          atomic_store(&queue->head, NULL);
          atomic_store(&queue->tail, NULL);
          atomic_store(&queue->size, 0);
        }

        // Path utilities
        static bool should_exclude_path(const char *path, const char **exclude_dirs, size_t exclude_count) {
          for (size_t i = 0; i < exclude_count; i++) {
            if (strstr(path, exclude_dirs[i]) != NULL) {
              return true;
            }
          }
          return false;
        }

        static bool has_allowed_extension(const char *path, const char **extensions, size_t ext_count) {
          if (ext_count == 0) return true; // No extension filter
          
          const char *last_dot = strrchr(path, '.');
          if (!last_dot) return false;
          
          for (size_t i = 0; i < ext_count; i++) {
            if (strcasecmp(last_dot, extensions[i]) == 0) {
              return true;
            }
          }
          return false;
        }

        static FSWatchEventType get_event_type(FSEventStreamEventFlags flags) {
          if (flags & kFSEventStreamEventFlagItemCreated) {
            return FS_WATCH_EVENT_CREATED;
          } else if (flags & kFSEventStreamEventFlagItemRemoved) {
            return FS_WATCH_EVENT_DELETED;
          } else if (flags & kFSEventStreamEventFlagItemRenamed) {
            return FS_WATCH_EVENT_RENAMED;
          } else {
            return FS_WATCH_EVENT_MODIFIED;
          }
        }

        // FSEventStream callback
        static void fsevents_callback(ConstFSEventStreamRef streamRef,
                                       void *clientCallBackInfo,
                                       size_t numEvents,
                                       const char *eventPaths[],
                                       const FSEventStreamEventFlags eventFlags[],
                                       const uint64_t eventIds[]) {
          FSWatcher *watcher = (FSWatcher *)clientCallBackInfo;
          if (!watcher || !watcher->running) return;
          
          for (size_t i = 0; i < numEvents; i++) {
            // Skip if path should be excluded
            if (should_exclude_path(eventPaths[i], watcher->config.exclude_dirs, watcher->config.exclude_dir_count)) {
              watcher->filtered_events++;
              continue;
            }
            
            // Check extension filter
            if (!has_allowed_extension(eventPaths[i], watcher->config.extensions, watcher->config.extension_count)) {
              watcher->filtered_events++;
              continue;
            }
            
            FSWatchEvent event = {0};
            event.type = get_event_type(eventFlags[i]);
            strlcpy(event.path, eventPaths[i], sizeof(event.path));
            event.event_id = eventIds[i];
            event.timestamp_ns = (uint64_t)([[NSDate date] timeIntervalSince1970] * 1e9);
            
            // Add to lock-free queue
            if (!event_queue_push(&watcher->event_queue, &event)) {
              // Queue full, handle overflow
              watcher->filtered_events++;
            } else {
              watcher->total_events++;
            }
          }
          
          // Reset debounce timer
          if (watcher->debounce_timer) {
            dispatch_source_set_timer(watcher->debounce_timer, 
                                     dispatch_time(DISPATCH_TIME_NOW, (int64_t)(watcher->config.debounce_seconds * NSEC_PER_SEC)),
                                     DISPATCH_TIME_FOREVER, 0);
          }
        }

        // Debounce timer callback
        static void debounce_timer_callback(void *context) {
          FSWatcher *watcher = (FSWatcher *)context;
          if (!watcher || !watcher->config.callback) return;
          
          // Move events from lock-free queue to pending list
          pthread_mutex_lock(&watcher->pending_mutex);
          
          FSWatchEvent event;
          while (event_queue_pop(&watcher->event_queue, &event)) {
            EventQueueNode *node = malloc(sizeof(EventQueueNode));
            if (node) {
              node->event = event;
              node->next = watcher->pending_events;
              watcher->pending_events = node;
              watcher->pending_count++;
            }
          }
          
          // Fire callbacks for pending events
          EventQueueNode *current = watcher->pending_events;
          while (current) {
            watcher->config.callback(&current->event, watcher->config.user_data);
            watcher->callbacks_fired++;
            
            EventQueueNode *next = current->next;
            free(current);
            current = next;
          }
          
          watcher->pending_events = NULL;
          watcher->pending_count = 0;
          
          pthread_mutex_unlock(&watcher->pending_mutex);
        }

        typedef enum FSWatchEventType {
          FS_WATCH_EVENT_CREATED = 0,
          FS_WATCH_EVENT_MODIFIED = 1,
          FS_WATCH_EVENT_DELETED = 2,
          FS_WATCH_EVENT_RENAMED = 3,
        } FSWatchEventType;

        typedef struct FSWatchEvent {
          FSWatchEventType type;
          char path[1024];
          char old_path[1024]; // For renames
          uint64_t event_id;
          uint64_t timestamp_ns;
        } FSWatchEvent;

        typedef void (*FSWatchCallback)(const FSWatchEvent *event, void *user_data);

        typedef struct FSWatchConfig {
          const char **watch_paths;
          size_t watch_path_count;
          const char **extensions; // Extensions to include (e.g., ".c", ".h")
          size_t extension_count;
          const char **exclude_dirs; // Directories to exclude
          size_t exclude_dir_count;
          double debounce_seconds; // Default 0.2
          bool follow_symlinks;
          FSWatchCallback callback;
          void *user_data;
        } FSWatchConfig;
  FS_WATCH_EVENT_RENAMED = 3,
} FSWatchEventType;

typedef struct FSWatchEvent {
  FSWatchEventType type;
  char path[1024];
  char old_path[1024]; // For renames
  uint64_t event_id;
  uint64_t timestamp_ns;
} FSWatchEvent;

typedef void (*FSWatchCallback)(const FSWatchEvent *event, void *user_data);

typedef struct FSWatchConfig {
  const char **watch_paths;
  size_t watch_path_count;
  const char **extensions; // Extensions to include (e.g., ".c", ".h")
  size_t extension_count;
  const char **exclude_dirs; // Directories to exclude
  size_t exclude_dir_count;
  double debounce_seconds; // Default 0.2
  bool follow_symlinks;
  FSWatchCallback callback;
  void *user_data;
} FSWatchConfig;

typedef struct FSWatcher {
  FSEventStreamRef stream;
  dispatch_source_t debounce_timer;
  dispatch_queue_t callback_queue;
  FSWatchConfig config;

  // Event batching
  LockFreeEventQueue event_queue;
  EventQueueNode *pending_events;
  size_t pending_count;
  pthread_mutex_t pending_mutex;

  // Statistics
  uint64_t total_events;
  uint64_t filtered_events;
  uint64_t callbacks_fired;

  bool running;
} FSWatcher;

// Multi-instance pattern with global registry
typedef struct FSWatcherRegistry {
  FSWatcher **watchers;
  size_t count;
  size_t capacity;
  pthread_mutex_t mutex;
} FSWatcherRegistry;

static FSWatcherRegistry g_watcher_registry = {0};

