// Ownership/permission change detection
typedef struct {
    uid_t uid;
    gid_t gid;
    mode_t mode;
    uint64_t last_checked;
} FSWatchFilePermissions;

// Finder info change detection
typedef struct {
    uint32_t finder_flags;
    uint32_t finder_type;
    uint32_t finder_creator;
    uint64_t last_checked;
} FSWatchFinderInfo;

// File size change threshold filter
typedef struct {
    off_t last_size;
    off_t size_threshold;
    uint64_t last_checked;
} FSWatchFileSize;

// Modification time validation
typedef struct {
    struct timespec last_modified;
    struct timespec last_checked;
    bool is_valid;
} FSWatchModTime;

// Path normalization utilities
typedef struct {
    char normalized_path[PATH_MAX];
    char original_path[PATH_MAX];
    bool is_resolved;
} FSWatchPathInfo;

// Pattern matching for filters
typedef struct {
    char pattern[256];
    bool is_regex;
    bool is_glob;
    bool is_case_sensitive;
} FSWatchPattern;

// Callback rate limiting
typedef struct {
    uint32_t callback_count;
    uint64_t last_callback_time;
    uint32_t max_callbacks_per_second;
} FSWatchRateLimit;

// Callback priority queue
typedef struct {
    FSWatchEvent event;
    int priority;
    uint64_t timestamp;
} FSWatchPriorityEvent;

// Async callback execution mode
typedef enum {
    FS_ASYNC_MODE_SYNC,
    FS_ASYNC_MODE_ASYNC,
    FS_ASYNC_MODE_DEFERRED
} FSWatchAsyncMode;

// Additional TODOs for complete FSEvents implementation:

// TODO(AGENT_MACOS_2): Implement kFSEventStreamEventFlagMustScanSubDirs
// handling [Difficulty: 5]
// TODO(AGENT_MACOS_2): Create recursive directory scan fallback [Difficulty: 6]
// Extension filter system implemented
//   - Support multiple extensions (e.g., ".c", ".h", ".metal")
//   - Support exclusion patterns (e.g., "!.DS_Store")
//   - Case-insensitive matching on macOS

// Directory exclusion list implemented
//   - Skip .git, .build, node_modules, etc.
//   - Configurable via engine settings

static bool should_exclude_path(const char *path, FSWatcher *watcher) {
    if (!path || !watcher) return false;
    
    const char *basename = strrchr(path, '/');
    basename = basename ? basename + 1 : path;
    
    // Default excluded directories
    const char *default_excludes[] = {
        ".git", ".build", "node_modules", ".vscode", ".xcodeproj",
        "DerivedData", "build", "dist", "target", "CMakeFiles"
    };
    
    // Check default excludes
    for (size_t i = 0; i < sizeof(default_excludes) / sizeof(default_excludes[0]); i++) {
        if (strstr(path, default_excludes[i]) != NULL) {
            return true;
        }
    }
    
    // Check user-configured excludes
    for (size_t i = 0; i < watcher->config.exclude_count; i++) {
        if (strstr(path, watcher->config.exclude_dirs[i]) != NULL) {
            return true;
        }
    }
    
    return false;
}

// FSEventStream lifecycle management
//   - Create stream with proper flags and latency
//   - Start/stop streaming with proper error handling
//   - Schedule on run loop for async operation

static bool create_fsevent_stream(FSWatcher *watcher) {
    if (!watcher || watcher->config.watch_count == 0) return false;
    
    CFMutableArrayRef paths = CFArrayCreateMutable(NULL, watcher->config.watch_count, &kCFTypeArrayCallBacks);
    if (!paths) return false;
    
    for (size_t i = 0; i < watcher->config.watch_count; i++) {
        CFStringRef path = CFStringCreateWithCString(NULL, watcher->config.watch_paths[i], kCFStringEncodingUTF8);
        if (path) {
            CFArrayAppendValue(paths, path);
            CFRelease(path);
        }
    }
    
    FSEventStreamContext context = {0};
    context.info = watcher;
    
    FSEventStreamCreateFlags flags = kFSEventStreamCreateFlagFileEvents |
                                     kFSEventStreamCreateFlagWatchRoot |
                                     kFSEventStreamCreateFlagNoDefer;
    
    CFAbsoluteTime latency = watcher->config.latency_seconds;
    
    watcher->stream = FSEventStreamCreate(NULL, &fsevents_callback, &context, paths,
                                         kFSEventStreamEventIdSinceNow, latency, flags);
    
    CFRelease(paths);
    
    if (!watcher->stream) {
        return false;
    }
    
    // Schedule on run loop
    FSEventStreamScheduleWithRunLoop(watcher->stream, CFRunLoopGetCurrent(), kCFRunLoopDefaultMode);
    
    return true;
}

static void destroy_fsevent_stream(FSWatcher *watcher) {
    if (!watcher) return;
    
    if (watcher->stream) {
        if (FSEventStreamIsRunning(watcher->stream)) {
            FSEventStreamStop(watcher->stream);
        }
        FSEventStreamUnscheduleFromRunLoop(watcher->stream, CFRunLoopGetCurrent(), kCFRunLoopDefaultMode);
        FSEventStreamInvalidate(watcher->stream);
        FSEventStreamRelease(watcher->stream);
        watcher->stream = NULL;
    }
}

