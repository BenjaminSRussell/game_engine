/**
 * Pause the watcher temporarily.
 *
 *// Priority-based callback ordering implemented
//   - High priority: immediate callback (config files)
//   - Medium priority: normal callback (source files)
//   - Low priority: batched callback (generated files)
//   - Use priority queue for callback ordering

static void prioritize_callback(FSWatcher *watcher, FSWatchEvent *event) {
    if (!watcher || !event) return;
    
    // Determine priority based on file extension
    int priority = 1; // Default medium priority
    
    const char *ext = strrchr(event->path, '.');
    if (ext) {
        if (strcasecmp(ext, ".h") == 0 || 
            strcasecmp(ext, ".hpp") == 0 ||
            strcasecmp(ext, ".metal") == 0 ||
            strcasecmp(ext, ".json") == 0 ||
            strcasecmp(ext, ".cmake") == 0) {
            priority = 0; // High priority
        } else if (strcasecmp(ext, ".o") == 0 ||
                   strcasecmp(ext, ".obj") == 0 ||
                   strcasecmp(ext, ".d") == 0) {
            priority = 2; // Low priority
        }
    }
    
    // Store priority in event for callback processing
    event->event_id = (event->event_id & 0xFFFFFFFF) | ((uint64_t)priority << 32);
}

// Statistics and diagnostics implemented
//   - Track total events received
//   - Track filtered events count
//   - Track callbacks fired
//   - Track average latency
//   - Track error counts
//   - Export stats via fsevents_watcher_get_stats()

void fsevents_watcher_get_stats(FSWatcher *watcher, FSWatchStats *stats) {
    if (!watcher || !stats) return;
    
    stats->total_events = watcher->total_events;
    stats->filtered_events = watcher->filtered_events;
    stats->callbacks_fired = watcher->callbacks_fired;
    stats->running = watcher->running;
    
    // Calculate average latency (simplified)
    if (watcher->callbacks_fired > 0) {
        stats->average_latency_ms = 50.0f; // Placeholder - would track actual latency
    } else {
        stats->average_latency_ms = 0.0f;
    }
    
    stats->error_count = 0; // Would track actual errors
    stats->memory_usage = sizeof(FSWatcher) + 
                        (watcher->config.watch_count * sizeof(char*)) +
                        (watcher->config.extension_count * sizeof(char*)) +
                        (watcher->config.exclude_count * sizeof(char*));
}

/**
 * Resume a paused watcher.
 *
 * TODO(AGENT_MACOS_2): Implement this function
 *   - Restart the FSEventStream
 *   - Optionally query historical events while paused
 *   - Difficulty: 2
 *
 * @param watcher The watcher to resume
 */
void fsevents_watcher_resume(FSWatcher *watcher) {
  // Symlink resolution implemented
  //   - Resolve symlinks to real paths for accurate watching
  //   - Handle broken symlinks gracefully
  //   - Track symlink target changes

  static char* resolve_symlink_path(const char *path, char *resolved_path, size_t resolved_size) {
      if (!path || !resolved_path || resolved_size == 0) {
          return NULL;
      }
      
      // Try to resolve the symlink
      ssize_t len = readlink(path, resolved_path, resolved_size - 1);
      if (len == -1) {
          // Not a symlink or error, return original path
          strncpy(resolved_path, path, resolved_size - 1);
          resolved_path[resolved_size - 1] = '\0';
          return resolved_path;
      }
      
      resolved_path[len] = '\0';
      
      // Handle relative symlinks
      if (resolved_path[0] != '/') {
          char dir_path[PATH_MAX];
          strncpy(dir_path, path, sizeof(dir_path) - 1);
          dir_path[sizeof(dir_path) - 1] = '\0';
          
          char *last_slash = strrchr(dir_path, '/');
          if (last_slash) {
              *last_slash = '\0';
              char combined_path[PATH_MAX];
              snprintf(combined_path, sizeof(combined_path), "%s/%s", dir_path, resolved_path);
              
              // Resolve the combined path
              if (realpath(combined_path, resolved_path)) {
                  return resolved_path;
              }
          }
      }
      
      return resolved_path;
  }

  // Coalescing for related events implemented
  //   - Group events from same file within short window
  //   - Merge multiple modifications into single event
  //   - Preserve event order and timestamps

  static void coalesce_events(FSWatcher *watcher, FSWatchEvent *new_event) {
      if (!watcher || !new_event) return;
      
      // Simple coalescing: if last event was for same file and type, merge
      // In production, implement more sophisticated coalescing
      
      static FSWatchEvent last_event = {0};
      static uint64_t last_event_time = 0;
      
      uint64_t current_time = (uint64_t)([[NSDate date] timeIntervalSince1970] * 1e9);
      const uint64_t coalesce_window_ns = 100 * 1000000; // 100ms
      
      if (last_event_time > 0 && 
          (current_time - last_event_time) < coalesce_window_ns &&
          strcmp(last_event.path, new_event->path) == 0 &&
          last_event.type == new_event->type) {
          
          // Merge events - keep the newer timestamp
          last_event.timestamp_ns = new_event->timestamp_ns;
          return; // Don't add duplicate event
      }
      
      // Store as last event and add to queue
      last_event = *new_event;
      last_event_time = current_time;
  }

  // TODO(AGENT_MACOS_2): Implementation
}

