#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inputImage;
layout (binding = 1, rgba16f) uniform writeonly image2D outputImage;
layout (binding = 2) uniform sampler2D historyTexture;
layout (binding = 3) uniform sampler2D velocityTexture;
layout (binding = 4) uniform sampler2D depthTexture;

layout (push_constant) uniform PushConstants {
    float jitterX;
    float jitterY;
    float feedback;
    uint method;
} push;

vec3 clip_aabb(vec3 aabb_min, vec3 aabb_max, vec3 p, vec3 q) {
    vec3 r = q - p;
    vec3 rmax = aabb_max - p;
    vec3 rmin = aabb_min - p;

    if (r.x > rmax.x + 1e-6) r *= (rmax.x / r.x);
    if (r.y > rmax.y + 1e-6) r *= (rmax.y / r.y);
    if (r.z > rmax.z + 1e-6) r *= (rmax.z / r.z);

    if (r.x < rmin.x - 1e-6) r *= (rmin.x / r.x);
    if (r.y < rmin.y - 1e-6) r *= (rmin.y / r.y);
    if (r.z < rmin.z - 1e-6) r *= (rmin.z / r.z);

    return p + r;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    
    if (pos.x >= size.x || pos.y >= size.y) return;
    
    vec2 uv = (vec2(pos) + 0.5) / vec2(size);
    
    // Sample current color
    vec3 color = imageLoad(inputImage, pos).rgb;
    
    // Neighborhood clamping
    vec3 minColor = color;
    vec3 maxColor = color;
    
    for(int x = -1; x <= 1; ++x) {
        for(int y = -1; y <= 1; ++y) {
            vec3 neighbor = imageLoad(inputImage, pos + ivec2(x, y)).rgb;
            minColor = min(minColor, neighbor);
            maxColor = max(maxColor, neighbor);
        }
    }
    
    // Sample velocity (closest depth dilation)
    // TODO: proper 3x3 search for closest depth to get velocity of foreground object
    vec2 velocity = texture(velocityTexture, uv).xy;
    
    // Reprojection
    vec2 historyUV = uv - velocity;
    
    // Check if off-screen
    bool offScreen = historyUV.x < 0.0 || historyUV.x > 1.0 || 
                     historyUV.y < 0.0 || historyUV.y > 1.0;
                     
    if (offScreen) {
        imageStore(outputImage, pos, vec4(color, 1.0));
        return;
    }
    
    // Sample history
    vec3 historyColor = texture(historyTexture, historyUV).rgb;
    
    // Clip history to neighborhood
    historyColor = clip_aabb(minColor, maxColor, clamp(minColor, maxColor, historyColor), historyColor);
    
    // Feedback blending
    float blend = push.feedback;
    
    // Reduce blend factor based on velocity to reduce ghosting
    float velocityLen = length(velocity * vec2(size));
    blend = mix(blend, 0.0, clamp(velocityLen * 0.1, 0.0, 1.0));
    
    vec3 finalColor = mix(color, historyColor, blend);
    
    imageStore(outputImage, pos, vec4(finalColor, 1.0));
}
