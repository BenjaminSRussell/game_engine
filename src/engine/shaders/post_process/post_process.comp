#version 450 core

// Post-Processing Compute Shader
// GPU-accelerated post-processing for better performance

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) uniform readonly image2D uInputImage;
layout(binding = 1, rgba16f) uniform writeonly image2D uOutputImage;
layout(binding = 2) uniform sampler2D uBloomTexture;
layout(binding = 3) uniform sampler2D uAOTexture;

uniform int uEffects;
uniform float uExposure;
uniform float uBloomIntensity;
uniform float uAOStrength;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(coord) / imageSize(uInputImage);
    
    vec3 color = imageLoad(uInputImage, coord).rgb;
    
    // Tone mapping
    if ((uEffects & 1) != 0) {
        color = color * uExposure;
        color = color / (1.0 + color);
    }
    
    // Bloom
    if ((uEffects & 2) != 0) {
        vec3 bloom = texture(uBloomTexture, uv).rgb;
        color += bloom * uBloomIntensity;
    }
    
    // AO
    if ((uEffects & 4) != 0) {
        float ao = texture(uAOTexture, uv).r;
        color *= mix(1.0, ao, uAOStrength);
    }
    
    imageStore(uOutputImage, coord, vec4(color, 1.0));
}
