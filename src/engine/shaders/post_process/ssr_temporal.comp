#version 450 core

// SSR Temporal Reprojection Compute Shader
// Reduces noise and improves temporal coherence

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uCurrentSSRTexture;
layout(binding = 1) uniform sampler2D uPreviousSSRTexture;
layout(binding = 2) uniform sampler2D uVelocityTexture;
layout(binding = 3, rgba16f) uniform image2D uOutputImage;

layout(std140, binding = 4) uniform SSRTemporalUniforms {
    float uTemporalWeight;
    float uSpatialWeight;
    uint uFrameIndex;
    uint uEnableVarianceClamping;
    vec2 uTexelSize;
    float uVelocityScale;
    float uPadding;
};

layout(std140, binding = 5) uniform CameraUniforms {
    mat4 uInverseViewProjection;
    mat4 uPreviousViewProjection;
};

// Neighborhood clamping for variance reduction
vec3 neighborhoodClamping(vec3 current, vec3 history, vec2 uv) {
    vec3 minColor = current;
    vec3 maxColor = current;
    
    // Sample 3x3 neighborhood
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            if (x == 0 && y == 0) continue;
            
            vec2 sampleUV = uv + vec2(x, y) * uTexelSize;
            vec3 sampleColor = texture(uCurrentSSRTexture, sampleUV).rgb;
            
            minColor = min(minColor, sampleColor);
            maxColor = max(maxColor, sampleColor);
        }
    }
    
    return clamp(history, minColor, maxColor);
}

// Variance-based filtering
vec3 varianceFiltering(vec3 current, vec3 history, vec2 uv) {
    vec3 mean = vec3(0.0);
    vec3 variance = vec3(0.0);
    int samples = 0;
    
    // Calculate local statistics
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            vec2 sampleUV = uv + vec2(x, y) * uTexelSize;
            vec3 sampleColor = texture(uCurrentSSRTexture, sampleUV).rgb;
            
            mean += sampleColor;
            variance += sampleColor * sampleColor;
            samples++;
        }
    }
    
    mean /= float(samples);
    variance /= float(samples);
    variance -= mean * mean;
    
    // Calculate confidence based on variance
    vec3 stdDev = sqrt(max(variance, vec3(0.001)));
    vec3 confidence = 1.0 / (stdDev + 0.01);
    confidence = clamp(confidence, 0.0, 1.0);
    
    // Blend based on confidence
    return mix(history, current, confidence);
}

// Reproject previous frame pixel
vec2 reprojectPixel(vec2 currentUV, vec3 worldPos) {
    vec4 previousClip = uPreviousViewProjection * vec4(worldPos, 1.0);
    previousClip /= previousClip.w;
    return previousClip.xy * 0.5 + 0.5;
}

// Reconstruct world position from depth (simplified)
vec3 reconstructWorldPosition(vec2 uv) {
    // Use a simplified reconstruction - in practice you'd need actual depth
    vec4 clipPos = vec4(uv * 2.0 - 1.0, 0.5, 1.0); // Assume mid depth
    vec4 worldPos = uInverseViewProjection * clipPos;
    return worldPos.xyz / worldPos.w;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(coord) + 0.5) * uTexelSize;
    
    // Get current frame SSR
    vec3 currentSSR = texture(uCurrentSSRTexture, uv).rgb;
    
    // Skip if no reflection in current frame
    if (length(currentSSR) < 0.01) {
        imageStore(uOutputImage, coord, vec4(currentSSR, 1.0));
        return;
    }
    
    // Get velocity for motion blur
    vec2 velocity = texture(uVelocityTexture, uv).rg * uVelocityScale;
    
    // Reproject to previous frame
    vec3 worldPos = reconstructWorldPosition(uv);
    vec2 previousUV = reprojectPixel(uv, worldPos);
    
    vec3 finalColor = currentSSR;
    
    // Check if reprojection is valid
    if (previousUV.x >= 0.0 && previousUV.x <= 1.0 &&
        previousUV.y >= 0.0 && previousUV.y <= 1.0) {
        
        // Sample previous frame
        vec3 previousSSR = texture(uPreviousSSRTexture, previousUV).rgb;
        
        // Apply temporal filtering
        if (uEnableVarianceClamping == 1) {
            previousSSR = varianceFiltering(currentSSR, previousSSR, uv);
        } else {
            previousSSR = neighborhoodClamping(currentSSR, previousSSR, uv);
        }
        
        // Blend with current frame
        float blendFactor = uTemporalWeight;
        
        // Adaptive blend based on velocity magnitude
        float velocityMagnitude = length(velocity);
        float adaptiveBlend = mix(blendFactor, 0.1, velocityMagnitude);
        
        finalColor = mix(previousSSR, currentSSR, adaptiveBlend);
    }
    
    // Apply spatial filtering for additional noise reduction
    if (uSpatialWeight > 0.0) {
        vec3 spatialMean = vec3(0.0);
        int spatialSamples = 0;
        
        for (int x = -1; x <= 1; x++) {
            for (int y = -1; y <= 1; y++) {
                if (x == 0 && y == 0) continue;
                
                vec2 sampleUV = uv + vec2(x, y) * uTexelSize;
                vec3 sampleColor = texture(uCurrentSSRTexture, sampleUV).rgb;
                
                // Weight by similarity to center pixel
                float weight = 1.0 / (1.0 + distance(currentSSR, sampleColor));
                spatialMean += sampleColor * weight;
                spatialSamples++;
            }
        }
        
        if (spatialSamples > 0) {
            spatialMean /= float(spatialSamples);
            finalColor = mix(finalColor, spatialMean, uSpatialWeight);
        }
    }
    
    // Output result
    imageStore(uOutputImage, coord, vec4(finalColor, 1.0));
}
