#version 450 core

// Screen Space Ambient Occlusion Compute Shader
// High-performance SSAO with hierarchical sampling and temporal filtering

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uDepthTexture;
layout(binding = 1) uniform sampler2D uNormalTexture;
layout(binding = 2) uniform sampler2D uNoiseTexture;
layout(binding = 3) uniform sampler2D uPreviousAOTexture;
layout(binding = 4, r8) uniform image2D uOutputImage;

layout(std140, binding = 5) uniform SSAOUniforms {
    float uRadius;
    float uIntensity;
    float uBias;
    uint uSampleCount;
    vec2 uScreenSize;
    vec2 uTexelSize;
    mat4 uProjection;
    mat4 uInverseProjection;
    bool uTemporalFiltering;
    float uTemporalWeight;
    uint uFrameIndex;
    uint uPadding;
};

// Generate sample kernel in compute shader
vec3 generateSample(int index) {
    float scale = float(index) / float(uSampleCount);
    scale = mix(0.1, 1.0, scale * scale);
    
    vec3 sample;
    sample.x = fract(sin(float(index) * 12.9898) * 43758.5453) * 2.0 - 1.0;
    sample.y = fract(sin(float(index) * 78.233) * 43758.5453) * 2.0 - 1.0;
    sample.z = fract(sin(float(index) * 37.719) * 43758.5453);
    
    sample = normalize(sample);
    sample *= scale;
    
    return sample;
}

// Rotate sample kernel
vec3 rotateSample(vec3 sample, vec3 normal, vec2 random) {
    // Create tangent space
    vec3 tangent = normalize(random.x * normal - normal.yzx * normal.z);
    vec3 bitangent = cross(normal, tangent);
    
    // Transform to world space
    return tangent * sample.x + bitangent * sample.y + normal * sample.z;
}

// Reconstruct view space position from depth
vec3 reconstructViewPosition(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 viewPos = uInverseProjection * clipPos;
    return viewPos.xyz / viewPos.w;
}

// Hierarchical Z-Buffer sampling for performance
float sampleDepthHierarchy(vec2 uv, float level) {
    // Sample from appropriate mip level based on distance
    vec2 mipSize = uScreenSize / exp2(level);
    vec2 mipTexel = 1.0 / mipSize;
    
    // Sample with mip level bias
    return textureLod(uDepthTexture, uv, level).r;
}

// Calculate occlusion for a single sample
float calculateOcclusion(vec3 viewPos, vec3 normal, vec3 samplePos, vec2 uv) {
    // Transform sample to view space
    samplePos = samplePos * uRadius + viewPos;
    
    // Project to screen space
    vec4 offsetClip = uProjection * vec4(samplePos, 1.0);
    offsetClip.xy /= offsetClip.w;
    vec2 offsetUV = offsetClip.xy * 0.5 + 0.5;
    
    // Check if sample is valid
    if (offsetUV.x < 0.0 || offsetUV.x > 1.0 || offsetUV.y < 0.0 || offsetUV.y > 1.0) {
        return 0.0;
    }
    
    // Sample depth at offset position
    float sampleDepth = texture(uDepthTexture, offsetUV).r;
    vec3 sampleViewPos = reconstructViewPosition(offsetUV, sampleDepth);
    
    // Calculate occlusion
    float rangeCheck = smoothstep(0.0, 1.0, uRadius / abs(viewPos.z - sampleViewPos.z));
    float occlusion = (sampleViewPos.z >= samplePos.z + uBias) ? 1.0 : 0.0;
    
    return occlusion * rangeCheck;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(coord) + 0.5) * uTexelSize;
    
    // Get depth and normal
    float depth = texture(uDepthTexture, uv).r;
    vec3 normal = texture(uNormalTexture, uv).rgb * 2.0 - 1.0;
    
    // Skip sky/background
    if (depth >= 1.0) {
        imageStore(uOutputImage, coord, vec4(1.0));
        return;
    }
    
    // Reconstruct view space position
    vec3 viewPos = reconstructViewPosition(uv, depth);
    
    // Get noise texture sample for rotation
    vec2 noiseUV = uv * uScreenSize / 4.0; // Tiling noise texture
    vec3 noise = texture(uNoiseTexture, noiseUV).rgb;
    vec2 random = noise.xy * 2.0 - 1.0;
    
    // Calculate ambient occlusion
    float occlusion = 0.0;
    
    for (int i = 0; i < uSampleCount; i++) {
        vec3 sample = generateSample(i);
        sample = rotateSample(sample, normal, random);
        
        occlusion += calculateOcclusion(viewPos, normal, sample, uv);
    }
    
    occlusion /= float(uSampleCount);
    occlusion = pow(1.0 - occlusion, uIntensity);
    
    // Apply temporal filtering
    if (uTemporalFiltering && uFrameIndex > 0) {
        float previousAO = texture(uPreviousAOTexture, uv).r;
        occlusion = mix(previousAO, occlusion, uTemporalWeight);
    }
    
    // Output result
    imageStore(uOutputImage, coord, vec4(occlusion));
}
