#version 450 core

// Temporal Anti-Aliasing Compute Shader
// High-performance TAA with temporal reprojection and variance filtering

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D uCurrentColorTexture;
layout(binding = 1) uniform sampler2D uVelocityTexture;
layout(binding = 2) uniform sampler2D uHistoryTexture;
layout(binding = 3, rgba16f) uniform image2D uOutputImage;

layout(std140, binding = 4) uniform TAAUniforms {
    float uBlendFactor;
    float uSharpness;
    uint uEnableSharpening;
    uint uFrameIndex;
    float uJitterX;
    float uJitterY;
    uint uEnableJitter;
    float uPadding;
};

layout(std140, binding = 5) uniform CameraUniforms {
    mat4 uInverseViewProjection;
    mat4 uPreviousViewProjection;
    vec2 uTexelSize;
};

// Reproject previous frame pixel
vec2 reprojectPixel(vec2 currentUV, vec3 worldPos) {
    vec4 previousClip = uPreviousViewProjection * vec4(worldPos, 1.0);
    previousClip /= previousClip.w;
    return previousClip.xy * 0.5 + 0.5;
}

// Reconstruct world position from depth
vec3 reconstructWorldPosition(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 viewPos = uInverseViewProjection * clipPos;
    return viewPos.xyz / viewPos.w;
}

// Neighborhood clamping to prevent ghosting
vec3 neighborhoodClamping(vec3 current, vec3 history, vec2 uv) {
    // Sample 3x3 neighborhood
    vec3 minColor = current;
    vec3 maxColor = current;
    
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            if (x == 0 && y == 0) continue;
            
            vec2 sampleUV = uv + vec2(x, y) * uTexelSize;
            vec3 sampleColor = texture(uCurrentColorTexture, sampleUV).rgb;
            
            minColor = min(minColor, sampleColor);
            maxColor = max(maxColor, sampleColor);
        }
    }
    
    return clamp(history, minColor, maxColor);
}

// Variance-based temporal filtering
vec3 varianceFiltering(vec3 current, vec3 history, vec2 uv) {
    // Calculate local variance
    vec3 mean = vec3(0.0);
    vec3 variance = vec3(0.0);
    int samples = 0;
    
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            vec2 sampleUV = uv + vec2(x, y) * uTexelSize;
            vec3 sampleColor = texture(uCurrentColorTexture, sampleUV).rgb;
            
            mean += sampleColor;
            variance += sampleColor * sampleColor;
            samples++;
        }
    }
    
    mean /= float(samples);
    variance /= float(samples);
    variance -= mean * mean;
    
    // Calculate confidence based on variance
    vec3 stdDev = sqrt(max(variance, vec3(0.0)));
    vec3 confidence = 1.0 / (stdDev + 0.001);
    confidence = clamp(confidence, 0.0, 1.0);
    
    // Blend based on confidence
    return mix(history, current, confidence);
}

// Detect disocclusion
bool isDisoccluded(vec2 currentUV, vec2 previousUV, float currentDepth, float previousDepth) {
    // Check if depth difference is too large
    float depthDiff = abs(currentDepth - previousDepth);
    if (depthDiff > 0.1) return true;
    
    // Check if reprojection is out of bounds
    if (previousUV.x < 0.0 || previousUV.x > 1.0 ||
        previousUV.y < 0.0 || previousUV.y > 1.0) {
        return true;
    }
    
    return false;
}

// Apply sharpening filter
vec3 applySharpening(vec3 color, vec2 uv) {
    if (uEnableSharpening == 0) return color;
    
    // Simple 3x3 sharpening kernel
    vec3 sharpened = color * (1.0 + 4.0 * uSharpness);
    
    sharpened -= texture(uCurrentColorTexture, uv + vec2(-1, 0) * uTexelSize).rgb * uSharpness;
    sharpened -= texture(uCurrentColorTexture, uv + vec2(1, 0) * uTexelSize).rgb * uSharpness;
    sharpened -= texture(uCurrentColorTexture, uv + vec2(0, -1) * uTexelSize).rgb * uSharpness;
    sharpened -= texture(uCurrentColorTexture, uv + vec2(0, 1) * uTexelSize).rgb * uSharpness;
    
    return sharpened;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(coord) + 0.5) * uTexelSize;
    
    // Apply jitter if enabled
    if (uEnableJitter == 1) {
        uv += vec2(uJitterX, uJitterY) * uTexelSize;
    }
    
    // Get current frame data
    vec3 currentColor = texture(uCurrentColorTexture, uv).rgb;
    vec2 velocity = texture(uVelocityTexture, uv).rg;
    
    // Reconstruct world position (using center depth for simplicity)
    float centerDepth = texture(uCurrentColorTexture, vec2(0.5, 0.5)).a; // Assuming depth in alpha
    vec3 worldPos = reconstructWorldPosition(uv, centerDepth);
    
    // Reproject to previous frame
    vec2 previousUV = reprojectPixel(uv, worldPos);
    
    vec3 resolvedColor = currentColor;
    
    // Check if reprojection is valid
    if (previousUV.x >= 0.0 && previousUV.x <= 1.0 &&
        previousUV.y >= 0.0 && previousUV.y <= 1.0) {
        
        // Sample previous frame
        vec3 previousColor = texture(uHistoryTexture, previousUV).rgb;
        float previousDepth = texture(uHistoryTexture, previousUV).a;
        
        // Check for disocclusion
        if (!isDisoccluded(uv, previousUV, centerDepth, previousDepth)) {
            // Apply temporal filtering
            vec3 filteredColor = varianceFiltering(currentColor, previousColor, uv);
            filteredColor = neighborhoodClamping(currentColor, filteredColor, uv);
            
            // Blend with current frame
            resolvedColor = mix(filteredColor, currentColor, uBlendFactor);
        }
    }
    
    // Apply sharpening
    resolvedColor = applySharpening(resolvedColor, uv);
    
    // Output result
    imageStore(uOutputImage, coord, vec4(resolvedColor, 1.0));
}
