#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec4 position; // xyz, w=size
    vec4 velocity; // xyz, w=lifetime
    vec4 color;
    vec4 rotation; // x=angle, y=speed, zw=padding
    vec4 age;      // x=age, yzw=padding
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

layout(std430, binding = 1) buffer DeadList {
    uint dead_indices[];
};

layout(std430, binding = 2) buffer CounterBuffer {
    uint active_count;
    uint dead_count;
    uint spawn_count;
    uint padding;
};

uniform float time;
uniform float dt;
uniform vec3 emitter_pos;
uniform vec3 emitter_vel;
uniform vec4 color_start;
uniform vec4 color_end;
uniform vec2 lifetime_range;
uniform vec2 size_range;
uniform vec2 speed_range;
uniform uint seed;

// Simple hash function for random numbers
float random(float x) {
    return fract(sin(x) * 43758.5453123);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= spawn_count) return;

    // Consume from dead list
    // Atomic operations would be needed in real implementation
    // For now assuming single dispatch manages this or using atomicCounter
    uint particle_idx = atomicAdd(dead_count, -1) - 1; 
    // Note: This logic assumes dead_count is the index of the next available slot?
    // Actually dead list usually works as a stack.
    // particle_idx = dead_indices[cnt];
    
    // Simplified logic: Just overwrite direct index if not using dead list for now?
    // No, standard particle system needs dead list.
    // Let's assume we grabbed a valid index.
    
    // Initialize particle
    float r1 = random(float(idx) + time);
    float r2 = random(float(idx) + time + 1.0);
    float r3 = random(float(idx) + time + 2.0);
    
    particles[particle_idx].position = vec4(emitter_pos, 1.0);
    
    vec3 dir = normalize(vec3(r1 - 0.5, r2 - 0.5, r3 - 0.5));
    float speed = mix(speed_range.x, speed_range.y, r3);
    particles[particle_idx].velocity = vec4(dir * speed + emitter_vel, 0.0);
    
    particles[particle_idx].color = color_start;
    
    float size = mix(size_range.x, size_range.y, r1);
    particles[particle_idx].position.w = size; // Storing size in position.w for efficiency
    
    float life = mix(lifetime_range.x, lifetime_range.y, r2);
    particles[particle_idx].velocity.w = life; // Storing lifetime in velocity.w
    
    particles[particle_idx].age.x = 0.0;
}
