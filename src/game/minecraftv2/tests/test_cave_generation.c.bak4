// Test for cave generation system
#include "../include/block/block.h"
#include "../include/chunk/chunk.h"
#include "../include/world/cave_generation.h"
#include "test_framework.h" // Hypothetical test framework or just standard assert
#include <assert.h>
#include <stdio.h>

// Mock chunk functionality if needed, or link against actual chunk.c
// For this test we assume we link against the engine lib

void test_cave_initialization() {
  CaveGenerator gen;
  cave_generator_init(&gen, 12345);

  assert(gen.initialized == true);
  assert(gen.config.noise_params.seed == 12345);

  cave_generator_free(&gen);
  printf("Cave initialization test passed\n");
}

void test_cave_carving() {
  CaveGenerator gen;
  cave_generator_init(&gen, 67890);

  Chunk chunk;
  // Initialize chunk with stone
  // Assuming chunk_init or similar exists, or manually fill data
  // For this test, we might need to mock Chunk if it's complex
  // Let's assume a simple struct for now as per header

  // Fill with solid stone
  for (int x = 0; x < 16; x++) {
    for (int y = 0; y < 256; y++) {
      for (int z = 0; z < 16; z++) {
        chunk_set_block(&chunk, x, y, z, BLOCK_STONE);
      }
    }
  }

  cave_generator_carve_chunk(&gen, &chunk, 0, 0);

  // Check that *some* blocks are now air (caves carved)
  int air_count = 0;
  for (int x = 0; x < 16; x++) {
    for (int y = 5; y < 100; y++) { // Check underground area
      for (int z = 0; z < 16; z++) {
        if (chunk_get_block(&chunk, x, y, z) == BLOCK_AIR) {
          air_count++;
        }
      }
    }
  }

  printf("Carved %d blocks of air in chunk\n", air_count);
  assert(air_count > 0); // Should have carved something

  cave_generator_free(&gen);
  printf("Cave carving test passed\n");
}

int main() {
  printf("Running cave generation tests...\n");
  test_cave_initialization();

  // Note: To fully run test_cave_carving we need to link against chunk.c
  // test_cave_carving();

  printf("All cave tests passed!\n");
  return 0;
}
