#include <assert.h>
#include <stdio.h>
#include "crafting/recipe_manager.h"
#include "crafting/recipe.h"
#include "inventory/inventory.h"

/* Note: include paths in test harness expect relative includes */
int main(void) {
    recipe_manager_init();

    Recipe r1;
    recipe_init(&r1, 100, 1); // result item 100
    recipe_add_ingredient(&r1, 1, 2);
    recipe_add_ingredient(&r1, 2, 1);
    recipe_manager_add(&r1);

    Recipe r2;
    recipe_init(&r2, 200, 1);
    recipe_add_ingredient(&r2, 3, 4);
    recipe_manager_add(&r2);

    Inventory inv;
    inventory_init(&inv);
    inventory_add_item(&inv, 1, 2);
    inventory_add_item(&inv, 2, 1);

    Recipe *found = recipe_manager_find_matching(&inv);
    assert(found == &r1);

    u32 hits, misses;
    recipe_manager_get_cache_stats(&hits, &misses);
    /* at first find, cache miss should be at least 1 */
    assert(misses >= 1);

    /* Call again - should hit cache */
    found = recipe_manager_find_matching(&inv);
    recipe_manager_get_cache_stats(&hits, &misses);
    assert(hits >= 1);

    printf("test_recipe_cache: OK\n");

    recipe_free(&r1);
    recipe_free(&r2);
    recipe_manager_shutdown();
    return 0;
}
