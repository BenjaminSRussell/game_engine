// src/combat/combat_animations.c
//
// Module Overview:
// This module implements the core logic for managing combat-related visual animations,
// primarily focusing on player attack sequences. It maintains the state of various
// ongoing animations (like weapon swings), updates their progress over time, and
// provides information necessary for rendering and gameplay mechanics (e.g., weapon
// offset, damage window timing). The system is designed to handle a fixed number of
// concurrent animations and integrates with weapon types to vary animation characteristics.
// TODO: Implement animation blending system for smooth transitions between animations.
// TODO: Add animation event system for triggering effects at specific frames.
// TODO: Implement animation speed scaling based on attack speed modifiers.
// TODO: Add animation cancellation system for interrupting attacks.
// TODO: Implement animation mirroring for left/right hand attacks.
// TODO: Add animation variation system for randomized attack patterns.
// TODO: Implement animation combo system with chained attack sequences.
// TODO: Add animation root motion for character movement during attacks.
// TODO: Implement animation retargeting for different character sizes.
// TODO: Add animation compression for memory efficiency.
//
// Key Flows:
// 1. **Initialization (`combat_animations_init`):** Sets up the `CombatAnimationSystem`,
//    including an array of `AnimationState`s for tracking individual animations,
//    and initializes global combat parameters like `attack_cooldown`.
// 2. **Starting Attack Animation (`combat_animations_start_attack`):**
//    - Checks if the player is off cooldown.
//    - Finds an inactive `AnimationState` slot and activates it.
//    - Sets the animation type to `ANIMATION_ATTACK` and configures its `duration`
//      and `end_pos` (swing trajectory) based on the `WeaponType`.
//    - Records the `last_attack_time` to enforce cooldowns.
// 3. **Updating Animations (`combat_animations_update`):**
//    - Called each frame with `delta_time` to advance the `time_elapsed` for all active animations.
//    - Calculates `progress` (normalized 0.0 to 1.0) and applies an easing function for smooth motion.
//    - For `ANIMATION_ATTACK`, it interpolates the `current_offset` to simulate a forward and backward swing
//      with a slight vertical arc.
//    - Deactivates animations once their duration is complete.
// 4. **Querying Animation State (`combat_animations_get_weapon_offset`, `combat_animations_is_damage_window`):**
//    - `combat_animations_get_weapon_offset`: Returns the current `Vec3` offset for rendering
//      an equipped weapon, based on the active attack animation's `current_offset`.
//    - `combat_animations_is_damage_window`: Checks if an active attack animation is currently
//      within its designated "damage dealing" phase (e.g., the forward swing of an attack).
// 5. **Cooldown Management (`combat_animations_can_attack`, `combat_animations_get_cooldown_remaining`):**
//    - `combat_animations_can_attack`: Determines if a new attack can be initiated by checking
//      against the `attack_cooldown`.
//    - `combat_animations_get_cooldown_remaining`: Provides the time remaining until the next attack is possible.
//
// Invariants:
// - The `CombatAnimationSystem` must be initialized before any animations can be started or updated.
// - `delta_time` must be consistently passed to `combat_animations_update` for accurate time progression.
// - `WeaponType` and `AnimationType` enumerations are assumed to be defined externally.
// - The system uses a static array (`g_animations`) for simplicity, limiting concurrent animations.
// - Attack animations are characterized by a forward swing followed by a return to idle.
//
// (Additional comments from the file indicating external dependencies and roadmaps are preserved.)
// Combat animation state helpers.
// Roadmap: docs/COMBAT_ANIM_ROADMAP.md.
#include "../../include/combat/combat_animations.h"
#include "../../include/math/vec3.h"
#include <math.h>
#include <string.h>

// Animation state
struct AnimationState {
    bool active;
    f32 time_elapsed;
    f32 duration;
    f32 progress; // 0.0 to 1.0
    AnimationType type;
    Vec3 start_pos;
    Vec3 end_pos;
    Vec3 current_offset;
};

#define MAX_ANIMATIONS 16
static AnimationState g_animations[MAX_ANIMATIONS] = {0};

// Initialize combat animation system
void combat_animations_init(CombatAnimationSystem *system) {
    if (!system) return;
    memset(system, 0, sizeof(CombatAnimationSystem));
    system->animations = g_animations;
    system->animation_capacity = MAX_ANIMATIONS;
    system->attack_cooldown = 0.6f; // 0.6 seconds between attacks
    system->time_seconds = 0.0f;
}

// Start attack animation
void combat_animations_start_attack(CombatAnimationSystem *system, WeaponType weapon_type, Vec3 attack_direction) {
    if (!system) return;
    
    // Check cooldown
    f32 current_time = system->time_seconds;
    if (current_time - system->last_attack_time < system->attack_cooldown) {
        return; // Still on cooldown
    }
    
    // Find free animation slot
    AnimationState *anim = NULL;
    for (u32 i = 0; i < system->animation_capacity; i++) {
        if (!system->animations[i].active) {
            anim = &system->animations[i];
            break;
        }
    }
    
    if (!anim) return; // No free slots
    
    // Set up animation based on weapon type
    anim->active = true;
    anim->time_elapsed = 0.0f;
    anim->type = ANIMATION_ATTACK;
    anim->start_pos = vec3(0.0f, 0.0f, 0.0f);
    anim->end_pos = vec3_mul(vec3_normalize(attack_direction), 0.3f); // Swing forward
    anim->current_offset = anim->start_pos;
    
    // Duration based on weapon type
    switch (weapon_type) {
        case WEAPON_TYPE_SWORD:
            anim->duration = 0.4f;
            break;
        case WEAPON_TYPE_AXE:
            anim->duration = 0.5f;
            break;
        case WEAPON_TYPE_PICKAXE:
            anim->duration = 0.45f;
            break;
        default:
            anim->duration = 0.4f;
            break;
    }
    
    system->last_attack_time = current_time;
}

// Update animations
void combat_animations_update(CombatAnimationSystem *system, f32 delta_time) {
    if (!system) return;

    system->time_seconds += delta_time;
    
    for (u32 i = 0; i < 16; i++) {
        AnimationState *anim = &system->animations[i];
        if (!anim->active) continue;
        
        anim->time_elapsed += delta_time;
        anim->progress = anim->time_elapsed / anim->duration;
        
        if (anim->progress > 1.0f) {
            anim->progress = 1.0f;
        }
        
        // Calculate animation curve (ease in-out)
        f32 t = anim->progress;
        f32 eased = t < 0.5f ? 
            2.0f * t * t : 
            1.0f - powf(-2.0f * t + 2.0f, 2.0f) / 2.0f;
        
        // For attack animation: swing forward then back
        if (anim->type == ANIMATION_ATTACK) {
            if (t < 0.3f) {
                // Swing forward (first 30% of animation)
                f32 forward_t = t / 0.3f;
                anim->current_offset = vec3_lerp(anim->start_pos, anim->end_pos, forward_t);
            } else {
                // Swing back (remaining 70%)
                f32 back_t = (t - 0.3f) / 0.7f;
                anim->current_offset = vec3_lerp(anim->end_pos, anim->start_pos, back_t);
            }
            
            // Add slight vertical arc
            f32 arc_height = sinf(t * 3.14159f) * 0.1f;
            anim->current_offset.y += arc_height;
        }
        
        // Check if animation complete
        if (anim->progress >= 1.0f) {
            anim->active = false;
            anim->current_offset = vec3(0.0f, 0.0f, 0.0f);
        }
    }
}

// Get current animation offset for weapon
Vec3 combat_animations_get_weapon_offset(CombatAnimationSystem *system) {
    if (!system) return vec3(0.0f, 0.0f, 0.0f);
    
    // Find active attack animation
    for (u32 i = 0; i < 16; i++) {
        if (system->animations[i].active && 
            system->animations[i].type == ANIMATION_ATTACK) {
            return system->animations[i].current_offset;
        }
    }
    
    return vec3(0.0f, 0.0f, 0.0f);
}

// Check if attack animation is in damage window
bool combat_animations_is_damage_window(CombatAnimationSystem *system) {
    if (!system) return false;
    
    // Find active attack animation
    for (u32 i = 0; i < 16; i++) {
        AnimationState *anim = &system->animations[i];
        if (anim->active && anim->type == ANIMATION_ATTACK) {
            // Damage window is during forward swing (0.1 to 0.3)
            return anim->progress >= 0.1f && anim->progress <= 0.3f;
        }
    }
    
    return false;
}

// Check if can attack (not on cooldown)
bool combat_animations_can_attack(CombatAnimationSystem *system, f32 current_time) {
    if (!system) return false;
    return (current_time - system->last_attack_time) >= system->attack_cooldown;
}

// Get attack cooldown remaining
f32 combat_animations_get_cooldown_remaining(CombatAnimationSystem *system, f32 current_time) {
    if (!system) return 0.0f;
    f32 elapsed = current_time - system->last_attack_time;
    f32 remaining = system->attack_cooldown - elapsed;
    return remaining > 0.0f ? remaining : 0.0f;
}
