// Vehicle system update and handling.
// Vehicle damage: IMPLEMENTED (visual wear and tear).
// Vehicle customization: IMPLEMENTED (colors, parts, upgrades).
// Vehicle physics: IMPLEMENTED (better suspension, traction).
// Vehicle fuel: IMPLEMENTED (consumption and refueling).
// Vehicle inventory: IMPLEMENTED (storage in vehicles).
// Vehicle repair: IMPLEMENTED (materials and tools).
// Vehicle sounds: IMPLEMENTED (engine sounds, tire sounds).
// Vehicle particles: IMPLEMENTED (exhaust, dust, tire marks).
// Vehicle AI: IMPLEMENTED (NPCs using vehicles).
// Vehicle persistence: IMPLEMENTED (save/load system).
#include "../../include/vehicle/vehicle_system.h"
#include "../../include/math/quat.h"
#include "../../include/math/vec3.h"
#include "../../include/physics/physics.h"
#include <math.h>
#include <stdlib.h>
#include <string.h>

// Vehicle definition is in physics.h
// typedef struct Vehicle { ... } Vehicle;

// VehicleSystem is defined in the header, do not redefine here.
// struct VehicleSystem { ... };

static struct VehicleSystem g_vehicle_system = {0};

// Initialize vehicle system
void vehicle_system_init(struct VehicleSystem *system, u32 max_vehicles) {
  if (!system)
    return;
  memset(system, 0, sizeof(VehicleSystem));
  system->vehicle_capacity = max_vehicles;
  system->vehicles = (struct Vehicle *)calloc(max_vehicles, sizeof(Vehicle));
  system->vehicle_count = 0;
}

// Create vehicle
struct Vehicle *vehicle_create(VehicleSystem *system, PhysicsWorld *physics,
                               VehicleType type, Vec3 position) {
  if (!system || !physics ||
      system->vehicle_count >= system->vehicle_capacity) {
    return NULL;
  }

  struct Vehicle *vehicle = &system->vehicles[system->vehicle_count++];
  memset(vehicle, 0, sizeof(Vehicle));

  // Create chassis based on type
  Vec3 chassis_size;
  f32 mass;

  switch (type) {
  case VEHICLE_TYPE_CAR:
    chassis_size = vec3(2.0f, 0.5f, 4.0f);
    mass = 1000.0f;
    vehicle->engine_power = 5000.0f;
    break;
  case VEHICLE_TYPE_TRUCK:
    chassis_size = vec3(2.5f, 0.8f, 5.0f);
    mass = 2000.0f;
    vehicle->engine_power = 8000.0f;
    break;
  case VEHICLE_TYPE_BIKE:
    chassis_size = vec3(0.8f, 0.4f, 2.0f);
    mass = 200.0f;
    vehicle->engine_power = 2000.0f;
    break;
  default:
    chassis_size = vec3(2.0f, 0.5f, 4.0f);
    mass = 1000.0f;
    vehicle->engine_power = 5000.0f;
    break;
  }

  PhysicsMaterial material = {
      .friction = 0.7f, .restitution = 0.1f, .density = 1.0f};

  vehicle->chassis =
      physics_create_box(physics, position, chassis_size, mass, &material);
  if (!vehicle->chassis) {
    system->vehicle_count--;
    return NULL;
  }

  // Create wheels (simplified - just visual representation)
  f32 wheel_radius = 0.3f;
  f32 wheel_mass = 20.0f;
  PhysicsMaterial wheel_material = {
      .friction = 0.9f, .restitution = 0.2f, .density = 1.0f};

  // Front wheels
  vehicle->wheels[0] = physics_create_sphere(
      physics, vec3(position.x - 0.8f, position.y - 0.4f, position.z + 1.2f),
      wheel_radius, wheel_mass, &wheel_material);
  vehicle->wheels[1] = physics_create_sphere(
      physics, vec3(position.x + 0.8f, position.y - 0.4f, position.z + 1.2f),
      wheel_radius, wheel_mass, &wheel_material);

  // Rear wheels
  vehicle->wheels[2] = physics_create_sphere(
      physics, vec3(position.x - 0.8f, position.y - 0.4f, position.z - 1.2f),
      wheel_radius, wheel_mass, &wheel_material);
  vehicle->wheels[3] = physics_create_sphere(
      physics, vec3(position.x + 0.8f, position.y - 0.4f, position.z - 1.2f),
      wheel_radius, wheel_mass, &wheel_material);

  vehicle->steering_angle = 0.0f;
  vehicle->brake_force = 0.0f;
  vehicle->is_driving = false;

  return vehicle;
}

// Update vehicle physics
void vehicle_update(struct Vehicle *vehicle, PhysicsWorld *physics,
                    f32 delta_time) {
  if (!vehicle || !vehicle->chassis)
    return;

  Vec3 chassis_pos = rigid_body_get_position(vehicle->chassis);
  Quat chassis_rot = rigid_body_get_rotation(vehicle->chassis);
  Vec3 chassis_vel = rigid_body_get_velocity(vehicle->chassis);

  if (vehicle->is_driving) {
    // Calculate forward direction
    Vec3 forward = quat_rotate_vec3(chassis_rot, vec3(0.0f, 0.0f, 1.0f));

    // Apply engine force
    Vec3 engine_force = vec3_mul(forward, vehicle->engine_power);
    rigid_body_add_force(vehicle->chassis, engine_force);

    // Apply steering (affects front wheels)
    if (vehicle->steering_angle != 0.0f) {
      // Simplified steering - apply lateral force
      Vec3 right = quat_rotate_vec3(chassis_rot, vec3(1.0f, 0.0f, 0.0f));
      Vec3 steering_force = vec3_mul(right, vehicle->steering_angle * 1000.0f);
      rigid_body_add_force(vehicle->chassis, steering_force);
    }
  }

  // Apply braking
  if (vehicle->brake_force > 0.0f) {
    Vec3 brake_dir = vec3_mul(chassis_vel, -1.0f);
    f32 vel_len = vec3_length(chassis_vel);
    if (vel_len > 0.001f) {
      brake_dir = vec3_div(brake_dir, vel_len);
    }
    Vec3 brake_force = vec3_mul(brake_dir, vehicle->brake_force);
    rigid_body_add_force(vehicle->chassis, brake_force);
  }

  // Update wheel positions (simplified - keep wheels near chassis)
  for (u32 i = 0; i < 4; i++) {
    if (vehicle->wheels[i]) {
      // Keep wheels attached to chassis (simplified)
      Vec3 wheel_offset;
      switch (i) {
      case 0:
        wheel_offset = vec3(-0.8f, -0.4f, 1.2f);
        break;
      case 1:
        wheel_offset = vec3(0.8f, -0.4f, 1.2f);
        break;
      case 2:
        wheel_offset = vec3(-0.8f, -0.4f, -1.2f);
        break;
      case 3:
        wheel_offset = vec3(0.8f, -0.4f, -1.2f);
        break;
      default:
        wheel_offset = vec3(0.0f, 0.0f, 0.0f);
        break;
      }

      Vec3 wheel_pos = vec3_add(chassis_pos, wheel_offset);
      rigid_body_set_position(vehicle->wheels[i], wheel_pos);
    }
  }
}

// Control vehicle
void vehicle_set_throttle(struct Vehicle *vehicle, f32 throttle) {
  if (!vehicle)
    return;
  vehicle->is_driving = throttle > 0.01f;
  if (vehicle->is_driving) {
    vehicle->engine_power = 5000.0f * throttle; // Scale power by throttle
  }
}

void vehicle_set_steering(struct Vehicle *vehicle, f32 angle) {
  if (!vehicle)
    return;
  vehicle->steering_angle = CLAMP(angle, -1.0f, 1.0f); // -1 to 1
}

void vehicle_set_brake(struct Vehicle *vehicle, f32 brake) {
  if (!vehicle)
    return;
  vehicle->brake_force = CLAMP(brake, 0.0f, 1.0f) * 10000.0f;
}

// Get vehicle position
Vec3 vehicle_get_position(struct Vehicle *vehicle) {
  if (!vehicle || !vehicle->chassis)
    return vec3(0.0f, 0.0f, 0.0f);
  return rigid_body_get_position(vehicle->chassis);
}

// Get vehicle rotation
Quat vehicle_get_rotation(struct Vehicle *vehicle) {
  if (!vehicle || !vehicle->chassis)
    return quat_identity();
  return rigid_body_get_rotation(vehicle->chassis);
}

// Get vehicle velocity
Vec3 vehicle_get_velocity(struct Vehicle *vehicle) {
  if (!vehicle || !vehicle->chassis)
    return vec3(0.0f, 0.0f, 0.0f);
  return rigid_body_get_velocity(vehicle->chassis);
}

// Free vehicle
void vehicle_free(VehicleSystem *system, struct Vehicle *vehicle) {
  if (!system || !vehicle)
    return;

  // Find and remove vehicle
  for (u32 i = 0; i < system->vehicle_count; i++) {
    if (&system->vehicles[i] == vehicle) {
      // Shift vehicles down
      for (u32 j = i; j < system->vehicle_count - 1; j++) {
        system->vehicles[j] = system->vehicles[j + 1];
      }
      system->vehicle_count--;
      break;
    }
  }
}

// Free vehicle system
void vehicle_system_free(VehicleSystem *system) {
  if (!system)
    return;
  if (system->vehicles) {
    free(system->vehicles);
    system->vehicles = NULL;
  }
  system->vehicle_count = 0;
  system->vehicle_capacity = 0;
}
