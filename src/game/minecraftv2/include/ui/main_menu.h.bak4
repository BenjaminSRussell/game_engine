// include/ui/main_menu.h
//
// Purpose: Enhanced main menu UI system with comprehensive navigation, 
// world management, and modern interface design. This header defines 
// the complete main menu experience including background animations,
// world selection, settings integration, and multiplayer functionality.
//
// Features:
// - Dynamic background with animated world preview
// - World selection with thumbnails and statistics
// - Settings integration with real-time preview
// - Multiplayer server browser
// - News and updates feed
// - Achievement showcase
// - Language selection
// - Accessibility options
//
#ifndef MAIN_MENU_H
#define MAIN_MENU_H

#include "../game_common.h"
#include "../math/vec2.h"
#include "menu.h"

// Forward declarations
struct VulkanRenderer;
struct SaveSystem;
struct NetworkSystem;

// Main menu sections
typedef enum {
    MAIN_MENU_SINGLEPLAYER,
    MAIN_MENU_MULTIPLAYER,
    MAIN_MENU_REALMS,
    MAIN_MENU_OPTIONS,
    MAIN_MENU_QUIT,
    MAIN_MENU_LANGUAGE,
    MAIN_MENU_ACCESSIBILITY,
    MAIN_MENU_NEWS,
    MAIN_MENU_ACHIEVEMENTS,
    MAIN_MENU_COUNT
} MainMenuSection;

// World preview data
typedef struct {
    char name[64];
    char seed[32];
    u32 play_time_hours;
    u32 last_played_days_ago;
    u32 game_mode;
    u32 difficulty;
    bool has_thumbnail;
    u32 thumbnail_texture_id;
    Vec3 spawn_position;
    char biome[32];
} WorldPreview;

// News item
typedef struct {
    char title[128];
    char content[512];
    char date[16];
    u32 type; // NEWS_UPDATE, NEWS_EVENT, NEWS_PATCH
    bool is_read;
} NewsItem;

// Achievement showcase item
typedef struct {
    char name[64];
    char description[256];
    u32 icon_texture_id;
    u32 progress; // 0-100
    bool is_unlocked;
    f32 unlock_time;
} AchievementShowcase;

// Server browser entry
typedef struct {
    char name[64];
    char address[64];
    u32 players_online;
    u32 max_players;
    u32 ping_ms;
    char version[16];
    char description[128];
    bool has_whitelist;
    bool is_online;
    u32 icon_texture_id;
} ServerEntry;

// Main menu system
typedef struct {
    MenuSystem base_menu;
    
    // Current section
    MainMenuSection current_section;
    
    // Animation state
    f32 background_rotation;
    f32 background_zoom;
    Vec3 background_focus_point;
    
    // World selection
    struct {
        WorldPreview *worlds;
        u32 world_count;
        u32 selected_index;
        bool creating_world;
        bool deleting_world;
        char search_query[64];
        u32 sort_mode; // by_name, by_last_played, by_play_time
        bool show_hidden_worlds;
    } world_selection;
    
    // Multiplayer
    struct {
        ServerEntry *servers;
        u32 server_count;
        u32 selected_index;
        bool refreshing;
        f32 refresh_progress;
        char search_query[64];
        bool show_lan_only;
        bool show_favorite_only;
    } multiplayer;
    
    // News feed
    struct {
        NewsItem *items;
        u32 item_count;
        u32 scroll_offset;
        bool loading;
        f32 last_update_time;
    } news;
    
    // Achievement showcase
    struct {
        AchievementShowcase *achievements;
        u32 achievement_count;
        u32 scroll_offset;
        u32 selected_category;
    } achievements;
    
    // Settings preview
    struct {
        f32 master_volume;
        u32 render_distance;
        bool fullscreen;
        u32 graphics_quality;
        bool vsync;
        u32 fov;
        char language_code[8];
    } settings_preview;
    
    // Accessibility
    struct {
        bool high_contrast;
        f32 text_scale;
        bool colorblind_mode;
        bool screen_reader;
        bool reduced_motion;
    } accessibility;
    
    // UI state
    struct {
        bool show_tutorial;
        u32 tutorial_step;
        f32 notification_timer;
        char notification_text[128];
        bool show_update_available;
        char update_version[16];
    } ui_state;
} MainMenuSystem;

// Initialize main menu system
void main_menu_init(MainMenuSystem *menu, struct VulkanRenderer *renderer, 
                   struct SaveSystem *save_system, struct NetworkSystem *network);

// Free main menu system
void main_menu_free(MainMenuSystem *menu);

// Update main menu (called each frame)
void main_menu_update(MainMenuSystem *menu, f32 delta_time);

// Render main menu
void main_menu_render(MainMenuSystem *menu, struct VulkanRenderer *renderer);

// Navigation
void main_menu_set_section(MainMenuSystem *menu, MainMenuSection section);
MainMenuSection main_menu_get_section(MainMenuSystem *menu);

// World management
void main_menu_refresh_worlds(MainMenuSystem *menu);
void main_menu_select_world(MainMenuSystem *menu, u32 index);
void main_menu_create_world(MainMenuSystem *menu, const char *name, u32 seed, u32 game_mode, u32 difficulty);
void main_menu_delete_world(MainMenuSystem *menu, u32 index);
void main_menu_edit_world(MainMenuSystem *menu, u32 index);

// Multiplayer
void main_menu_refresh_servers(MainMenuSystem *menu);
void main_menu_add_server(MainMenuSystem *menu, const char *address, const char *name);
void main_menu_remove_server(MainMenuSystem *menu, u32 index);
void main_menu_connect_to_server(MainMenuSystem *menu, u32 index);

// News
void main_menu_refresh_news(MainMenuSystem *menu);
void main_menu_mark_news_read(MainMenuSystem *menu, u32 index);

// Settings
void main_menu_update_settings_preview(MainMenuSystem *menu);
void main_menu_apply_settings(MainMenuSystem *menu);

// Accessibility
void main_menu_update_accessibility(MainMenuSystem *menu);

// Input handling
void main_menu_handle_mouse_move(MainMenuSystem *menu, f32 x, f32 y);
void main_menu_handle_mouse_click(MainMenuSystem *menu, f32 x, f32 y, bool pressed);
void main_menu_handle_key(MainMenuSystem *menu, u32 key, bool pressed);
void main_menu_handle_scroll(MainMenuSystem *menu, f32 scroll_delta);

// Background animations
void main_menu_update_background(MainMenuSystem *menu, f32 delta_time);
void main_menu_set_background_focus(MainMenuSystem *menu, Vec3 world_position);

// Tutorial system
void main_menu_start_tutorial(MainMenuSystem *menu);
void main_menu_advance_tutorial(MainMenuSystem *menu);
void main_menu_skip_tutorial(MainMenuSystem *menu);

// Notifications
void main_menu_show_notification(MainMenuSystem *menu, const char *text, f32 duration);
void main_menu_show_update_notification(MainMenuSystem *menu, const char *version);

// Localization
void main_menu_set_language(MainMenuSystem *menu, const char *language_code);
const char* main_menu_get_localized_text(MainMenuSystem *menu, const char *key);

#endif // MAIN_MENU_H
