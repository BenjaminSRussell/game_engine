// include/save/save.h
//
// Purpose: Defines the public API and data structures for the game's save/load
// system. This comprehensive system is responsible for persisting the entire
// game state, including world metadata, individual chunk data, and all
// entity-related information (including NPCs). It provides a robust mechanism
// for players to save their progress and resume their games later.
//
// Public APIs:
// - `SAVE_FORMAT_VERSION`: A constant defining the current version of the save
// file format.
// - `SaveHeader`: Structure containing crucial metadata for a save file, such
// as
//   a magic number for validation, format version, world seed, timestamp, and
//   counts of chunks and entities.
// - `ChunkSaveData`: Structure for storing serialized data of a single chunk,
//   including its position, block IDs, light levels, and modification status.
// - `EntitySaveData`: Structure for storing serialized data of a single entity,
//   including its ID, component types, and their associated data.
// - `SaveSystem`: The main structure encapsulating the save system's state,
//   including the save directory, current world name, and flags for ongoing
//   save/load operations.
// - `save_system_init`: Initializes the save system with a specified root
// directory for save files.
// - `save_system_free`: Frees resources associated with the save system.
// - `save_world`: Orchestrates the saving of an entire game world, including
// chunks,
//   ECS entities, and NPC data, to persistent storage.
// - `load_world`: Orchestrates the loading of an entire game world from
// persistent
//   storage, reconstructing chunks, ECS entities, and NPC data.
// - `save_chunk`, `load_chunk`: Functions for serializing and deserializing
// individual chunks.
// - `save_entities`, `load_entities`: Functions for serializing and
// deserializing all ECS entities.
// - `save_npcs`, `load_npcs`: Functions for serializing and deserializing
// NPC-specific data,
//   integrating with the `NPCSystem`.
// - `WorldMetadata`: Structure to hold high-level information about a saved
// world (name, seed,
//   last played time, play time, chunk count, spawn position).
// - `save_world_metadata`, `load_world_metadata`: Functions for managing world
// metadata files.
// - `get_world_list`: Retrieves a list of all available saved worlds and their
// metadata.
//
// Ownership: The `SaveSystem` manages the file I/O operations and the state of
// the saving/loading process. It does not own the `ChunkManager`, `ECSWorld`,
// or `NPCSystem` instances it interacts with, but operates on their data.
//
// Invariants:
// - A `SaveSystem` must be initialized before any save/load operations.
// - Data structures like `Chunk`, `ECSWorld`, and `NPCSystem` (from their
// respective headers)
//   are assumed to be correctly defined and initialized.
// - Save files are expected to conform to the defined `SAVE_FORMAT_VERSION`.
// - The `save_directory` must be writable and readable.
//
#ifndef SAVE_H
#define SAVE_H

#include "../chunk/chunk.h"
#include "../game_common.h"
#include "../ecs/ecs.h"

// Forward declarations
struct NPCSystem;
struct ECSWorld;

// Weather system forward declaration
struct WeatherSystem;
// Save file format version
#define SAVE_FORMAT_VERSION 1

// Save file header
typedef struct {
  u32 magic; // "GAME" in ASCII
  u32 version;
  u32 seed;
  u64 timestamp;
  u32 chunk_count;
  u32 entity_count;
} SaveHeader;

// Chunk save data
typedef struct {
  ChunkPos position;
  BlockID *blocks;
  u8 *light_levels;
  bool modified;
} ChunkSaveData;

// Entity save data
typedef struct {
  EntityID id;
  ComponentTypeID *component_types;
  u32 component_count;
  void *component_data;
  u32 data_size;
} EntitySaveData;

// Save system
typedef struct SaveSystem {
  char save_directory[256];
  char current_world_name[64];
  bool is_saving;
  bool is_loading;
} SaveSystem;

// Initialize save system
void save_system_init(SaveSystem *save, const char *save_directory);
void save_system_free(SaveSystem *save);

// World save/load
bool save_world(SaveSystem *save, const char *world_name, ChunkManager *chunks,
                struct ECSWorld *ecs, struct NPCSystem *npc_system, u32 seed);
bool load_world(SaveSystem *save, const char *world_name, ChunkManager *chunks,
                struct ECSWorld *ecs, struct NPCSystem *npc_system, u32 *seed);

// Chunk save/load
bool save_chunk(SaveSystem *save, const char *world_name, Chunk *chunk);
bool load_chunk(SaveSystem *save, const char *world_name, ChunkPos pos,
                Chunk *chunk);

// Entity save/load
bool save_entities(SaveSystem *save, const char *world_name,
                   struct ECSWorld *ecs);
EntityID *load_entities(SaveSystem *save, const char *world_name,
                        struct ECSWorld *ecs);

// NPC save/load
bool save_npcs(SaveSystem *save, const char *world_name,
               struct NPCSystem *npc_system);
bool load_npcs(SaveSystem *save, const char *world_name,
               struct NPCSystem *npc_system, struct ECSWorld *ecs,
               EntityID *id_map);

// Weather save/load
bool save_weather(SaveSystem *save, const char *world_name,
                  struct WeatherSystem *weather);
bool load_weather(SaveSystem *save, const char *world_name,
                  struct WeatherSystem *weather);

// World metadata
typedef struct {
  char name[64];
  u32 seed;
  u64 last_played;
  u64 play_time;
  u32 chunk_count;
  Vec3 spawn_position;
  bool ray_tracing_enabled; // Persist ray tracing setting
} WorldMetadata;

bool save_world_metadata(SaveSystem *save, WorldMetadata *metadata);
bool load_world_metadata(SaveSystem *save, const char *world_name,
                         WorldMetadata *metadata);
bool get_world_list(SaveSystem *save, WorldMetadata **worlds, u32 *count);

#endif // SAVE_H
