// TODO: Implement mob breeding system for passive mobs.
// TODO: Add mob taming system for certain mobs.
// TODO: Implement mob equipment system for armor and weapons.
#include "../../../include/mobs/mob_system.h"
#include "../../../include/weather/weather.h"
