#include "../../../include/core/logger.h"
#include <stdlib.h>
#include <string.h>
#include <math.h>


static f32 mob_get_max_health(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE: return 20.0f;
        case MOB_TYPE_SKELETON: return 20.0f;
        case MOB_TYPE_SPIDER: return 16.0f;
        case MOB_TYPE_CREEPER: return 20.0f;
        case MOB_TYPE_ENDERMAN: return 40.0f;
        case MOB_TYPE_BLAZE: return 20.0f;
        case MOB_TYPE_COW: return 10.0f;
        case MOB_TYPE_PIG: return 10.0f;
        case MOB_TYPE_SHEEP: return 8.0f;
        case MOB_TYPE_CHICKEN: return 4.0f;
        default: return 10.0f;
    }
}

static f32 mob_get_speed(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE: return 4.3f;
        case MOB_TYPE_SKELETON: return 3.2f;
        case MOB_TYPE_SPIDER: return 4.88f;
        case MOB_TYPE_CREEPER: return 2.5f;
        case MOB_TYPE_ENDERMAN: return 3.1f;
        case MOB_TYPE_BLAZE: return 5.0f;
        case MOB_TYPE_COW: return 4.0f;
        case MOB_TYPE_PIG: return 4.0f;
        case MOB_TYPE_SHEEP: return 3.5f;
        case MOB_TYPE_CHICKEN: return 2.0f;
        default: return 4.0f;
    }
}

static f32 mob_get_attack_range(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE: return 2.0f;
        case MOB_TYPE_SKELETON: return 15.0f;
        case MOB_TYPE_SPIDER: return 2.0f;
        case MOB_TYPE_CREEPER: return 2.0f;
        case MOB_TYPE_ENDERMAN: return 2.0f;
        case MOB_TYPE_BLAZE: return 15.0f;
        default: return 2.0f;
    }
}

static f32 mob_get_attack_damage(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE: return 3.0f;
        case MOB_TYPE_SKELETON: return 2.5f;
        case MOB_TYPE_SPIDER: return 2.0f;
        case MOB_TYPE_CREEPER: return 6.0f;
        case MOB_TYPE_ENDERMAN: return 7.0f;
        case MOB_TYPE_BLAZE: return 4.0f;
        default: return 0.0f;
    }
}

static f32 mob_get_attack_cooldown(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE: return 1.2f;
        case MOB_TYPE_SKELETON: return 1.8f;
        case MOB_TYPE_SPIDER: return 1.5f;
        case MOB_TYPE_CREEPER: return 2.5f;
        case MOB_TYPE_ENDERMAN: return 1.0f;
        case MOB_TYPE_BLAZE: return 1.6f;
        default: return 2.0f;
    }
}

static DamageType mob_get_attack_damage_type(MobType type) {
    switch (type) {
        case MOB_TYPE_SKELETON:
        case MOB_TYPE_BLAZE:
            return DAMAGE_TYPE_RANGED;
        case MOB_TYPE_CREEPER:
            return DAMAGE_TYPE_EXPLOSION;
        default:
            return DAMAGE_TYPE_MELEE;
    }
}

// Apply weather effects to mob behavior
static f32 mob_get_weather_speed_modifier(MobType type, WeatherSystem *weather) {
    if (!weather) return 1.0f;
    
    WeatherType current_weather = weather_get_current_type(weather);
    f32 modifier = 1.0f;
    
    switch (current_weather) {
        case WEATHER_CLEAR:
            modifier = 1.0f;
            break;
        case WEATHER_CLOUDY:
            modifier = 0.95f; // Slightly slower in overcast
            break;
        case WEATHER_RAIN_LIGHT:
            modifier = 0.85f; // Rain slows movement
            break;
        case WEATHER_RAIN_MODERATE:
            modifier = 0.75f;
            break;
        case WEATHER_RAIN_HEAVY:
            modifier = 0.65f;
            break;
        case WEATHER_STORM:
            modifier = 0.5f; // Storms significantly slow movement
            break;
        case WEATHER_SNOW_LIGHT:
            modifier = 0.9f; // Light snow has minor effect
            break;
        case WEATHER_SNOW_MODERATE:
            modifier = 0.8f;
            break;
        case WEATHER_SNOW_HEAVY:
            modifier = 0.7f;
            break;
        case WEATHER_BLIZZARD:
            modifier = 0.4f; // Blizzards severely limit movement
            break;
        case WEATHER_FOG_LIGHT:
            modifier = 0.95f; // Fog slightly reduces speed (caution)
            break;
        case WEATHER_FOG_MODERATE:
            modifier = 0.85f;
            break;
        case WEATHER_FOG_HEAVY:
            modifier = 0.75f;
            break;
    }
    
    // Some mobs are affected differently by weather
    switch (type) {
        case MOB_TYPE_ZOMBIE:
            // Zombies move slightly faster in rain (undead preference)
            if (current_weather == WEATHER_RAIN_LIGHT || 
                current_weather == WEATHER_RAIN_MODERATE ||
                current_weather == WEATHER_RAIN_HEAVY) {
                modifier *= 1.2f;
            }
            break;
        case MOB_TYPE_SKELETON:
            // Skeletons avoid rain (undead disadvantage)
            if (current_weather == WEATHER_RAIN_LIGHT || 
                current_weather == WEATHER_RAIN_MODERATE ||
                current_weather == WEATHER_RAIN_HEAVY) {
                modifier *= 0.7f;
            }
            break;
        case MOB_TYPE_SPIDER:
            // Spiders move normally in most weather but slower in snow
            if (current_weather == WEATHER_SNOW_LIGHT || 
                current_weather == WEATHER_SNOW_MODERATE ||
                current_weather == WEATHER_SNOW_HEAVY ||
                current_weather == WEATHER_BLIZZARD) {
                modifier *= 0.6f;
            }
            break;
        case MOB_TYPE_CREEPER:
            // Creepers are unaffected by weather (explosive determination)
            modifier = 1.0f;
            break;
        case MOB_TYPE_BLAZE:
            // Blazes are weakened by rain
            if (current_weather == WEATHER_RAIN_LIGHT || 
                current_weather == WEATHER_RAIN_MODERATE ||
                current_weather == WEATHER_RAIN_HEAVY ||
                current_weather == WEATHER_STORM) {
                modifier *= 0.3f; // Rain severely affects blazes
            }
            break;
        default:
            break;
    }
    
    return modifier;
}

static f32 mob_get_weather_detection_modifier(MobType type, WeatherSystem *weather) {
    if (!weather) return 1.0f;
    
    WeatherType current_weather = weather_get_current_type(weather);
    f32 visibility = weather_get_visibility(weather);
    
    // Detection range is reduced by visibility
    f32 modifier = visibility;
    
    // Some mobs have special weather detection abilities
    switch (type) {
        case MOB_TYPE_SPIDER:
            // Spiders have better detection in fog
            if (current_weather == WEATHER_FOG_LIGHT || 
                current_weather == WEATHER_FOG_MODERATE ||
                current_weather == WEATHER_FOG_HEAVY) {
                modifier *= 1.3f;
            }
            break;
        case MOB_TYPE_ENDERMAN:
            // Endermen are unaffected by weather visibility
            modifier = 1.0f;
            break;
        default:
            break;
    }
    
    return modifier;
}

static f32 mob_get_detection_range(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE: return 40.0f;
        case MOB_TYPE_SKELETON: return 64.0f;
        case MOB_TYPE_SPIDER: return 30.0f;
        case MOB_TYPE_CREEPER: return 32.0f;
        case MOB_TYPE_ENDERMAN: return 64.0f;
        case MOB_TYPE_BLAZE: return 48.0f;
        default: return 30.0f;
    }
}

typedef struct {
    u32 item_id;
    u16 count;
    f32 drop_chance;
} MobLootDrop;

typedef struct {
    const MobLootDrop *drops;
    u32 drop_count;
} MobLootTable;

static const MobLootDrop g_zombie_loot[] = {
    {10, 1, 0.8f},
    {5, 1, 0.025f}
};

static const MobLootDrop g_skeleton_loot[] = {
    {11, 2, 0.9f},
    {12, 2, 0.7f}
};

static const MobLootDrop g_spider_loot[] = {
    {14, 1, 0.8f},
    {15, 1, 0.2f}
};

static const MobLootDrop g_creeper_loot[] = {
    {13, 2, 0.9f}
};

static const MobLootDrop g_enderman_loot[] = {
    {16, 1, 0.5f}
};

static const MobLootDrop g_blaze_loot[] = {
    {17, 1, 0.7f}
};

static const MobLootDrop g_cow_loot[] = {
    {20, 2, 1.0f},
    {21, 3, 1.0f}
};

static const MobLootDrop g_pig_loot[] = {
    {22, 2, 1.0f}
};

static const MobLootDrop g_sheep_loot[] = {
    {25, 1, 1.0f}
};

static const MobLootDrop g_chicken_loot[] = {
    {23, 1, 1.0f},
    {24, 1, 1.0f}
};

static const MobLootTable g_loot_tables[] = {
    [MOB_TYPE_ZOMBIE] = {g_zombie_loot, sizeof(g_zombie_loot) / sizeof(g_zombie_loot[0])},
    [MOB_TYPE_SKELETON] = {g_skeleton_loot, sizeof(g_skeleton_loot) / sizeof(g_skeleton_loot[0])},
    [MOB_TYPE_SPIDER] = {g_spider_loot, sizeof(g_spider_loot) / sizeof(g_spider_loot[0])},
    [MOB_TYPE_CREEPER] = {g_creeper_loot, sizeof(g_creeper_loot) / sizeof(g_creeper_loot[0])},
    [MOB_TYPE_ENDERMAN] = {g_enderman_loot, sizeof(g_enderman_loot) / sizeof(g_enderman_loot[0])},
    [MOB_TYPE_BLAZE] = {g_blaze_loot, sizeof(g_blaze_loot) / sizeof(g_blaze_loot[0])},
    [MOB_TYPE_COW] = {g_cow_loot, sizeof(g_cow_loot) / sizeof(g_cow_loot[0])},
    [MOB_TYPE_PIG] = {g_pig_loot, sizeof(g_pig_loot) / sizeof(g_pig_loot[0])},
    [MOB_TYPE_SHEEP] = {g_sheep_loot, sizeof(g_sheep_loot) / sizeof(g_sheep_loot[0])},
    [MOB_TYPE_CHICKEN] = {g_chicken_loot, sizeof(g_chicken_loot) / sizeof(g_chicken_loot[0])},
};

static void mob_spawn_loot(MobType type, Vec3 position) {
    extern struct PlayerSystem *g_player_system;
    const MobLootTable *table = NULL;
    if (type >= 0 && type < (MobType)(sizeof(g_loot_tables) / sizeof(g_loot_tables[0]))) {
        table = &g_loot_tables[type];
    }

    if (!table || table->drop_count == 0) {
        return;
    }

    Vec3 player_pos = vec3_zero();
    bool has_player = false;
    if (g_player_system) {
        player_pos = player_get_position(g_player_system);
        has_player = true;
    }

    f32 pickup_distance = 3.0f;
    for (u32 i = 0; i < table->drop_count; i++) {
        const MobLootDrop *drop = &table->drops[i];
        f32 roll = (rand() / (f32)RAND_MAX);
        if (roll > drop->drop_chance) {
            continue;
        }

        if (has_player && vec3_distance(player_pos, position) <= pickup_distance) {
            if (!player_add_item(g_player_system, drop->item_id, drop->count)) {
                LOG_INFO("Mob loot drop failed to add to inventory (item %u)", drop->item_id);
            }
        } else {
            LOG_INFO("Dropped item %u x%u at (%.1f, %.1f, %.1f)",
                     drop->item_id, drop->count, position.x, position.y, position.z);
        }
    }
}

static bool is_hostile_mob(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE:
        case MOB_TYPE_SKELETON:
        case MOB_TYPE_SPIDER:
        case MOB_TYPE_CREEPER:
        case MOB_TYPE_ENDERMAN:
        case MOB_TYPE_BLAZE:
            return true;
        default:
            return false;
    }
}

// Find player entity in the ECS world and return their position
// Returns true if player found and position is set
static bool mob_get_player_position(ECSWorld *ecs, Vec3 *out_position) {
    if (!ecs || !out_position) return false;

    extern struct PlayerSystem *g_player_system;
    if (g_player_system) {
        *out_position = player_get_position(g_player_system);
        return true;
    }

    // Query for entities with position components
    // For now, we assume the player has entity_id 0 (first entity in the world)
    // In a full system, you'd query by tag or explicit player component
    // This is a simplified approach that works with current architecture

    for (EntityID i = 0; i < 10; i++) {  // Check first 10 entities
        if (ecs_entity_exists(ecs, i)) {
            // Assume player is the first valid entity
            // A better approach would be to query for a PlayerComponent
            // or have a global player reference
            *out_position = vec3(0.0f, 0.0f, 0.0f);  // Placeholder
            return true;
        }
    }

    return false;
}

// Check if mob should flee based on health percentage
static bool mob_should_flee(Mob *mob) {
    if (!mob || mob->max_health == 0.0f) return false;
    f32 health_percentage = mob->health / mob->max_health;
    return health_percentage < 0.25f;  // Flee when below 25% health
}

void mob_manager_init(MobManager *manager, u32 capacity) {
    if (!manager) return;
    
    manager->capacity = capacity;
    manager->count = 0;
    manager->mobs = (Mob *)calloc(capacity, sizeof(Mob));
    memset(&manager->stats, 0, sizeof(manager->stats));
}

void mob_manager_free(MobManager *manager) {
    if (!manager) return;
    
    if (manager->mobs) {
        free(manager->mobs);
        manager->mobs = NULL;
    }
    manager->count = 0;
    manager->capacity = 0;
}

EntityID mob_spawn(MobManager *manager, MobType type, Vec3 position) {
    if (!manager || manager->count >= manager->capacity) {
        return 0xFFFFFFFF;
    }
    
    Mob *mob = &manager->mobs[manager->count];
    mob->entity_id = manager->count;
    mob->type = type;
    mob->state = MOB_STATE_IDLE;
    mob->position = position;
    mob->velocity = vec3(0.0f, 0.0f, 0.0f);
    mob->health = mob_get_max_health(type);
    mob->max_health = mob->health;
    mob->speed = mob_get_speed(type);
    mob->attack_range = mob_get_attack_range(type);
    mob->detection_range = mob_get_detection_range(type);
    mob->attack_cooldown = 0.0f;
    mob->wander_timer = 0.0f;
    mob->target_entity = 0xFFFFFFFF;
    mob->spawn_time = 0;
    mob->alive = true;
    
    manager->count++;
    manager->stats.spawned_total++;
    return mob->entity_id;
}

void mob_despawn(MobManager *manager, EntityID entity_id) {
    if (!manager || entity_id >= manager->count) return;
    
    Mob *mob = &manager->mobs[entity_id];
    mob->alive = false;
    
    if (entity_id < manager->count - 1) {
        memmove(&manager->mobs[entity_id], &manager->mobs[entity_id + 1],
                (manager->count - entity_id - 1) * sizeof(Mob));
        for (u32 i = entity_id; i < manager->count - 1; i++) {
            manager->mobs[i].entity_id = i;
        }
    }
    manager->count--;
    manager->stats.despawned_total++;
}

Mob *mob_get(MobManager *manager, EntityID entity_id) {
    if (!manager || entity_id >= manager->count) return NULL;
    return &manager->mobs[entity_id];
}

void mob_damage(MobManager *manager, EntityID entity_id, f32 damage) {
    Mob *mob = mob_get(manager, entity_id);
    if (!mob) return;
    
    mob->health -= damage;
    if (mob->health <= 0.0f) {
        mob->health = 0.0f;
        mob->state = MOB_STATE_DEAD;
        mob->alive = false;
        if (manager) {
            manager->stats.killed_total++;
        }
        mob_spawn_loot(mob->type, mob->position);
        mob_despawn(manager, entity_id);
    }
}

void mob_set_target(Mob *mob, Vec3 target) {
    if (!mob) return;
    mob->target_position = target;
    mob->state = is_hostile_mob(mob->type) ? MOB_STATE_ATTACKING : MOB_STATE_WANDERING;
}

void mob_set_target_entity(Mob *mob, EntityID target) {
    if (!mob) return;
    mob->target_entity = target;
    mob->state = is_hostile_mob(mob->type) ? MOB_STATE_ATTACKING : MOB_STATE_WANDERING;
}

bool mob_can_see_target(Mob *mob, Vec3 target) {
    if (!mob) return false;
    f32 distance = vec3_distance(mob->position, target);
    return distance <= mob->detection_range;
}

bool mob_in_range(Mob *mob, Vec3 target) {
    if (!mob) return false;
    f32 distance = vec3_distance(mob->position, target);
    return distance <= mob->attack_range;
}

static f32 random_float_range(f32 min, f32 max) {
    f32 range = max - min;
    return min + (rand() / (f32)RAND_MAX) * range;
}

void mob_update(MobManager *manager, f32 delta_time) {
    if (!manager) return;

    // Get global weather system for weather effects
    extern WeatherSystem *g_weather_system;

    // Get global ECS world for player detection
    extern ECSWorld *g_ecs_world;
    extern struct PlayerSystem *g_player_system;

    for (u32 i = 0; i < manager->count; i++) {
        Mob *mob = &manager->mobs[i];
        if (!mob->alive) continue;

        mob->spawn_time++;

        if (mob->attack_cooldown > 0.0f) {
            mob->attack_cooldown -= delta_time;
        }

        // Apply weather effects to mob behavior
        f32 weather_speed_modifier = mob_get_weather_speed_modifier(mob->type, g_weather_system);
        f32 weather_detection_modifier = mob_get_weather_detection_modifier(mob->type, g_weather_system);
        f32 effective_speed = mob->speed * weather_speed_modifier;
        f32 effective_detection_range = mob_get_detection_range(mob->type) * weather_detection_modifier;

        // Check if fleeing due to low health
        bool should_flee = mob_should_flee(mob);

        switch (mob->state) {
            case MOB_STATE_IDLE: {
                // Check for nearby player if hostile
                if (is_hostile_mob(mob->type) && g_ecs_world) {
                    Vec3 player_pos = {0, 0, 0};
                    if (mob_get_player_position(g_ecs_world, &player_pos)) {
                        f32 distance_to_player = vec3_distance(mob->position, player_pos);
                        if (distance_to_player <= effective_detection_range) {
                            // Player detected! Start attacking
                            mob->target_position = player_pos;
                            mob->state = MOB_STATE_ATTACKING;
                            break;
                        }
                    }
                }

                // Normal idle behavior
                mob->wander_timer += delta_time;
                if (mob->wander_timer > 5.0f) {
                    mob->state = MOB_STATE_WANDERING;
                    mob->target_position = vec3_add(mob->position, vec3(
                        random_float_range(-10.0f, 10.0f),
                        0.0f,
                        random_float_range(-10.0f, 10.0f)
                    ));
                    mob->wander_timer = 0.0f;
                }
                break;
            }

            case MOB_STATE_WANDERING: {
                // Check for nearby player if hostile
                if (is_hostile_mob(mob->type) && g_ecs_world) {
                    Vec3 player_pos = {0, 0, 0};
                    if (mob_get_player_position(g_ecs_world, &player_pos)) {
                        f32 distance_to_player = vec3_distance(mob->position, player_pos);
                        if (distance_to_player <= effective_detection_range) {
                            // Player detected! Start attacking
                            mob->target_position = player_pos;
                            mob->state = MOB_STATE_ATTACKING;
                            break;
                        }
                    }
                }

                // Normal wandering behavior
                Vec3 to_target = vec3_sub(mob->target_position, mob->position);
                f32 distance = vec3_length(to_target);

                if (distance < 1.0f) {
                    mob->state = MOB_STATE_IDLE;
                    mob->velocity = vec3(0.0f, 0.0f, 0.0f);
                } else {
                    Vec3 direction = vec3_normalize(to_target);
                    mob->velocity = vec3_mul(direction, effective_speed);
                    mob->position = vec3_add(mob->position, vec3_mul(mob->velocity, delta_time));
                }
                break;
            }

            case MOB_STATE_ATTACKING: {
                // Check if should flee due to low health
                if (should_flee) {
                    mob->state = MOB_STATE_FLEEING;
                    break;
                }

                if (g_player_system) {
                    mob->target_position = player_get_position(g_player_system);
                }

                Vec3 to_target = vec3_sub(mob->target_position, mob->position);
                f32 distance = vec3_length(to_target);

                if (distance > effective_detection_range) {
                    mob->state = MOB_STATE_IDLE;
                    mob->target_entity = 0xFFFFFFFF;
                } else if (distance > mob->attack_range) {
                    Vec3 direction = vec3_normalize(to_target);
                    mob->velocity = vec3_mul(direction, effective_speed);
                    mob->position = vec3_add(mob->position, vec3_mul(mob->velocity, delta_time));
                } else {
                    if (mob->attack_cooldown <= 0.0f) {
                        if (g_player_system) {
                            f32 damage = mob_get_attack_damage(mob->type);
                            if (damage > 0.0f) {
                                player_damage_detailed(g_player_system, damage,
                                                       mob_get_attack_damage_type(mob->type));
                                manager->stats.attacks_total++;
                                manager->stats.damage_dealt_total += damage;
                            }
                        }
                        mob->attack_cooldown = mob_get_attack_cooldown(mob->type);
                    }
                    mob->velocity = vec3(0.0f, 0.0f, 0.0f);
                }
                break;
            }

            case MOB_STATE_FLEEING: {
                // Stop fleeing if health recovers above 50%
                f32 health_percentage = mob->max_health > 0 ? mob->health / mob->max_health : 0.0f;
                if (health_percentage > 0.5f) {
                    mob->state = MOB_STATE_IDLE;
                    mob->velocity = vec3(0.0f, 0.0f, 0.0f);
                    break;
                }

                Vec3 away = vec3_sub(mob->position, mob->target_position);
                if (vec3_length(away) > 0.0f) {
                    Vec3 direction = vec3_normalize(away);
                    mob->velocity = vec3_mul(direction, effective_speed);
                }
                mob->position = vec3_add(mob->position, vec3_mul(mob->velocity, delta_time));
                break;
            }

            case MOB_STATE_DEAD: {
                mob->velocity = vec3(0.0f, 0.0f, 0.0f);
                break;
            }
        }
    }
}

const MobStats *mob_get_stats(const MobManager *manager) {
    if (!manager) return NULL;
    return &manager->stats;
}

void mob_reset_stats(MobManager *manager) {
    if (!manager) return;
    memset(&manager->stats, 0, sizeof(manager->stats));
}
