// include/vehicle/vehicle_system.h
//
// Purpose: Defines the public API and data structures for a simplified vehicle system.
// This header provides basic functionalities for creating, updating, and controlling
// vehicles. It includes an enumeration for fundamental `VehicleType`s and a `VehicleSystem`
// structure to manage a collection of these vehicles, integrating with the physics engine.
// (Note: This file appears to offer a more basic or earlier iteration of vehicle
// management compared to `include/vehicle/vehicle.h`).
//
// Public APIs:
// - `VehicleType`: Enumeration defining a few basic types of vehicles (Car, Truck, Bike).
// - `VehicleSystem`: Structure for managing a dynamic array of `Vehicle` instances,
//   tracking their count and capacity.
// - `vehicle_system_init`: Initializes the `VehicleSystem` with a specified maximum number of vehicles.
// - `vehicle_create`: Creates a new generic vehicle of a specified type at a given position,
//   integrating it with the `PhysicsWorld`. This function returns a pointer to a `struct Vehicle`
//   (likely from `physics.h` or a similar basic vehicle definition).
// - `vehicle_update`: Updates the physics and state of an individual vehicle.
// - `vehicle_set_throttle`, `vehicle_set_steering`, `vehicle_set_brake`: Functions for applying
//   control inputs to a vehicle.
// - `vehicle_get_position`, `vehicle_get_rotation`, `vehicle_get_velocity`: Functions to
//   query the current physical state of a vehicle.
// - `vehicle_free`: Frees resources associated with an individual vehicle.
// - `vehicle_system_free`: Frees all resources held by the `VehicleSystem`.
//
// Ownership: The `VehicleSystem` manages the collection of `struct Vehicle` instances.
// The `struct Vehicle` itself (forward declared) is assumed to be managed by the physics
// engine or a similar low-level system.
//
// Invariants:
// - A `VehicleSystem` must be initialized with `vehicle_system_init` before creating vehicles.
// - The `PhysicsWorld` must be a valid and initialized instance when creating and updating vehicles.
// - `delta_time` should be consistently passed to `vehicle_update` for accurate simulation.
// - Control inputs (`throttle`, `steering`, `brake`) are typically normalized values.
//
#ifndef VEHICLE_SYSTEM_H
#define VEHICLE_SYSTEM_H


#include "../game_common.h"
#include <math/vec3.h>
#include <math/quat.h>
#include "../physics/physics.h"

// Forward declarations
struct Vehicle;

// Vehicle types
typedef enum {
    VEHICLE_TYPE_CAR = 0,
    VEHICLE_TYPE_TRUCK = 1,
    VEHICLE_TYPE_BIKE = 2,
    VEHICLE_TYPE_COUNT = 3
} VehicleType;

// Vehicle system
typedef struct VehicleSystem {
    struct Vehicle *vehicles;
    u32 vehicle_count;
    u32 vehicle_capacity;
} VehicleSystem;

// Initialize vehicle system
void vehicle_system_init(VehicleSystem *system, u32 max_vehicles);

// Create vehicle
struct Vehicle *vehicle_create(VehicleSystem *system, PhysicsWorld *physics, VehicleType type, Vec3 position);

// Update vehicle physics
void vehicle_update(struct Vehicle *vehicle, PhysicsWorld *physics, f32 delta_time);

// Control vehicle
void vehicle_set_throttle(struct Vehicle *vehicle, f32 throttle);
void vehicle_set_steering(struct Vehicle *vehicle, f32 angle);
void vehicle_set_brake(struct Vehicle *vehicle, f32 brake);

// Get vehicle state
Vec3 vehicle_get_position(struct Vehicle *vehicle);
Quat vehicle_get_rotation(struct Vehicle *vehicle);
Vec3 vehicle_get_velocity(struct Vehicle *vehicle);

// Free vehicle
void vehicle_free(VehicleSystem *system, struct Vehicle *vehicle);

// Free vehicle system
void vehicle_system_free(VehicleSystem *system);

#endif // VEHICLE_SYSTEM_H

