// include/ui/floating_text.h
//
// Purpose: Floating damage numbers and status text rendering system
//
#ifndef FLOATING_TEXT_H
#define FLOATING_TEXT_H

#include "../game_common.h"
#include <math/vec3.h>
#include "../render/vulkan.h"

#define MAX_FLOATING_TEXTS 512

typedef enum {
    TEXT_TYPE_DAMAGE,        // Red damage numbers
    TEXT_TYPE_HEAL,          // Green heal numbers
    TEXT_TYPE_CRITICAL,      // Yellow/orange critical numbers
    TEXT_TYPE_MISS,          // Gray miss text
    TEXT_TYPE_STATUS,        // Purple/blue status effect text
    TEXT_TYPE_LOOT,          // Gold loot drop text
    TEXT_TYPE_EXP,           // Blue experience text
    TEXT_TYPE_CUSTOM         // Custom color text
} FloatingTextType;

typedef struct {
    Vec3 position;           // World position
    Vec3 velocity;           // Movement velocity
    char text[64];           // Text to display
    FloatingTextType type;
    Vec4 color;              // Custom color (if type == CUSTOM)

    f32 lifetime;            // Current lifetime
    f32 maxLifetime;         // Maximum lifetime before fade
    f32 alpha;               // Current alpha (0-1)

    f32 scale;               // Text scale
    u32 fontSize;            // Font size in pixels

    bool active;
    bool screenSpace;        // If true, interpret position as screen pixels
} FloatingText;

typedef struct {
    FloatingText texts[MAX_FLOATING_TEXTS];
    u32 activeCount;

    bool initialized;
} FloatingTextSystem;

// Lifecycle
void floating_text_init(FloatingTextSystem* system);
void floating_text_shutdown(FloatingTextSystem* system);

// Emission
u32 floating_text_emit(FloatingTextSystem* system, Vec3 worldPos, const char* text,
                       FloatingTextType type, f32 lifetime);
u32 floating_text_emit_custom(FloatingTextSystem* system, Vec3 worldPos, const char* text,
                              Vec4 color, f32 lifetime);

// Damage numbers (shorthand)
u32 floating_text_damage(FloatingTextSystem* system, Vec3 pos, f32 amount);
u32 floating_text_heal(FloatingTextSystem* system, Vec3 pos, f32 amount);
u32 floating_text_critical(FloatingTextSystem* system, Vec3 pos, f32 amount);
u32 floating_text_miss(FloatingTextSystem* system, Vec3 pos);

// Update and rendering
void floating_text_update(FloatingTextSystem* system, f32 deltaTime);
void floating_text_render(FloatingTextSystem* system, VulkanRenderer* renderer,
                         Mat4 viewProj);

// Utility
u32 floating_text_active_count(FloatingTextSystem* system);

#endif // FLOATING_TEXT_H
