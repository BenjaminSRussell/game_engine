// include/world/water_system.h
//
// Purpose: Defines the water flow simulation and audio system for realistic
// water behavior in the game world. Handles water flow physics, audio playback,
// underwater effects, and splash systems.
//
// Public APIs:
// - water_system_init: Initialize the water flow simulation system
// - water_system_update: Update water physics and audio each frame
// - water_check_flow: Check if water is flowing at a position
// - water_get_flow_direction: Get the direction of water flow
// - water_play_splash: Trigger splash sound and particles
// - water_set_underwater: Set underwater state for audio filtering
//
// Ownership: The water system manages its own state and audio sources.
// Water blocks are owned by the chunk system.
//
// Invariants:
// - Water system must be initialized before use
// - Audio system must be initialized for sound playback
// - Flow calculations respect chunk boundaries
// - Underwater state affects audio filtering globally
//
#ifndef WATER_SYSTEM_H
#define WATER_SYSTEM_H

#include "../chunk/chunk.h"
#include "../game_common.h"
#include <audio/audio_system.h>
#include <math/vec3.h>

#ifdef __cplusplus
extern "C" {
#endif

// Water flow states
typedef enum {
  WATER_FLOW_NONE,
  WATER_FLOW_SOURCE,  // Source block (infinite water)
  WATER_FLOW_FLOWING, // Flowing water
  WATER_FLOW_FALLING  // Waterfall
} WaterFlowState;

// Water flow data for a single position
typedef struct {
  Vec3 position;
  Vec3 flow_direction;
  f32 flow_speed; // 0.0 to 1.0
  WaterFlowState state;
  u8 water_level; // 0-15 (0 = full block, 15 = almost empty)
  bool is_underwater;
} WaterFlowData;

// Water audio configuration
typedef struct {
  f32 flow_volume;            // Volume for flowing water sounds
  f32 splash_volume;          // Volume for splash sounds
  f32 underwater_volume;      // Volume for underwater ambient
  f32 underwater_filter_freq; // Low-pass filter frequency when underwater
  bool enable_3d_audio;       // Use positional audio for water
  f32 max_audio_distance;     // Maximum distance to hear water
} WaterAudioConfig;

// Water system state
typedef struct {
  // Audio sources
  u32 flow_audio_source;
  u32 splash_audio_source;
  u32 underwater_ambient_source;
  u32 bubble_audio_source;

  // Audio configuration
  WaterAudioConfig audio_config;

  // Underwater state
  bool is_player_underwater;
  f32 underwater_depth; // How deep underwater (in blocks)
  f32 breath_remaining; // Breath meter (0.0 to 1.0)

  // Water flow tracking
  u32 active_flow_count;
  WaterFlowData active_flows[256]; // Track nearby flowing water

  // Splash tracking
  f32 splash_cooldown;
  Vec3 last_splash_position;

  bool initialized;
} WaterSystem;

// Lifecycle
void water_system_init(WaterSystem *water, AudioSystem *audio);
void water_system_free(WaterSystem *water);
void water_system_update(WaterSystem *water, ChunkManager *chunks,
                         Vec3 player_pos, f32 delta_time);

// Water flow queries
bool water_check_flow(WaterSystem *water, ChunkManager *chunks, Vec3 position);
Vec3 water_get_flow_direction(WaterSystem *water, ChunkManager *chunks,
                              Vec3 position);
f32 water_get_flow_speed(WaterSystem *water, Vec3 position);
WaterFlowState water_get_flow_state(ChunkManager *chunks, Vec3 position);

// Water interactions
void water_play_splash(WaterSystem *water, Vec3 position, f32 velocity);
void water_play_bubble_sound(WaterSystem *water, Vec3 position);
void water_set_underwater(WaterSystem *water, bool underwater, f32 depth);

// Water audio control
void water_set_audio_config(WaterSystem *water, const WaterAudioConfig *config);
WaterAudioConfig water_get_default_audio_config(void);
void water_update_audio_filtering(WaterSystem *water, AudioSystem *audio);

// Water depth queries
f32 water_get_depth_at_position(ChunkManager *chunks, Vec3 position);
bool water_is_position_underwater(ChunkManager *chunks, Vec3 position);

// Water temperature (for biome integration)
f32 water_get_temperature(ChunkManager *chunks, Vec3 position);
bool water_is_frozen(ChunkManager *chunks, Vec3 position);

#ifdef __cplusplus
}
#endif

#endif // WATER_SYSTEM_H