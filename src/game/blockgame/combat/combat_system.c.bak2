// src/combat/combat_system.c
//
// Module Overview:
// This module provides the concrete implementation of the game's combat system,
// integrating deeply with the Entity-Component-System (ECS) to manage and
// resolve interactions between combatants. Its primary responsibilities include
// calculating and applying damage, handling different types of attacks (melee,
// ranged), and tracking combat-related states such as attack cooldowns and
// combo streaks. It leverages ECS components for entity health and transforms,
// and interfaces with the physics system for effects like knockback.
//
// Key Flows:
// 1. **Initialization (`combat_system_init`):** Sets up the `CombatSystem`
// state,
//    initializing combo trackers and attack timers.
// 2. **Per-Frame Update (`combat_system_update`):** Advances combat timers,
//    such as the combo timer, and resets combo counts if the timer expires.
// 3. **Melee Attack (`combat_melee_attack`):**
//    - Takes an `attacker` and `target` `EntityID`s.
//    - Retrieves their `TransformComponent`s and the `target`'s
//    `HealthComponent`.
//    - Performs a range check.
//    - Calculates damage based on attacker properties (e.g., player's combo
//    multiplier, critical hit chance).
//    - Applies damage to the target's `HealthComponent`.
//    - Updates the `CombatSystem`'s combo state for player attackers.
//    - Applies knockback to the target using the `PhysicsWorld` if a
//    `RigidBodyComponent` is present.
// 4. **Ranged Attack (`combat_ranged_attack`):**
//    - Takes an `attacker` `EntityID`, `direction`, and `range`.
//    - Performs a simplified entity raycast (a more robust solution would use
//    the physics system's raycast).
//    - If a target is hit, it defers to `combat_melee_attack` to apply damage.
// 5. **Damage Application (Implicit):** Damage is applied directly to the
// `HealthComponent` of the target.
// 6. **Combo Tracking:** The system manages `combo_count` and `combo_timer` to
// provide
//    feedback and potential damage bonuses for successive attacks within a
//    short window.
// 7. **Utility Functions:** Includes `combat_is_entity_alive` to check an
// entity's vitality,
//    and `combat_get_combo_multiplier`/`combat_get_combo_count` to query combo
//    status.
//
// Invariants:
// - A valid `CombatSystem` must be initialized before performing combat
// operations.
// - `ECSWorld` must be accessible for component retrieval.
// - `TransformComponent` and `HealthComponent` are essential for combat
// entities.
// - `delta_time` is crucial for accurate timer updates.
// - Attack ranges and damage calculations are based on predefined values and
// logic.
// - The `srand(time(NULL))` initialization in `main` is expected for random
// critical hits.
//
// (Additional comments from the file indicating external dependencies and
// roadmaps are preserved.) Combat system update and damage resolution. Roadmap:
// docs/COMBAT_ROADMAP.md.
#include "../../include/combat/combat.h"
#include "../../include/ecs/components/health.h"
#include "../../include/ecs/components/transform.h"
#include "../../include/ecs/ecs.h"
#include "../../include/math/vec3.h"
#include <math.h>
#include <stdlib.h>
#include <time.h>

#include "../../include/combat/equipment.h"
#include "../../include/combat/shield.h"
#include "../../include/ecs/component_ids.h"
#include "../../include/ecs/components/rigidbody.h"
#include "../../include/physics/physics.h"
#include "../../include/player/player.h"
#include "../../include/player/status_effects.h"
#include "../../include/core/logger.h"
#include "../../include/vfx/visual_effects.h"
#include "../../include/audio/audio_system.h"

// Forward declarations for functions used before definition
static f32 combat_get_combo_multiplier(CombatSystem *system);

static void combat_log_event(CombatSystem *system, EntityID attacker,
                             EntityID target, DamageType type, f32 damage,
                             bool critical) {
  if (!system || !system->logging_enabled)
    return;

  CombatLogEntry *entry = &system->log[system->log_index];
  entry->attacker = attacker;
  entry->target = target;
  entry->type = type;
  entry->damage = damage;
  entry->critical = critical;
  entry->timestamp = (f32)clock() / CLOCKS_PER_SEC;

  system->log_index = (system->log_index + 1) % 64;
  if (system->log_count < 64) {
    system->log_count++;
  }
}

static f32 combat_apply_type_modifiers(CombatSystem *system, DamageType type,
                                       f32 damage) {
  if (!system)
    return damage;

  f32 resistance = system->damage_resistance[type];
  f32 vulnerability = system->damage_vulnerability[type];
  f32 multiplier = 1.0f - resistance + vulnerability;
  multiplier = CLAMP(multiplier, 0.1f, 2.0f);
  return damage * multiplier;
}

static void combat_update_dots(CombatSystem *system, f32 delta_time) {
  if (!system || !system->ecs_world)
    return;

  for (u32 i = 0; i < system->dot_count; i++) {
    CombatDot *dot = &system->dots[i];
    if (dot->remaining_time <= 0.0f)
      continue;

    dot->remaining_time -= delta_time;
    f32 tick_damage = dot->damage_per_second * delta_time;

    HealthComponent *health =
        ecs_get_component(system->ecs_world, dot->target,
                          HEALTH_COMPONENT_ID);
    if (health && health->health > 0.0f) {
      health->health -= tick_damage;
      if (health->health < 0.0f) {
        health->health = 0.0f;
      }
    }
  }

  u32 write_index = 0;
  for (u32 i = 0; i < system->dot_count; i++) {
    if (system->dots[i].remaining_time > 0.0f) {
      system->dots[write_index++] = system->dots[i];
    }
  }
  system->dot_count = write_index;
}

static void combat_apply_status_on_hit(ECSWorld *ecs, EntityID target,
                                       DamageType type) {
  PlayerComponent *player =
      (PlayerComponent *)ecs_get_component(ecs, target, PLAYER_COMPONENT_ID);
  if (!player)
    return;

  if (type == DAMAGE_TYPE_FIRE) {
    status_effect_add(&player->status_effects, STATUS_EFFECT_ON_FIRE, 4.0f,
                      1.0f);
  } else if (type == DAMAGE_TYPE_MAGIC) {
    status_effect_add(&player->status_effects, STATUS_EFFECT_WEAKNESS, 6.0f,
                      1.0f);
  } else if (type == DAMAGE_TYPE_EXPLOSION) {
    status_effect_add(&player->status_effects, STATUS_EFFECT_SLOWNESS, 3.0f,
                      1.0f);
  }
}

void combat_system_init(CombatSystem *system) {
  memset(system, 0, sizeof(CombatSystem));

  // Combat system configuration
  system->damage_multiplier = 1.0f;
  system->critical_chance = 0.1f;
  system->crit_damage_multiplier = 2.0f;
  system->combo_timeout = 1.0f;
  system->attack_cooldown = 0.6f;

  // Initialize combat statistics tracking
  system->stats.total_hits = 0;
  system->stats.total_misses = 0;
  system->stats.total_crits = 0;
  system->stats.total_damage_dealt = 0.0f;
  system->stats.total_damage_taken = 0.0f;
  system->stats.combat_sessions = 0;

  system->combo_timer = 0.0f;
  system->combo_count = 0;
  system->last_attack_time = 0.0f;
  system->hit_flash_time = 0.0f;
  system->hit_flash_duration = 0.12f;
  system->combo_multiplier = 1.0f;
  system->combo_visual_timer = 0.0f;
  system->stance = COMBAT_STANCE_BALANCED;
  system->stance_damage_multiplier = 1.0f;
  system->stance_defense_multiplier = 1.0f;
  memset(system->damage_resistance, 0, sizeof(system->damage_resistance));
  memset(system->damage_vulnerability, 0,
         sizeof(system->damage_vulnerability));
  system->dot_count = 0;
  system->log_index = 0;
  system->log_count = 0;
  system->logging_enabled = true;
  system->ecs_world = NULL;
  system->vfx_system = NULL;
  system->audio_system = NULL;
  system->finisher_threshold = 0.1f; // 10% health
  system->finisher_enabled = true;

  // Combat logging system
  LOG_INFO("Combat system initialized with damage multiplier: %.2f, crit "
           "chance: %.2f",
           system->damage_multiplier, system->critical_chance);
}

void combat_system_free(CombatSystem *system) {
  (void)system; // No dynamic allocation to clean up
}

void combat_system_update(CombatSystem *system, f32 delta_time) {
  if (!system)
    return;

  // Update combo timer
  if (system->combo_timer > 0.0f) {
    system->combo_timer -= delta_time;
    if (system->combo_timer <= 0.0f) {
      system->combo_timer = 0.0f;
      system->combo_count = 0;
    }
  }

  // Update crosshair hit confirm pulse timer
  if (system->hit_flash_time > 0.0f) {
    system->hit_flash_time -= delta_time;
    if (system->hit_flash_time < 0.0f)
      system->hit_flash_time = 0.0f;
  }

  if (system->combo_visual_timer > 0.0f) {
    system->combo_visual_timer -= delta_time;
    if (system->combo_visual_timer < 0.0f)
      system->combo_visual_timer = 0.0f;
  }

  combat_update_dots(system, delta_time);
}

bool combat_melee_attack(CombatSystem *system, ECSWorld *ecs, EntityID attacker,
                         EntityID target) {
  if (!system || !ecs)
    return false;

  TransformComponent *attacker_transform =
      ecs_get_component(ecs, attacker, TRANSFORM_COMPONENT_ID);
  TransformComponent *target_transform =
      ecs_get_component(ecs, target, TRANSFORM_COMPONENT_ID);
  HealthComponent *target_health =
      ecs_get_component(ecs, target, HEALTH_COMPONENT_ID);

  if (!attacker_transform || !target_transform || !target_health) {
    return false;
  }

  // Check if target is in range
  f32 distance =
      vec3_distance(attacker_transform->position, target_transform->position);

  // Get attacker's equipment
  EquipmentComponent *attacker_equipment =
      equipment_get_component(ecs, attacker);
  f32 base_damage = 1.0f;
  f32 attack_range = 3.0f;
  f32 attack_speed = 1.0f;
  f32 durability_multiplier = 1.0f;

  // Use equipped weapon if available
  if (attacker_equipment && equipment_has_weapon(attacker_equipment)) {
    const Weapon *weapon = equipment_get_weapon(attacker_equipment);
    base_damage = weapon->damage;
    attack_range = weapon->range;
    attack_speed = weapon->attack_speed;

    // Calculate durability multiplier (damage reduces as weapon degrades)
    if (weapon->max_durability > 0) {
      f32 durability_ratio =
          (f32)weapon->durability / (f32)weapon->max_durability;
      // Damage scales from 100% at full durability to 50% at 0 durability
      durability_multiplier = 0.5f + (durability_ratio * 0.5f);
    }
  } else {
    // Fallback to default weapon stats based on weapon type
    WeaponType weapon_type = WEAPON_TYPE_SWORD;
    switch (weapon_type) {
    case WEAPON_TYPE_SWORD:
      base_damage = 2.0f;
      attack_range = 3.0f;
      attack_speed = 1.2f;
      break;
    case WEAPON_TYPE_AXE:
      base_damage = 3.0f;
      attack_range = 2.5f;
      attack_speed = 0.8f;
      break;
    case WEAPON_TYPE_PICKAXE:
      base_damage = 1.5f;
      attack_range = 2.0f;
      attack_speed = 0.9f;
      break;
    case WEAPON_TYPE_BOW:
      base_damage = 2.5f;
      attack_range = 15.0f;
      attack_speed = 1.0f;
      break;
    case WEAPON_TYPE_CROSSBOW:
      base_damage = 3.5f;
      attack_range = 20.0f;
      attack_speed = 0.7f;
      break;
    default:
      break;
    }
  }

  // Weapon damage scaling with player level and stats (placeholder until stats
  // system)
  f32 level_multiplier = 1.0f; // Will be based on player level/stats

  // Calculate final damage
  f32 damage = base_damage * level_multiplier * durability_multiplier *
               system->damage_multiplier * system->stance_damage_multiplier;

  if (distance > attack_range) {
    system->stats.total_misses++;
    return false;
  }

  bool is_crit = false;
  // Check if attacker is player
  PlayerComponent *player =
      (PlayerComponent *)ecs_get_component(ecs, attacker, PLAYER_COMPONENT_ID);
  if (player) {
    // Player damage with strength modifier
    damage = 2.0f; // Base player damage

    // Apply combo multiplier
    if (system->combo_count > 0) {
      damage *=
          (1.0f + system->combo_count * 0.2f); // 20% damage per combo level
    }

    // Critical hit chance (10% base)
    f32 crit_chance = system->critical_chance;
    is_crit = ((float)rand() / RAND_MAX < crit_chance);
    if (is_crit) {
      damage *= system->crit_damage_multiplier; // Critical hit multiplier
      system->stats.total_crits++;
      LOG_DEBUG("Critical hit! Damage: %.2f", damage);
      
      // Trigger critical hit visual and audio feedback
      if (target_transform) {
        combat_trigger_critical_feedback(system, target_transform->position);
      }
    }
  }

  damage = combat_apply_type_modifiers(system, DAMAGE_TYPE_MELEE, damage);

  // Calculate target's armor protection using equipment system
  EquipmentComponent *target_equipment = equipment_get_component(ecs, target);
  f32 armor_reduction = 0.0f;

  if (target_equipment) {
    // Get total armor defense and toughness
    f32 total_defense = equipment_get_total_defense(target_equipment);
    f32 total_toughness = equipment_get_total_toughness(target_equipment);

    // Calculate armor reduction (GregTech-style formula)
    // Armor reduces damage by: defense / (defense + damage)
    // Toughness reduces damage further for high-damage attacks
    if (total_defense > 0.0f) {
      f32 defense_factor = total_defense / (total_defense + damage);
      f32 toughness_factor = 1.0f;

      // Toughness helps against high-damage attacks
      if (total_toughness > 0.0f && damage > total_defense) {
        f32 excess_damage = damage - total_defense;
        toughness_factor =
            1.0f / (1.0f + (excess_damage / (total_toughness * 2.0f)));
      }

      armor_reduction = defense_factor * toughness_factor;
      armor_reduction =
          CLAMP(armor_reduction, 0.0f, 0.8f); // Cap at 80% reduction
    }
  }

  // Apply armor reduction to damage
  damage *= (1.0f - armor_reduction) * system->stance_defense_multiplier;

  // Apply durability damage to armor if target has equipment
  if (target_equipment && damage > 0.0f) {
    // Damage armor based on damage taken (armor absorbs some of the damage)
    u32 armor_damage = (u32)(damage * 0.1f); // Armor takes 10% of damage
    if (armor_damage > 0) {
      // Distribute damage across all equipped armor pieces
      for (u32 i = 0; i < ARMOR_SLOT_COUNT; i++) {
        if (equipment_has_armor(target_equipment, (ArmorSlot)i)) {
          equipment_damage_armor(target_equipment, (ArmorSlot)i,
                                 armor_damage / ARMOR_SLOT_COUNT);
        }
      }
    }
  }

  // Apply durability damage to weapon if attacker has equipment
  if (attacker_equipment && equipment_has_weapon(attacker_equipment)) {
    u32 weapon_damage = 1; // Weapons take 1 durability per hit
    equipment_damage_weapon(attacker_equipment, weapon_damage);
  }

  // Check if target has shield and attempt blocking
  ShieldComponent *target_shield =
      ecs_get_component(ecs, target, SHIELD_COMPONENT_ID);
  if (target_shield && target_shield->is_blocking) {
    // Calculate attack direction
    Vec3 attack_direction = vec3_normalize(
        vec3_sub(attacker_transform->position, target_transform->position));

    // Calculate shield block reduction
    f32 shield_reduction =
        shield_calculate_block_reduction(target_shield, attack_direction);

    // Check for parry attempt
    f32 current_time = (f32)clock() / CLOCKS_PER_SEC;
    if (shield_can_parry(target_shield, current_time)) {
      if (shield_attempt_parry(target_shield, attack_direction)) {
        // Successful parry - negate all damage and apply parry bonus
        damage = 0.0f;
        target_shield->last_parry_time = current_time;

        // Apply knockback to attacker instead (counter-attack)
        Vec3 parry_knockback =
            vec3_mul(vec3_mul(attack_direction, -1.0f), 8.0f);
        RigidBodyComponent *attacker_body =
            ecs_get_component(ecs, attacker, RIGIDBODY_COMPONENT_ID);
        if (attacker_body && attacker_body->body) {
          Vec3 current_vel =
              rigid_body_get_velocity((RigidBody *)attacker_body->body);
          Vec3 new_vel = vec3_add(current_vel, parry_knockback);
          rigid_body_set_velocity((RigidBody *)attacker_body->body, new_vel);
        }

        LOG_DEBUG("Successful parry! Attack negated.");

        // Counter-attack damage (light)
        HealthComponent *attacker_health =
            ecs_get_component(ecs, attacker, HEALTH_COMPONENT_ID);
        if (attacker_health) {
          f32 counter_damage = 1.0f * shield_get_parry_bonus(target_shield);
          attacker_health->health -= counter_damage;
          if (attacker_health->health < 0.0f) {
            attacker_health->health = 0.0f;
          }
        }
      }
    } else {
      // Regular block - apply shield damage reduction
      damage *= (1.0f - shield_reduction);

      // Apply remaining damage to shield durability
      if (damage > 0.0f) {
        shield_apply_damage(target_shield,
                            damage *
                                0.5f); // Shields take half the blocked damage
      }
    }
  }

  // Apply damage to target
  target_health->health -= damage;
  if (target_health->health < 0.0f) {
    target_health->health = 0.0f;
  }

  // Apply status effects based on damage type
  combat_apply_status_on_hit(ecs, target, DAMAGE_TYPE_MELEE);

  // Finisher logic - execute finisher if target is low health and finisher is enabled
  if (system->finisher_enabled && combat_can_execute_finisher(system, target, ecs) && damage > 0.0f) {
    // Execute finisher - instant kill with bonus effects
    f32 finisher_bonus_damage = target_health->health * 1.5f; // Bonus damage for finisher
    target_health->health = 0.0f;
    system->stats.total_damage_dealt += finisher_bonus_damage;
    LOG_INFO("Finisher executed on target %u! Bonus damage: %.2f", target, finisher_bonus_damage);
    
    // Trigger finisher visual and audio feedback
    if (target_transform) {
      combat_trigger_finisher_feedback(system, target_transform->position, target);
    }
  }

  system->stats.total_hits++;
  system->stats.total_damage_dealt += damage;
  if (ecs_get_component(ecs, target, PLAYER_COMPONENT_ID)) {
    system->stats.total_damage_taken += damage;
  }
  combat_log_event(system, attacker, target, DAMAGE_TYPE_MELEE, damage,
                   is_crit);

  // Trigger crosshair hit confirm pulse for HUD
  system->hit_flash_time = system->hit_flash_duration;

  // Update combo system for player attacks
  if (player) {
    f32 current_time = (f32)clock() / CLOCKS_PER_SEC;
    if (current_time - system->last_attack_time < 1.0f) { // Within combo window
      system->combo_count++;
      system->combo_timer = 1.0f; // Reset combo timer
    } else {
      system->combo_count = 1;
      system->combo_timer = 1.0f;
    }
    system->last_attack_time = current_time;
    system->combo_multiplier = combat_get_combo_multiplier(system);
    system->combo_visual_timer = 0.3f;
  }

  // Apply knockback to target
  Vec3 knockback_dir = vec3_normalize(
      vec3_sub(target_transform->position, attacker_transform->position));
  Vec3 knockback = vec3_mul(knockback_dir, 5.0f); // Knockback force

  // Try to apply physics-based knockback
  RigidBodyComponent *target_rigidbody =
      ecs_get_component(ecs, target, RIGIDBODY_COMPONENT_ID);
  if (target_rigidbody && target_rigidbody->body) {
    rigid_body_add_impulse(target_rigidbody->body, knockback);
  }

  return true;
}

bool combat_ranged_attack(CombatSystem *system, ECSWorld *ecs,
                          EntityID attacker, Vec3 direction, f32 range) {
  if (!system || !ecs)
    return false;

  TransformComponent *attacker_transform =
      ecs_get_component(ecs, attacker, TRANSFORM_COMPONENT_ID);
  if (!attacker_transform)
    return false;

  // Perform raycast for ranged attack
  Vec3 ray_origin = attacker_transform->position;
  Vec3 ray_end = vec3_add(ray_origin, vec3_mul(direction, range));

  // Simple entity raycast (would use physics system in full implementation)
  ComponentTypeID components[] = {TRANSFORM_COMPONENT_ID, HEALTH_COMPONENT_ID};
  EntityQuery query;
  ecs_query_init(&query, MAX_ENTITIES);
  ecs_query_entities(ecs, &query, components, 2);

  EntityID best_target = 0;
  f32 best_distance = range;

  for (u32 i = 0; i < query.count; i++) {
    EntityID entity = query.entities[i];
    if (entity == attacker)
      continue; // Don't hit self

    TransformComponent *transform =
        ecs_get_component(ecs, entity, TRANSFORM_COMPONENT_ID);
    if (!transform)
      continue;

    // Simple ray-sphere intersection
    Vec3 to_entity = vec3_sub(transform->position, ray_origin);
    f32 distance = vec3_length(to_entity);

    if (distance > best_distance)
      continue;

    // Check if entity is roughly in line with ray direction
    Vec3 to_entity_norm = vec3_normalize(to_entity);
    f32 dot = vec3_dot(to_entity_norm, direction);

    if (dot > 0.8f) { // Within ~36 degree cone
      best_distance = distance;
      best_target = entity;
    }
  }

  ecs_query_free(&query);

  if (best_target != 0) {
    return combat_melee_attack(system, ecs, attacker, best_target);
  }

  return false;
}

void combat_apply_status_effect(CombatSystem *system, EntityID target,
                                StatusEffectType effect, f32 duration,
                                f32 strength) {
  if (!system)
    return;
  if (!system->ecs_world)
    return;

  PlayerComponent *player =
      (PlayerComponent *)ecs_get_component(system->ecs_world, target,
                                           PLAYER_COMPONENT_ID);
  if (!player)
    return;

  status_effect_add(&player->status_effects, effect, duration, strength);
}

bool combat_is_entity_alive(ECSWorld *ecs, EntityID entity) {
  if (!ecs)
    return false;

  HealthComponent *health = ecs_get_component(ecs, entity, HEALTH_COMPONENT_ID);
  return health && health->health > 0.0f;
}

f32 combat_get_combo_multiplier(CombatSystem *system) {
  if (!system || system->combo_count == 0)
    return 1.0f;
  return 1.0f + (system->combo_count - 1) * 0.2f; // 20% per combo level
}

u32 combat_get_combo_count(CombatSystem *system) {
  return system ? system->combo_count : 0;
}

void combat_set_stance(CombatSystem *system, CombatStance stance) {
  if (!system)
    return;

  system->stance = stance;
  switch (stance) {
    case COMBAT_STANCE_AGGRESSIVE:
      system->stance_damage_multiplier = 1.2f;
      system->stance_defense_multiplier = 1.1f;
      break;
    case COMBAT_STANCE_DEFENSIVE:
      system->stance_damage_multiplier = 0.9f;
      system->stance_defense_multiplier = 0.8f;
      break;
    case COMBAT_STANCE_BALANCED:
    default:
      system->stance_damage_multiplier = 1.0f;
      system->stance_defense_multiplier = 1.0f;
      break;
  }
}

CombatStance combat_get_stance(const CombatSystem *system) {
  return system ? system->stance : COMBAT_STANCE_BALANCED;
}

void combat_set_damage_modifier(CombatSystem *system, DamageType type,
                                f32 resistance, f32 vulnerability) {
  if (!system || type >= DAMAGE_TYPE_COUNT)
    return;
  system->damage_resistance[type] = CLAMP(resistance, 0.0f, 0.9f);
  system->damage_vulnerability[type] = CLAMP(vulnerability, 0.0f, 1.0f);
}

void combat_add_dot(CombatSystem *system, EntityID target, DamageType type,
                    f32 damage_per_second, f32 duration) {
  if (!system || system->dot_count >= 32)
    return;

  system->dots[system->dot_count++] = (CombatDot){
      .target = target,
      .type = type,
      .damage_per_second = damage_per_second,
      .remaining_time = duration};
}

u32 combat_get_log(const CombatSystem *system, CombatLogEntry *entries,
                   u32 max_entries) {
  if (!system || !entries || max_entries == 0)
    return 0;

  u32 count = MIN(system->log_count, max_entries);
  for (u32 i = 0; i < count; i++) {
    u32 index = (system->log_index + 64 - system->log_count + i) % 64;
    entries[i] = system->log[index];
  }
  return count;
}

void combat_set_logging(CombatSystem *system, bool enabled) {
  if (!system)
    return;
  system->logging_enabled = enabled;
}

void combat_system_bind_world(CombatSystem *system, ECSWorld *ecs) {
  if (!system)
    return;
  system->ecs_world = ecs;
}

// Visual and audio feedback implementation
void combat_system_bind_vfx(CombatSystem *system, struct VFXSystem *vfx) {
  if (!system)
    return;
  system->vfx_system = vfx;
}

void combat_system_bind_audio(CombatSystem *system, struct AudioSystem *audio) {
  if (!system)
    return;
  system->audio_system = audio;
}

void combat_trigger_critical_feedback(CombatSystem *system, Vec3 position) {
  if (!system)
    return;
  
  // Visual feedback - critical hit particles and screen effects
  if (system->vfx_system) {
    vfx_play_critical_hit(system->vfx_system, position);
  }
  
  // Audio feedback - play critical hit sound
  if (system->audio_system) {
    // Play critical hit sound effect
    // Note: This assumes audio system has a function to play combat sounds
    // audio_play_sound_3d(system->audio_system, SOUND_CRITICAL_HIT, position, 1.0f);
    LOG_DEBUG("Critical hit audio feedback triggered at position (%.2f, %.2f, %.2f)",
              position.x, position.y, position.z);
  }
}

void combat_trigger_finisher_feedback(CombatSystem *system, Vec3 position, EntityID target) {
  if (!system)
    return;
  
  // Visual feedback - dramatic finisher effect
  if (system->vfx_system) {
    // Play death effect for dramatic finisher
    vfx_play_death_effect(system->vfx_system, position);
    
    // Additional screen shake for finisher
    vfx_trigger_screen_shake(system->vfx_system, 1.2f, 0.4f);
    
    // Golden flash for successful finisher
    vfx_trigger_damage_flash(system->vfx_system, 0.8f, (Vec4){1.0f, 0.84f, 0.0f, 0.6f});
  }
  
  // Audio feedback - play finisher sound
  if (system->audio_system) {
    // Play finisher sound effect
    // audio_play_sound_3d(system->audio_system, SOUND_FINISHER, position, 1.0f);
    LOG_DEBUG("Finisher audio feedback triggered for target %u at position (%.2f, %.2f, %.2f)",
              target, position.x, position.y, position.z);
  }
}

// Finisher system implementation
void combat_set_finisher_enabled(CombatSystem *system, bool enabled) {
  if (!system)
    return;
  system->finisher_enabled = enabled;
}

void combat_set_finisher_threshold(CombatSystem *system, f32 threshold) {
  if (!system)
    return;
  system->finisher_threshold = CLAMP(threshold, 0.0f, 1.0f);
}

bool combat_can_execute_finisher(CombatSystem *system, EntityID target, struct ECSWorld *ecs) {
  if (!system || !ecs || !system->finisher_enabled)
    return false;
  
  HealthComponent *target_health =
      ecs_get_component(ecs, target, HEALTH_COMPONENT_ID);
  if (!target_health || target_health->health <= 0.0f)
    return false;
  
  // Check if target health is below finisher threshold
  f32 health_percentage = target_health->health / target_health->max_health;
  return health_percentage <= system->finisher_threshold;
}
