// Damage type names
static const char* DAMAGE_TYPE_NAMES[DAMAGE_TYPE_COUNT] = {
    "Physical", "Fire", "Magic", "Poison", "Fall", "Drowning",
    "Explosion", "Lightning", "Cold", "Thorns", "Starvation",
    "Suffocation", "Lava"
};

// Armor type names
static const char* ARMOR_TYPE_NAMES[ARMOR_TYPE_COUNT] = {
    "None", "Leather", "Chain", "Iron", "Gold", "Diamond", "Netherite"
};

bool damage_system_init(DamageSystem* system, ECSWorld* ecs_world) {
    if (!system || !ecs_world) return false;
    
    memset(system, 0, sizeof(DamageSystem));
    system->ecs_world = ecs_world;
    
    // Initialize damage statistics
    system->player_stats = (DamageStats*)core_alloc(sizeof(DamageStats));
    if (!system->player_stats) return false;
    damage_stats_reset(system->player_stats);
    
    // Initialize damage numbers array
    system->max_damage_numbers = 64;
    system->damage_numbers = (DamageNumber*)core_alloc(system->max_damage_numbers * sizeof(DamageNumber));
    if (!system->damage_numbers) {
        core_free(system->player_stats);
        return false;
    }
    memset(system->damage_numbers, 0, system->max_damage_numbers * sizeof(DamageNumber));
    
    // Set default options
    system->enable_visualization = true;
    system->enable_logging = true;
    system->enable_sound_effects = true;
    system->enable_particle_effects = true;
    
    LOG_INFO("Damage system initialized");
    return true;
}

void damage_system_cleanup(DamageSystem* system) {
    if (!system) return;
    
    if (system->player_stats) {
        core_free(system->player_stats);
        system->player_stats = NULL;
    }
    
    if (system->damage_numbers) {
        core_free(system->damage_numbers);
        system->damage_numbers = NULL;
    }
    
    memset(system, 0, sizeof(DamageSystem));
    LOG_INFO("Damage system cleaned up");
}

void damage_system_update(DamageSystem* system, float delta_time) {
    if (!system) return;
    
    // Update damage over time effects
    damage_dot_update_effects(system, delta_time);
    
    // Update damage immunity
    damage_immunity_update(system, delta_time);
    
    // Update damage visualization
    if (system->enable_visualization) {
        damage_visualization_update(system, delta_time);
    }
}

float damage_apply_to_entity(DamageSystem* system, EntityID target, const DamageInstance* damage) {
    if (!system || !damage || damage_is_zero(damage)) return 0.0f;
    
    // Check if target exists and has health
    HealthComponent* health = (HealthComponent*)ecs_get_component(system->ecs_world, target, HEALTH_COMPONENT_ID);
    if (!health) return 0.0f;
    
    // Check if entity is immune to this damage type
    if (damage_immunity_is_immune(system, target, damage->type) && !damage->bypass_invulnerability) {
        return 0.0f;
    }
    
    // Get target's armor if available
    ArmorSet armor = {0};
    // TODO: Get armor from entity's inventory/equipment components
    
    float final_damage = damage_apply_with_armor(system, target, damage, &armor);
    
    // Apply damage to health
    float old_health = health->health;
    health->health -= final_damage;
    if (health->health < 0.0f) health->health = 0.0f;
    
    float actual_damage = old_health - health->health;
    
    // Record statistics
    if (system->player_stats) {
        damage_stats_record_damage_taken(system->player_stats, damage->type, actual_damage);
    }
    
    // Show damage visualization
    if (system->enable_visualization && actual_damage > 0.0f) {
        TransformComponent* transform = (TransformComponent*)ecs_get_component(system->ecs_world, target, TRANSFORM_COMPONENT_ID);
        if (transform) {
            damage_visualization_show_number(system, transform->position, actual_damage, damage->type, damage->is_critical);
        }
    }
    
    // Play damage sound
    if (system->enable_sound_effects && actual_damage > 0.0f) {
        // TODO: Play appropriate damage sound based on damage type
    }
    
    // Log damage if enabled
    if (system->enable_logging && actual_damage > 0.0f) {
        LOG_DEBUG("Entity %d took %.2f %s damage", target, actual_damage, damage_type_get_name(damage->type));
    }
    
    return actual_damage;
}

float damage_apply_with_armor(DamageSystem* system, EntityID target, const DamageInstance* damage, const ArmorSet* armor) {
    if (!system || !damage) return 0.0f;
    
    float final_damage = damage->amount;
    
    // Apply status effect modifiers
    final_damage = damage_apply_status_effect_modifiers(final_damage, target);
    
    // Apply armor protection if not bypassed
    if (armor && !damage->bypass_armor) {
        float armor_protection = armor_calculate_protection(armor, damage->type);
        float toughness_reduction = armor_calculate_toughness_reduction(armor, final_damage);
        
        // Calculate damage reduction
        float damage_reduction = damage_calculate_reduction(final_damage, armor_protection, toughness_reduction);
        final_damage -= damage_reduction;
        
        // Apply enchantment protection
        float enchantment_reduction = damage_calculate_enchantment_reduction(final_damage, armor, damage->type);
        final_damage -= enchantment_reduction;
        
        // Apply armor durability damage
        if (final_damage > 0.0f) {
            // Note: This would modify the armor, but we're working with a copy
            // armor_apply_durability_damage((ArmorSet*)armor, damage->type, final_damage);
        }
    }
    
    // Apply critical hit multiplier
    if (damage->is_critical) {
        final_damage = damage_calculate_critical_hit_damage(final_damage);
    }
    
    // Ensure damage is not negative
    final_damage = fmaxf(0.0f, final_damage);
    
    return final_damage;
}

bool damage_can_damage_entity(DamageSystem* system, EntityID target, const DamageInstance* damage) {
    if (!system || !damage) return false;
    
    // Check if entity has health component
    HealthComponent* health = (HealthComponent*)ecs_get_component(system->ecs_world, target, HEALTH_COMPONENT_ID);
    if (!health || health->health <= 0.0f) return false;
    
    // Check immunity
    if (damage_immunity_is_immune(system, target, damage->type) && !damage->bypass_invulnerability) {
        return false;
    }
    
    return true;
}

// Damage Instance Creation Functions
DamageInstance damage_create(DamageType type, float amount, EntityID source) {
    DamageInstance damage = {0};
    damage.type = type;
    damage.amount = amount;
    damage.source_entity = source;
    damage.source_type = source != 0 ? DAMAGE_SOURCE_ENTITY : DAMAGE_SOURCE_UNKNOWN;
    damage.position = vec3_zero();
    damage.direction = vec3_zero();
    damage.is_critical = false;
    damage.armor_penetration = 0.0f;
    damage.bypass_armor = false;
    damage.bypass_invulnerability = false;
    return damage;
}

DamageInstance damage_create_positional(DamageType type, float amount, EntityID source, Vec3 position, Vec3 direction) {
    DamageInstance damage = damage_create(type, amount, source);
    damage.position = position;
    damage.direction = vec3_normalize(direction);
    return damage;
}

DamageInstance damage_create_critical(DamageType type, float amount, EntityID source) {
    DamageInstance damage = damage_create(type, amount, source);
    damage.is_critical = true;
    return damage;
}

DamageInstance damage_create_armor_penetrating(DamageType type, float amount, EntityID source, float penetration) {
    DamageInstance damage = damage_create(type, amount, source);
    damage.armor_penetration = penetration;
    damage.bypass_armor = penetration >= 1.0f;
    return damage;
}

// Armor System Functions
void armor_set_init(ArmorSet* armor) {
    if (!armor) return;
    memset(armor, 0, sizeof(ArmorSet));
}

void armor_set_add_piece(ArmorSet* armor, const ArmorPiece* piece) {
    if (!armor || !piece || piece->slot >= ARMOR_SLOT_COUNT) return;
    
    armor->pieces[piece->slot] = *piece;
    
    // Recalculate total protection
    for (int i = 0; i < DAMAGE_TYPE_COUNT; i++) {
        armor->total_protection[i] = 0.0f;
    }
    
    armor->toughness = 0.0f;
    armor->enchantment_protection = 0.0f;
    
    for (int slot = 0; slot < ARMOR_SLOT_COUNT; slot++) {
        ArmorPiece* p = &armor->pieces[slot];
        if (p->type != ARMOR_TYPE_NONE && !armor_is_piece_broken(p)) {
            for (int i = 0; i < DAMAGE_TYPE_COUNT; i++) {
                armor->total_protection[i] += p->protection_values[i];
            }
            armor->toughness += armor_type_get_toughness(p->type);
            // TODO: Add enchantment protection calculation
        }
    }
}

void armor_set_remove_piece(ArmorSet* armor, ArmorSlot slot) {
    if (!armor || slot >= ARMOR_SLOT_COUNT) return;
    
    memset(&armor->pieces[slot], 0, sizeof(ArmorPiece));
    armor->pieces[slot].type = ARMOR_TYPE_NONE;
    
    // Recalculate totals
    armor_set_add_piece(armor, &armor->pieces[slot]); // This will recalculate
}

float armor_calculate_protection(const ArmorSet* armor, DamageType type) {
    if (!armor || type >= DAMAGE_TYPE_COUNT) return 0.0f;
    return armor->total_protection[type];
}

float armor_calculate_toughness_reduction(const ArmorSet* armor, float damage) {
    if (!armor || damage <= 0.0f) return 0.0f;
    
    // Toughness reduces damage by a percentage based on damage amount
    // Formula: reduction = min(damage * 0.08, toughness * 0.2)
    float max_reduction = armor->toughness * 0.2f;
    float damage_based_reduction = damage * 0.08f;
    return fminf(damage_based_reduction, max_reduction);
}

void armor_apply_durability_damage(ArmorSet* armor, DamageType type, float damage) {
    if (!armor || type >= DAMAGE_TYPE_COUNT || damage <= 0.0f) return;
    
    // Each armor piece takes durability damage based on damage type
    for (int slot = 0; slot < ARMOR_SLOT_COUNT; slot++) {
        ArmorPiece* piece = &armor->pieces[slot];
        if (piece->type != ARMOR_TYPE_NONE && !armor_is_piece_broken(piece)) {
            // Durability damage varies by damage type and armor slot
            float durability_damage = damage * 0.1f; // Base durability loss
            
            // Certain damage types affect armor differently
            switch (type) {
                case DAMAGE_TYPE_EXPLOSION:
                    durability_damage *= 2.0f; // Explosions damage armor more
                    break;
                case DAMAGE_TYPE_FIRE:
                case DAMAGE_TYPE_LAVA:
                    if (piece->type == ARMOR_TYPE_LEATHER) {
                        durability_damage *= 1.5f; // Leather is vulnerable to fire
                    }
                    break;
                case DAMAGE_TYPE_FALL:
                case DAMAGE_TYPE_DROWNING:
                case DAMAGE_TYPE_STARVATION:
                    durability_damage = 0.0f; // Environmental damage doesn't affect armor
                    break;
                default:
                    break;
            }
            
            piece->durability -= durability_damage;
            if (piece->durability < 0.0f) piece->durability = 0.0f;
        }
    }
}

bool armor_is_piece_broken(const ArmorPiece* piece) {
    return !piece || piece->durability <= 0.0f;
}

// Damage Over Time System
typedef struct {
    EntityID entity;
    DOTEffect effect;
} EntityDOT;

static EntityDOT* g_active_dots = NULL;
static uint32_t g_active_dot_count = 0;
static uint32_t g_active_dot_capacity = 0;

void damage_dot_add_effect(DamageSystem* system, EntityID entity, const DOTEffect* dot) {
    if (!system || !dot) return;
    
    // Check if entity already has this DOT type
    for (uint32_t i = 0; i < g_active_dot_count; i++) {
        if (g_active_dots[i].entity == entity && g_active_dots[i].effect.type == dot->type) {
            if (dot->stacks) {
                // Stack the effect
                g_active_dots[i].effect.stack_count++;
                g_active_dots[i].effect.damage_per_second += dot->damage_per_second;
            } else {
                // Refresh the effect
                g_active_dots[i].effect = *dot;
            }
            return;
        }
    }
    
    // Add new DOT effect
    if (g_active_dot_count >= g_active_dot_capacity) {
        uint32_t new_capacity = g_active_dot_capacity == 0 ? 16 : g_active_dot_capacity * 2;
        EntityDOT* new_dots = (EntityDOT*)core_realloc(g_active_dots, new_capacity * sizeof(EntityDOT));
        if (!new_dots) return;
        
        g_active_dots = new_dots;
        g_active_dot_capacity = new_capacity;
    }
    
    g_active_dots[g_active_dot_count].entity = entity;
    g_active_dots[g_active_dot_count].effect = *dot;
    g_active_dot_count++;
}

void damage_dot_remove_effect(DamageSystem* system, EntityID entity, DamageType type) {
    if (!system) return;
    
    for (uint32_t i = 0; i < g_active_dot_count; i++) {
        if (g_active_dots[i].entity == entity && g_active_dots[i].effect.type == type) {
            // Remove by shifting remaining elements
            for (uint32_t j = i; j < g_active_dot_count - 1; j++) {
                g_active_dots[j] = g_active_dots[j + 1];
            }
            g_active_dot_count--;
            return;
        }
    }
}

void damage_dot_update_effects(DamageSystem* system, float delta_time) {
    if (!system) return;
    
    for (uint32_t i = 0; i < g_active_dot_count; i++) {
        EntityDOT* entity_dot = &g_active_dots[i];
        DOTEffect* dot = &entity_dot->effect;
        
        dot->time_remaining -= delta_time;
        dot->time_since_last_tick += delta_time;
        
        // Apply damage at intervals
        if (dot->time_since_last_tick >= dot->interval) {
            DamageInstance damage = damage_create(dot->type, dot->damage_per_second * dot->interval, dot->source);
            damage_apply_to_entity(system, entity_dot->entity, &damage);
            
            dot->time_since_last_tick = 0.0f;
        }
        
        // Remove expired effects
        if (dot->time_remaining <= 0.0f) {
            // Remove by shifting remaining elements
            for (uint32_t j = i; j < g_active_dot_count - 1; j++) {
                g_active_dots[j] = g_active_dots[j + 1];
            }
            g_active_dot_count--;
            i--; // Recheck this index
        }
    }
}

bool damage_dot_has_effect(DamageSystem* system, EntityID entity, DamageType type) {
    if (!system) return false;
    
    for (uint32_t i = 0; i < g_active_dot_count; i++) {
        if (g_active_dots[i].entity == entity && g_active_dots[i].effect.type == type) {
            return true;
        }
    }
    return false;
}

// Damage Immunity System
typedef struct {
    EntityID entity;
    DamageImmunity immunity;
} EntityImmunity;

static EntityImmunity* g_active_immunities = NULL;
static uint32_t g_active_immunity_count = 0;
static uint32_t g_active_immunity_capacity = 0;

void damage_immunity_set(DamageSystem* system, EntityID entity, float duration, const DamageType* types, uint32_t type_count) {
    if (!system || duration <= 0.0f) return;
    
    // Check if entity already has immunity
    for (uint32_t i = 0; i < g_active_immunity_count; i++) {
        if (g_active_immunities[i].entity == entity) {
            DamageImmunity* immunity = &g_active_immunities[i].immunity;
            immunity->immune = true;
            immunity->duration = duration;
            immunity->time_remaining = duration;
            
            if (types && type_count > 0) {
                immunity->immune_type_count = type_count;
                for (uint32_t j = 0; j < type_count && j < DAMAGE_TYPE_COUNT; j++) {
                    immunity->immune_types[j] = types[j];
                }
            } else {
                immunity->immune_type_count = 0; // Immune to all damage
            }
            return;
        }
    }
    
    // Add new immunity
    if (g_active_immunity_count >= g_active_immunity_capacity) {
        uint32_t new_capacity = g_active_immunity_capacity == 0 ? 16 : g_active_immunity_capacity * 2;
        EntityImmunity* new_immunities = (EntityImmunity*)core_realloc(g_active_immunities, new_capacity * sizeof(EntityImmunity));
        if (!new_immunities) return;
        
        g_active_immunities = new_immunities;
        g_active_immunity_capacity = new_capacity;
    }
    
    EntityImmunity* new_immunity = &g_active_immunities[g_active_immunity_count];
    new_immunity->entity = entity;
    new_immunity->immunity.immune = true;
    new_immunity->immunity.duration = duration;
    new_immunity->immunity.time_remaining = duration;
    
    if (types && type_count > 0) {
        new_immunity->immunity.immune_type_count = type_count;
        for (uint32_t i = 0; i < type_count && i < DAMAGE_TYPE_COUNT; i++) {
            new_immunity->immunity.immune_types[i] = types[i];
        }
    } else {
        new_immunity->immunity.immune_type_count = 0; // Immune to all damage
    }
    
    g_active_immunity_count++;
}

void damage_immunity_clear(DamageSystem* system, EntityID entity) {
    if (!system) return;
    
    for (uint32_t i = 0; i < g_active_immunity_count; i++) {
        if (g_active_immunities[i].entity == entity) {
            // Remove by shifting remaining elements
            for (uint32_t j = i; j < g_active_immunity_count - 1; j++) {
                g_active_immunities[j] = g_active_immunities[j + 1];
            }
            g_active_immunity_count--;
            return;
        }
    }
}

bool damage_immunity_is_immune(DamageSystem* system, EntityID entity, DamageType type) {
    if (!system) return false;
    
    for (uint32_t i = 0; i < g_active_immunity_count; i++) {
        if (g_active_immunities[i].entity == entity && g_active_immunities[i].immunity.immune) {
            DamageImmunity* immunity = &g_active_immunities[i].immunity;
            
            // If no specific types, immune to all damage
            if (immunity->immune_type_count == 0) {
                return true;
            }
            
            // Check if immune to this specific type
            for (uint32_t j = 0; j < immunity->immune_type_count; j++) {
                if (immunity->immune_types[j] == type) {
                    return true;
                }
            }
        }
    }
    return false;
}

void damage_immunity_update(DamageSystem* system, float delta_time) {
    if (!system) return;
    
    for (uint32_t i = 0; i < g_active_immunity_count; i++) {
        EntityImmunity* entity_immunity = &g_active_immunities[i];
        DamageImmunity* immunity = &entity_immunity->immunity;
        
        immunity->time_remaining -= delta_time;
        
        if (immunity->time_remaining <= 0.0f) {
            immunity->immune = false;
            
            // Remove expired immunity
            for (uint32_t j = i; j < g_active_immunity_count - 1; j++) {
                g_active_immunities[j] = g_active_immunities[j + 1];
            }
            g_active_immunity_count--;
            i--; // Recheck this index
        }
    }
}

// Damage Statistics Functions
void damage_stats_reset(DamageStats* stats) {
    if (!stats) return;
    memset(stats, 0, sizeof(DamageStats));
}

void damage_stats_record_damage_dealt(DamageStats* stats, DamageType type, float amount) {
    if (!stats || type >= DAMAGE_TYPE_COUNT || amount <= 0.0f) return;
    
    stats->total_damage_dealt += amount;
    stats->damage_by_type[type] += amount;
    stats->hits_dealt++;
    
    if (amount > stats->largest_hit_dealt) {
        stats->largest_hit_dealt = amount;
    }
}

void damage_stats_record_damage_taken(DamageStats* stats, DamageType type, float amount) {
    if (!stats || type >= DAMAGE_TYPE_COUNT || amount <= 0.0f) return;
    
    stats->total_damage_taken += amount;
    stats->hits_taken++;
    
    if (amount > stats->largest_hit_taken) {
        stats->largest_hit_taken = amount;
    }
}

void damage_stats_record_death(DamageStats* stats) {
    if (!stats) return;
    stats->deaths++;
}

void damage_stats_record_combat_start(DamageStats* stats) {
    if (!stats) return;
    stats->combat_start_time = (uint64_t)(time(NULL) * 1000);
}

void damage_stats_record_combat_end(DamageStats* stats) {
    if (!stats) return;
    stats->combat_end_time = (uint64_t)(time(NULL) * 1000);
}

// Damage Visualization Functions
void damage_visualization_show_number(DamageSystem* system, Vec3 position, float amount, DamageType type, bool is_critical) {
    if (!system || !system->damage_numbers) return;
    
    // Find available damage number slot
    for (uint32_t i = 0; i < system->max_damage_numbers; i++) {
        DamageNumber* number = &system->damage_numbers[i];
        if (number->display_time <= 0.0f) {
            // Initialize damage number
            number->position = position;
            number->position.y += 1.0f; // Offset above entity
            number->damage_amount = amount;
            number->type = type;
            number->is_critical = is_critical;
            number->is_healing = false;
            number->display_time = 2.0f;
            number->fade_time = 1.5f;
            number->scale = is_critical ? 1.5f : 1.0f;
            
            // Random upward velocity
            number->velocity = (Vec3){(rand() % 100 - 50) * 0.01f, 0.5f, 0.0f};
            
            system->active_damage_numbers++;
            return;
        }
    }
}

void damage_visualization_show_healing(DamageSystem* system, Vec3 position, float amount) {
    if (!system || !system->damage_numbers) return;
    
    // Find available damage number slot
    for (uint32_t i = 0; i < system->max_damage_numbers; i++) {
        DamageNumber* number = &system->damage_numbers[i];
        if (number->display_time <= 0.0f) {
            // Initialize healing number
            number->position = position;
            number->position.y += 1.0f;
            number->damage_amount = amount;
            number->type = DAMAGE_TYPE_PHYSICAL; // Healing doesn't have a type
            number->is_critical = false;
            number->is_healing = true;
            number->display_time = 2.0f;
            number->fade_time = 1.5f;
            number->scale = 1.0f;
            
            // Upward velocity for healing
            number->velocity = (Vec3){0.0f, 0.3f, 0.0f};
            
            system->active_damage_numbers++;
            return;
        }
    }
}

void damage_visualization_update(DamageSystem* system, float delta_time) {
    if (!system || !system->damage_numbers) return;
    
    for (uint32_t i = 0; i < system->max_damage_numbers; i++) {
        DamageNumber* number = &system->damage_numbers[i];
        
        if (number->display_time > 0.0f) {
            // Update position
            number->position = vec3_add(number->position, vec3_mul(number->velocity, delta_time));
            
            // Apply gravity to velocity
            number->velocity.y -= 9.8f * delta_time * 0.1f;
            
            // Update display time
            number->display_time -= delta_time;
            
            // Remove if expired
            if (number->display_time <= 0.0f) {
                system->active_damage_numbers--;
            }
        }
    }
}

void damage_visualization_clear_all(DamageSystem* system) {
    if (!system || !system->damage_numbers) return;
    
    for (uint32_t i = 0; i < system->max_damage_numbers; i++) {
        system->damage_numbers[i].display_time = 0.0f;
    }
    system->active_damage_numbers = 0;
}

// Utility Functions
const char* damage_type_get_name(DamageType type) {
    if (type >= DAMAGE_TYPE_COUNT) return "Unknown";
    return DAMAGE_TYPE_NAMES[type];
}

bool damage_type_is_physical(DamageType type) {
    return type == DAMAGE_TYPE_PHYSICAL || type == DAMAGE_TYPE_FALL || type == DAMAGE_TYPE_EXPLOSION;
}

bool damage_type_is_elemental(DamageType type) {
    return type == DAMAGE_TYPE_FIRE || type == DAMAGE_TYPE_COLD || type == DAMAGE_TYPE_LIGHTNING;
}

bool damage_type_is_environmental(DamageType type) {
    return type == DAMAGE_TYPE_FALL || type == DAMAGE_TYPE_DROWNING || type == DAMAGE_TYPE_STARVATION || 
           type == DAMAGE_TYPE_SUFFOCATION || type == DAMAGE_TYPE_LAVA;
}

float damage_type_get_default_resistance(DamageType type) {
    switch (type) {
        case DAMAGE_TYPE_FIRE: return 0.0f;
        case DAMAGE_TYPE_FALL: return 0.0f;
        case DAMAGE_TYPE_DROWNING: return 0.0f;
        case DAMAGE_TYPE_STARVATION: return 0.0f;
        case DAMAGE_TYPE_SUFFOCATION: return 0.0f;
        default: return 0.0f;
    }
}

const char* armor_type_get_name(ArmorType type) {
    if (type >= ARMOR_TYPE_COUNT) return "Unknown";
    return ARMOR_TYPE_NAMES[type];
}

float armor_type_get_base_protection(ArmorType type) {
    if (type >= ARMOR_TYPE_COUNT) return 0.0f;
    
    // Return average protection across all damage types
    float total = 0.0f;
    for (int i = 0; i < DAMAGE_TYPE_COUNT; i++) {
        total += ARMOR_PROTECTION_TABLE[type][i];
    }
    return total / DAMAGE_TYPE_COUNT;
}

float armor_type_get_durability(ArmorType type) {
    if (type >= ARMOR_TYPE_COUNT) return 0.0f;
    return ARMOR_DURABILITY[type];
}

float armor_type_get_toughness(ArmorType type) {
    if (type >= ARMOR_TYPE_COUNT) return 0.0f;
    return ARMOR_TOUGHNESS[type];
}

float damage_calculate_reduction(float damage, float armor_value, float toughness) {
    // Minecraft armor formula: damage * (1 - min(20, max(armor/5, armor - 4*damage/toughness)) / 25)
    float effective_armor = armor_value;
    float damage_modifier = damage / toughness;
    
    float armor_reduction = effective_armor - (4.0f * damage_modifier);
    if (armor_reduction < effective_armor / 5.0f) {
        armor_reduction = effective_armor / 5.0f;
    }
    
    if (armor_reduction > 20.0f) {
        armor_reduction = 20.0f;
    }
    
    float reduction_percent = armor_reduction / 25.0f;
    return damage * reduction_percent;
}

float damage_calculate_enchantment_reduction(float damage, const ArmorSet* armor, DamageType type) {
    if (!armor || damage <= 0.0f) return 0.0f;
    
    // TODO: Implement enchantment protection calculation
    // This would depend on the specific enchantments on the armor
    // For now, return a small base reduction
    return damage * 0.05f; // 5% base enchantment protection
}

float damage_calculate_critical_hit_damage(float base_damage) {
    return base_damage * 1.5f; // Critical hits deal 50% more damage
}

float damage_calculate_fall_damage(float fall_distance, bool has_feather_falling) {
    if (fall_distance < 3.0f) return 0.0f;
    
    float damage = fall_distance - 3.0f;
    
    if (has_feather_falling) {
        damage *= 0.5f; // Feather Falling reduces fall damage by 50%
    }
    
    return damage;
}

float damage_apply_status_effect_modifiers(float base_damage, EntityID entity) {
    // TODO: Get status effects component and apply modifiers
    // For now, return base damage unchanged
    return base_damage;
}

bool damage_should_apply_status_effect_resistance(EntityID entity, DamageType type) {
    // TODO: Check if entity has resistance status effects
    // For now, return false (no resistance)
    return false;
}

bool damage_is_zero(const DamageInstance* damage) {
    return !damage || damage->amount <= 0.0f;
}

DamageInstance damage_scale(const DamageInstance* damage, float scale_factor) {
    DamageInstance scaled = {0};
    if (damage) {
        scaled = *damage;
        scaled.amount *= scale_factor;
    }
    return scaled;
}

DamageInstance damage_combine(const DamageInstance* damage1, const DamageInstance* damage2) {
    DamageInstance combined = {0};
    if (damage1 && damage2 && damage1->type == damage2->type) {
        combined = *damage1;
        combined.amount += damage2->amount;
        combined.is_critical = combined.is_critical || damage2->is_critical;
        combined.bypass_armor = combined.bypass_armor || damage2->bypass_armor;
        combined.bypass_invulnerability = combined.bypass_invulnerability || damage2->bypass_invulnerability;
    }
    return combined;
}

// Global accessor functions
DamageSystem* get_damage_system(void) {
    return &g_damage_system;
}

bool init_damage_system(ECSWorld* ecs_world) {
    return damage_system_init(&g_damage_system, ecs_world);
}

void cleanup_damage_system(void) {
    damage_system_cleanup(&g_damage_system);
}
