/**
 * Mob Spawning System - Biome-specific spawn rules and automatic despawn mechanics
 *
 * Purpose: Manage automatic mob spawning based on biome type, light levels, and spawn caps.
 * Also handles automatic despawning when mobs are too far from the player or have been idle too long.
 *
 * Patterns adapted from: src/game/npc/npc_spawning.c
 */

#include "../../../include/mobs/mob_spawning.h"
#include "../../../include/world/biome_features.h"
#include "../../../include/world/generator.h"
#include "../../../include/chunk/chunk.h"
#include "../../../include/player/player.h"
#include <stdlib.h>
#include <math.h>
#include <string.h>

// ============================================================================
// Global References
// ============================================================================

extern struct WorldGenerator *g_world_generator;
extern struct PlayerSystem *g_player_system;

// ============================================================================
// Helper Functions
// ============================================================================

/**
 * Determine if a mob type is hostile (attacks players)
 */
static bool mob_is_hostile_type(MobType type) {
    switch (type) {
        case MOB_TYPE_ZOMBIE:
        case MOB_TYPE_SKELETON:
        case MOB_TYPE_SPIDER:
        case MOB_TYPE_CREEPER:
        case MOB_TYPE_ENDERMAN:
        case MOB_TYPE_BLAZE:
            return true;
        case MOB_TYPE_COW:
        case MOB_TYPE_PIG:
        case MOB_TYPE_SHEEP:
        case MOB_TYPE_CHICKEN:
            return false;
        default:
            return false;
    }
}

