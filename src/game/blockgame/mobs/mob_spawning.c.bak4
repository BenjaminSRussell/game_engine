static u32 g_spawn_tables_data_count = sizeof(g_spawn_tables_data) / sizeof(g_spawn_tables_data[0]);

// ============================================================================
// Light Level Check Functions
// ============================================================================

bool mob_spawner_has_sufficient_light(Chunk *chunk, i32 x, i32 y, i32 z) {
    if (!chunk) return false;
    u8 light = chunk_get_light(chunk, x, y, z, LIGHT_TYPE_BLOCK);
    return light >= LIGHT_LEVEL_BRIGHT_THRESHOLD;
}

bool mob_spawner_is_dark_enough(Chunk *chunk, i32 x, i32 y, i32 z) {
    if (!chunk) return false;
    u8 light = chunk_get_light(chunk, x, y, z, LIGHT_TYPE_BLOCK);
    return light <= LIGHT_LEVEL_DARK_THRESHOLD;
}

// ============================================================================
// Spawn Table Query Functions
// ============================================================================

BiomeSpawnTable *mob_spawner_get_table_for_biome(MobSpawner *spawner, BiomeType biome) {
    if (!spawner) return NULL;

    for (u32 i = 0; i < spawner->spawn_table_count; i++) {
        if (spawner->spawn_tables[i].biome == biome) {
            return &spawner->spawn_tables[i];
        }
    }
    return NULL;
}

MobType mob_spawner_select_mob_for_biome(MobSpawner *spawner, BiomeType biome, u8 light_level) {
    BiomeSpawnTable *table = mob_spawner_get_table_for_biome(spawner, biome);
    if (!table || table->entry_count == 0) {
        return MOB_TYPE_ZOMBIE;
    }

    f32 total_weight = 0.0f;
    for (u32 i = 0; i < table->entry_count; i++) {
        BiomeSpawnEntry *entry = &table->entries[i];
        if (light_level >= entry->min_light && light_level <= entry->max_light) {
            total_weight += entry->spawn_weight;
        }
    }

    if (total_weight <= 0.0f) {
        return MOB_TYPE_ZOMBIE;
    }

    f32 random_value = ((f32)rand() / (f32)RAND_MAX) * total_weight;
    f32 cumulative = 0.0f;

    for (u32 i = 0; i < table->entry_count; i++) {
        BiomeSpawnEntry *entry = &table->entries[i];
        if (light_level >= entry->min_light && light_level <= entry->max_light) {
            cumulative += entry->spawn_weight;
            if (random_value <= cumulative) {
                return entry->mob_type;
            }
        }
    }

    return MOB_TYPE_ZOMBIE;
}

// ============================================================================
// Spawn Cap Functions
// ============================================================================

u32 mob_spawner_count_mobs_in_chunk(MobSpawner *spawner, Chunk *chunk) {
    if (!spawner || !spawner->mob_manager || !chunk) return 0;

    u32 count = 0;
    f32 min_x = (f32)chunk->pos.x * 16.0f;
    f32 max_x = min_x + 16.0f;
    f32 min_z = (f32)chunk->pos.z * 16.0f;
    f32 max_z = min_z + 16.0f;

    for (u32 i = 0; i < spawner->mob_manager->count; i++) {
        Mob *mob = &spawner->mob_manager->mobs[i];
        if (!mob->alive) continue;

        if (mob->position.x >= min_x && mob->position.x < max_x &&
            mob->position.z >= min_z && mob->position.z < max_z) {
            count++;
        }
    }

    return count;
}

u32 mob_spawner_count_hostile_in_chunk(MobSpawner *spawner, Chunk *chunk) {
    if (!spawner || !spawner->mob_manager || !chunk) return 0;

    u32 count = 0;
    f32 min_x = (f32)chunk->pos.x * 16.0f;
    f32 max_x = min_x + 16.0f;
    f32 min_z = (f32)chunk->pos.z * 16.0f;
    f32 max_z = min_z + 16.0f;

    for (u32 i = 0; i < spawner->mob_manager->count; i++) {
        Mob *mob = &spawner->mob_manager->mobs[i];
        if (!mob->alive) continue;

        if (mob->position.x >= min_x && mob->position.x < max_x &&
            mob->position.z >= min_z && mob->position.z < max_z &&
            mob_is_hostile_type(mob->type)) {
            count++;
        }
    }

    return count;
}

u32 mob_spawner_count_passive_in_chunk(MobSpawner *spawner, Chunk *chunk) {
    if (!spawner || !spawner->mob_manager || !chunk) return 0;

    u32 count = 0;
    f32 min_x = (f32)chunk->pos.x * 16.0f;
    f32 max_x = min_x + 16.0f;
    f32 min_z = (f32)chunk->pos.z * 16.0f;
    f32 max_z = min_z + 16.0f;

    for (u32 i = 0; i < spawner->mob_manager->count; i++) {
        Mob *mob = &spawner->mob_manager->mobs[i];
        if (!mob->alive) continue;

        if (mob->position.x >= min_x && mob->position.x < max_x &&
            mob->position.z >= min_z && mob->position.z < max_z &&
            !mob_is_hostile_type(mob->type)) {
            count++;
        }
    }

    return count;
}

bool mob_spawner_can_spawn_in_chunk(MobSpawner *spawner, Chunk *chunk) {
    if (!spawner || !chunk) return false;

    u32 total_mobs = mob_spawner_count_mobs_in_chunk(spawner, chunk);
    if (total_mobs >= MAX_MOBS_PER_CHUNK) {
        return false;
    }

    return true;
}

// ============================================================================
// Spawn System Functions
// ============================================================================

bool mob_spawner_try_spawn_at(MobSpawner *spawner, Vec3 position, BiomeType biome) {
    if (!spawner || !spawner->mob_manager) return false;

    ChunkPos chunk_pos = {(i32)position.x / 16, (i32)position.y / 256, (i32)position.z / 16};
    Chunk *chunk = chunk_manager_get(spawner->chunk_manager, chunk_pos);
    if (!chunk) return false;

    if (!mob_spawner_can_spawn_in_chunk(spawner, chunk)) {
        return false;
    }

    i32 local_x = ((i32)position.x) & 0xF;
    i32 local_z = ((i32)position.z) & 0xF;
    u8 light = chunk_get_light(chunk, local_x, (i32)position.y, local_z, LIGHT_TYPE_BLOCK);

    BiomeSpawnTable *table = mob_spawner_get_table_for_biome(spawner, biome);
    if (!table) return false;

    MobType mob_type = mob_spawner_select_mob_for_biome(spawner, biome, light);

    if (mob_is_hostile_type(mob_type)) {
        if (mob_spawner_count_hostile_in_chunk(spawner, chunk) >= MAX_HOSTILE_PER_CHUNK) {
            return false;
        }
    } else {
        if (mob_spawner_count_passive_in_chunk(spawner, chunk) >= MAX_PASSIVE_PER_CHUNK) {
            return false;
        }
    }

    mob_spawn(spawner->mob_manager, mob_type, position);
    return true;
}

void mob_spawner_attempt_spawn(MobSpawner *spawner) {
    if (!spawner || !spawner->enabled || !spawner->chunk_manager || !spawner->world_gen) {
        return;
    }

    Vec3 player_pos = {0, 0, 0};
    if (g_player_system) {
        player_pos = player_get_position(g_player_system);
    }

    // Try to spawn mobs around player
    // Use a reasonable spawn radius (48-64 blocks)
    for (i32 dx = -3; dx <= 3; dx++) {
        for (i32 dz = -3; dz <= 3; dz++) {
            ChunkPos chunk_pos = {
                (i32)(player_pos.x / 16.0f) + dx,
                (i32)(player_pos.y / 256.0f),
                (i32)(player_pos.z / 16.0f) + dz
            };

            Chunk *chunk = chunk_manager_get(spawner->chunk_manager, chunk_pos);
            if (!chunk || chunk->state != CHUNK_STATE_READY) continue;

            if (!mob_spawner_can_spawn_in_chunk(spawner, chunk)) continue;

            // Try a couple spawn attempts per chunk
            for (u32 attempt = 0; attempt < 2; attempt++) {
                i32 random_local_x = rand() % 16;
                i32 random_local_z = rand() % 16;
                i32 random_y = 64;

                Vec3 spawn_pos = {
                    (f32)(chunk_pos.x * 16 + random_local_x),
                    (f32)random_y,
                    (f32)(chunk_pos.z * 16 + random_local_z)
                };

                BiomeType biome = world_generator_get_biome(spawner->world_gen,
                                                           (i32)spawn_pos.x,
                                                           (i32)spawn_pos.y,
                                                           (i32)spawn_pos.z);

                mob_spawner_try_spawn_at(spawner, spawn_pos, biome);
            }
        }
    }
}

// ============================================================================
// Despawn System Functions
// ============================================================================

void mob_spawner_despawn_distant(MobSpawner *spawner) {
    if (!spawner || !spawner->mob_manager || !g_player_system) return;

    Vec3 player_pos = player_get_position(g_player_system);

    for (i32 i = (i32)spawner->mob_manager->count - 1; i >= 0; i--) {
        Mob *mob = &spawner->mob_manager->mobs[i];
        if (!mob->alive) continue;

        f32 distance = vec3_distance(mob->position, player_pos);
        if (distance > DESPAWN_DISTANCE) {
            mob_despawn(spawner->mob_manager, mob->entity_id);
        }
    }
}

void mob_spawner_despawn_old(MobSpawner *spawner) {
    if (!spawner || !spawner->mob_manager) return;

    for (i32 i = (i32)spawner->mob_manager->count - 1; i >= 0; i--) {
        Mob *mob = &spawner->mob_manager->mobs[i];
        if (!mob->alive) continue;

        if (mob->state == MOB_STATE_IDLE || mob->state == MOB_STATE_WANDERING) {
            f32 time_alive = (f32)mob->spawn_time / 20.0f;

            if (time_alive > DESPAWN_TIMEOUT) {
                mob_despawn(spawner->mob_manager, mob->entity_id);
            }
        }
    }
}

// ============================================================================
// Initialization and Cleanup
// ============================================================================

void mob_spawner_init(MobSpawner *spawner,
                      MobManager *mobs,
                      struct ChunkManager *chunks,
                      struct WorldGenerator *gen,
                      struct PlayerSystem *player) {
    if (!spawner) return;

    spawner->mob_manager = mobs;
    spawner->chunk_manager = chunks;
    spawner->world_gen = gen;
    spawner->player_system = player;

    spawner->spawn_table_count = g_spawn_tables_data_count;
    spawner->spawn_tables = (BiomeSpawnTable *)malloc(
        sizeof(BiomeSpawnTable) * spawner->spawn_table_count
    );

    if (spawner->spawn_tables) {
        memcpy(spawner->spawn_tables, g_spawn_tables_data,
               sizeof(BiomeSpawnTable) * spawner->spawn_table_count);
    }

    spawner->spawn_timer = 0.0f;
    spawner->spawn_interval = SPAWN_ATTEMPT_INTERVAL;
    spawner->enabled = true;
}

void mob_spawner_free(MobSpawner *spawner) {
    if (!spawner) return;

    if (spawner->spawn_tables) {
        free(spawner->spawn_tables);
        spawner->spawn_tables = NULL;
    }

    spawner->spawn_table_count = 0;
    spawner->enabled = false;
}

// ============================================================================
// Main Update Function
// ============================================================================

void mob_spawner_update(MobSpawner *spawner, f32 delta_time) {
    if (!spawner || !spawner->enabled) return;

    spawner->spawn_timer += delta_time;

    if (spawner->spawn_timer >= spawner->spawn_interval) {
        spawner->spawn_timer = 0.0f;
        mob_spawner_attempt_spawn(spawner);
    }
}

// ============================================================================
// Configuration Functions
// ============================================================================

void mob_spawner_set_enabled(MobSpawner *spawner, bool enabled) {
    if (!spawner) return;
    spawner->enabled = enabled;
}

bool mob_spawner_is_enabled(MobSpawner *spawner) {
    if (!spawner) return false;
    return spawner->enabled;
}
