#version 450

// Enhanced Screen-Space Reflections (SSR) Compute Shader
// Advanced SSR with hierarchical ray marching, temporal accumulation, and quality improvements

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D sceneColor;
layout(binding = 1) uniform sampler2D normalRoughness;
layout(binding = 2) uniform sampler2D depthBuffer;
layout(binding = 3) uniform sampler2D motionVector; // For temporal stability
layout(binding = 4) uniform sampler2D historyReflection; // Temporal accumulation
layout(binding = 5) uniform sampler2D depthHierarchy; // Hierarchical depth buffer (mip chain)
layout(rgba16f) uniform image2D outputImage;
layout(rgba16f) uniform image2D historyOutput; // For next frame

layout(push_constant) uniform SSRParams {
    vec2 texelSize;
    float maxDistance;         // Maximum ray distance in screen space
    float thickness;           // Surface thickness for intersection testing
    u32 maxSteps;             // Maximum ray march steps
    float stride;             // Initial ray stride
    float fadeDistance;       // Distance to start fading reflections
    vec2 projectionParams;     // x = near, y = far
    float temporalWeight;      // Temporal accumulation weight
    u32 enableTemporal;        // Enable temporal accumulation
    u32 enableHierarchical;    // Enable hierarchical ray marching
    u32 qualityLevel;          // 0=low, 1=medium, 2=high, 3=ultra
    float roughnessCutoff;     // Roughness cutoff for reflections
    float edgeFade;            // Edge fade strength
} params;

// Shared memory for neighborhood samples
shared vec3 colorSamples[18][18];
shared vec3 normalSamples[18][18];
shared float roughnessSamples[18][18];
shared float depthSamples[18][18];

// Utility functions
vec3 reconstructWorldPosition(vec2 uv, float depth) {
    float ndc_x = uv.x * 2.0 - 1.0;
    float ndc_y = uv.y * 2.0 - 1.0;
    
    // Linearize depth with better precision
    float depthLinear = 2.0 * params.projectionParams.x * params.projectionParams.y / 
                       (params.projectionParams.y + params.projectionParams.x - 
                        ndc_y * (params.projectionParams.y - params.projectionParams.x));
    
    return vec3(ndc_x * depthLinear, depthLinear, ndc_y * depthLinear);
}

vec3 worldToScreen(vec3 worldPos) {
    vec2 uv = vec2(worldPos.x / worldPos.y * 0.5 + 0.5,
                  worldPos.z / worldPos.y * 0.5 + 0.5);
    return vec3(uv, worldPos.y);
}

// Enhanced hierarchical ray marching with adaptive step sizes
bool hierarchicalRayMarch(vec3 start, vec3 direction, float roughness, out vec3 hitPos, out vec3 hitNormal, out float hitConfidence) {
    vec3 current = start;
    float currentStride = params.stride;
    hitConfidence = 0.0;
    
    // Adaptive step count based on quality level
    int adaptiveMaxSteps = params.maxSteps;
    if (params.qualityLevel == 0) adaptiveMaxSteps /= 4;
    else if (params.qualityLevel == 1) adaptiveMaxSteps /= 2;
    else if (params.qualityLevel == 3) adaptiveMaxSteps *= 2;
    
    for (int i = 0; i < adaptiveMaxSteps; i++) {
        current += direction * currentStride;
        
        // Convert to screen space
        vec3 screenPos = worldToScreen(current);
        
        // Check bounds
        if (screenPos.x < 0.0 || screenPos.x > 1.0 || 
            screenPos.y < 0.0 || screenPos.y > 1.0 ||
            screenPos.z <= 0.0) {
            return false;
        }
        
        // Sample depth from appropriate mip level
        float mipLevel = 0.0;
        if (params.enableHierarchical != 0) {
            // Adaptive mip level based on stride and roughness
            mipLevel = log2(max(currentStride * 2.0, roughness * 4.0));
            mipLevel = clamp(mipLevel, 0.0, 6.0); // Clamp to reasonable range
        }
        
        float depth = textureLod(depthHierarchy, screenPos.xy, mipLevel).r;
        
        // Reconstruct world position
        vec3 worldPos = reconstructWorldPosition(screenPos.xy, depth);
        
        // Check intersection with improved thickness handling
        float distance = length(current - worldPos);
        float adaptiveThickness = params.thickness * (1.0 + roughness * 2.0); // Rougher surfaces need more thickness
        
        if (distance < adaptiveThickness) {
            // Found intersection, refine with binary search
            vec3 refineStart = current - direction * currentStride;
            vec3 refineEnd = current;
            
            int refineSteps = params.qualityLevel >= 2 ? 8 : 4;
            for (int j = 0; j < refineSteps; j++) {
                vec3 mid = (refineStart + refineEnd) * 0.5;
                vec3 midScreen = worldToScreen(mid);
                float midDepth = texture(depthBuffer, midScreen.xy).r;
                vec3 midWorld = reconstructWorldPosition(midScreen.xy, midDepth);
                
                if (length(mid - midWorld) < adaptiveThickness) {
                    refineEnd = mid;
                } else {
                    refineStart = mid;
                }
            }
            
            hitPos = (refineStart + refineEnd) * 0.5;
            
            // Sample normal and roughness at hit position
            vec3 hitScreen = worldToScreen(hitPos);
            vec4 hitNormalRoughness = texture(normalRoughness, hitScreen.xy);
            hitNormal = normalize(hitNormalRoughness.rgb * 2.0 - 1.0);
            
            // Calculate hit confidence based on various factors
            hitConfidence = 1.0;
            
            // Reduce confidence for grazing angles
            float angle = max(0.0, dot(-direction, hitNormal));
            hitConfidence *= angle;
            
            // Reduce confidence for rough surfaces
            hitConfidence *= 1.0 - roughness * 0.5;
            
            // Reduce confidence for distant hits
            float hitDistance = length(hitPos - start);
            hitConfidence *= 1.0 - clamp(hitDistance / params.maxDistance, 0.0, 0.8);
            
            return true;
        }
        
        // Adaptive stride adjustment
        if (params.enableHierarchical != 0) {
            // Increase stride as we move away from start point
            float distanceFromStart = length(current - start);
            float strideMultiplier = 1.0 + distanceFromStart * 0.1;
            currentStride = min(currentStride * strideMultiplier, params.stride * 4.0);
        }
    }
    
    return false;
}

// Calculate reflection color with proper filtering
vec3 calculateReflectionColor(vec3 hitPos, vec3 hitNormal, float hitConfidence) {
    vec3 hitScreen = worldToScreen(hitPos);
    
    // Check bounds
    if (hitScreen.x < 0.0 || hitScreen.x > 1.0 || 
        hitScreen.y < 0.0 || hitScreen.y > 1.0) {
        return vec3(0.0);
    }
    
    // Sample with proper mip level based on hit confidence and distance
    float mipLevel = 0.0;
    if (hitConfidence < 0.8) {
        mipLevel = (1.0 - hitConfidence) * 4.0; // Use higher mips for low confidence
    }
    
    vec3 reflectionColor = textureLod(sceneColor, hitScreen.xy, mipLevel).rgb;
    
    // Apply confidence-based fade
    reflectionColor *= hitConfidence;
    
    return reflectionColor;
}

// Edge-aware fade function
float calculateEdgeFade(vec2 uv, vec2 texelSize) {
    vec2 edges = vec2(0.0);
    
    // Calculate depth edges
    float depthCenter = texture(depthBuffer, uv).r;
    float depthLeft = texture(depthBuffer, uv + vec2(-texelSize.x, 0.0)).r;
    float depthRight = texture(depthBuffer, uv + vec2(texelSize.x, 0.0)).r;
    float depthTop = texture(depthBuffer, uv + vec2(0.0, -texelSize.y)).r;
    float depthBottom = texture(depthBuffer, uv + vec2(0.0, texelSize.y)).r;
    
    edges.x = abs(depthRight - depthLeft) + abs(depthBottom - depthTop);
    
    // Calculate normal edges
    vec3 normalCenter = texture(normalRoughness, uv).rgb * 2.0 - 1.0;
    vec3 normalLeft = texture(normalRoughness, uv + vec2(-texelSize.x, 0.0)).rgb * 2.0 - 1.0;
    vec3 normalRight = texture(normalRoughness, uv + vec2(texelSize.x, 0.0)).rgb * 2.0 - 1.0;
    vec3 normalTop = texture(normalRoughness, uv + vec2(0.0, -texelSize.y)).rgb * 2.0 - 1.0;
    vec3 normalBottom = texture(normalRoughness, uv + vec2(0.0, texelSize.y)).rgb * 2.0 - 1.0;
    
    edges.y = length(normalRight - normalLeft) + length(normalBottom - normalTop);
    
    float edgeStrength = length(edges);
    return 1.0 - clamp(edgeStrength * params.edgeFade, 0.0, 1.0);
}

// Temporal reprojection for stability
vec3 temporalReprojection(vec2 uv, vec3 currentReflection, float confidence) {
    if (params.enableTemporal == 0) {
        return currentReflection;
    }
    
    // Sample motion vector
    vec2 motion = texture(motionVector, uv).rg;
    vec2 historyUV = uv - motion;
    
    // Check if history UV is valid
    if (historyUV.x < 0.0 || historyUV.x > 1.0 || 
        historyUV.y < 0.0 || historyUV.y > 1.0) {
        return currentReflection;
    }
    
    // Sample history
    vec4 historyReflection = texture(historyReflection, historyUV);
    
    // Calculate temporal weight based on confidence and motion
    float temporalWeight = params.temporalWeight;
    temporalWeight *= confidence; // Reduce temporal weight for low confidence
    temporalWeight *= 1.0 - length(motion) * 10.0; // Reduce for high motion
    
    // Blend with history
    return mix(currentReflection, historyReflection.rgb, temporalWeight);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    
    // Load scene data
    vec3 sceneColor = texture(sceneColor, uv).rgb;
    vec4 normalRoughness = texture(normalRoughness, uv);
    vec3 normal = normalize(normalRoughness.rgb * 2.0 - 1.0);
    float roughness = normalRoughness.a;
    float depth = texture(depthBuffer, uv).r;
    
    // Store in shared memory for neighborhood access
    ivec2 tileCoord = ivec2(gl_LocalInvocationID.xy) + ivec2(1);
    colorSamples[tileCoord.x][tileCoord.y] = sceneColor;
    normalSamples[tileCoord.x][tileCoord.y] = normal;
    roughnessSamples[tileCoord.x][tileCoord.y] = roughness;
    depthSamples[tileCoord.x][tileCoord.y] = depth;
    
    // Load neighborhood (each thread loads multiple pixels)
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 sampleCoord = coord + ivec2(dx, dy);
            ivec2 sharedCoord = tileCoord + ivec2(dx, dy);
            
            if (sampleCoord.x >= 0 && sampleCoord.x < size.x &&
                sampleCoord.y >= 0 && sampleCoord.y < size.y) {
                vec2 sampleUV = (vec2(sampleCoord) + 0.5) / vec2(size);
                colorSamples[sharedCoord.x][sharedCoord.y] = texture(sceneColor, sampleUV).rgb;
                normalSamples[sharedCoord.x][sharedCoord.y] = texture(normalRoughness, sampleUV).rgb * 2.0 - 1.0;
                roughnessSamples[sharedCoord.x][sharedCoord.y] = texture(normalRoughness, sampleUV).a;
                depthSamples[sharedCoord.x][sharedCoord.y] = texture(depthBuffer, sampleUV).r;
            }
        }
    }
    
    // Synchronize
    barrier();
    
    // Skip background pixels and rough surfaces
    if (depth >= 0.999 || roughness > params.roughnessCutoff) {
        imageStore(outputImage, coord, vec4(sceneColor, 1.0));
        imageStore(historyOutput, coord, vec4(sceneColor, 1.0));
        return;
    }
    
    // Reconstruct world position
    vec3 worldPos = reconstructWorldPosition(uv, depth);
    
    // Calculate reflection direction
    vec3 viewDir = normalize(-worldPos); // Assuming camera at origin
    vec3 reflectDir = reflect(-viewDir, normal);
    
    // Scale reflection direction based on roughness (rougher surfaces get more spread)
    float roughnessSpread = roughness * roughness; // Square roughness for better spread
    reflectDir = normalize(mix(reflectDir, normal, roughnessSpread * 0.5));
    
    // Ray march to find intersection
    vec3 hitPos, hitNormal;
    float hitConfidence;
    bool hit = hierarchicalRayMarch(worldPos, reflectDir, roughness, hitPos, hitNormal, hitConfidence);
    
    vec3 finalColor = sceneColor;
    
    if (hit && hitConfidence > 0.1) {
        // Calculate reflection color
        vec3 reflectionColor = calculateReflectionColor(hitPos, hitNormal, hitConfidence);
        
        // Calculate fade based on distance
        float hitDistance = length(hitPos - worldPos);
        float distanceFade = 1.0 - clamp(hitDistance / params.fadeDistance, 0.0, 1.0);
        
        // Calculate edge fade
        float edgeFade = calculateEdgeFade(uv, params.texelSize);
        
        // Fresnel effect
        float fresnel = pow(1.0 - max(0.0, dot(viewDir, normal)), 5.0);
        fresnel = mix(fresnel, 1.0, roughness); // Rougher surfaces have less fresnel
        
        // Roughness-based reflection strength
        float reflectionStrength = (1.0 - roughness) * fresnel * distanceFade * edgeFade * hitConfidence;
        
        // Apply reflection
        finalColor = mix(finalColor, reflectionColor, reflectionStrength);
        
        // Apply temporal reprojection
        finalColor = temporalReprojection(uv, finalColor, hitConfidence);
    }
    
    // Write results
    imageStore(outputImage, coord, vec4(finalColor, 1.0));
    imageStore(historyOutput, coord, vec4(finalColor, 1.0));
}
