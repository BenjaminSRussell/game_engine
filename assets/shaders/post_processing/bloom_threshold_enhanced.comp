#version 450

// Enhanced Bloom Threshold Compute Shader
// Advanced bloom with HDR support, adaptive threshold, and lens effects

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D hdrInput;
layout(binding = 1) uniform sampler2D lensDirtTexture; // Optional lens dirt
layout(rgba16f) uniform image2D thresholdOutput;

layout(push_constant) uniform BloomThresholdParams {
    float threshold;
    float softKnee;
    float intensity;
    float saturation;
    vec3 tint;
    vec2 texelSize;
    u32 enableLensDirt;
    u32 enableAdaptive;
    float adaptiveStrength;
} params;

// Utility functions
float computeLuminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 adjustSaturation(vec3 color, float saturation) {
    float luminance = computeLuminance(color);
    return mix(vec3(luminance), color, saturation);
}

vec3 applyTint(vec3 color, vec3 tint) {
    return color * tint;
}

// Adaptive threshold based on local luminance
float computeAdaptiveThreshold(vec2 uv, float baseThreshold) {
    if (params.enableAdaptive == 0) return baseThreshold;
    
    // Sample surrounding pixels for local average
    float totalLuminance = 0.0;
    float sampleCount = 0.0;
    
    for (int x = -2; x <= 2; x++) {
        for (int y = -2; y <= 2; y++) {
            vec2 sampleUV = uv + vec2(x, y) * params.texelSize;
            vec3 sampleColor = texture(hdrInput, sampleUV).rgb;
            totalLuminance += computeLuminance(sampleColor);
            sampleCount += 1.0;
        }
    }
    
    float avgLuminance = totalLuminance / sampleCount;
    
    // Adaptive threshold: lower in bright areas, higher in dark areas
    float adaptiveFactor = avgLuminance / (avgLuminance + 0.5);
    return baseThreshold * (1.0 + adaptiveFactor * params.adaptiveStrength);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(thresholdOutput);
    
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec3 color = texture(hdrInput, uv).rgb;
    
    // Compute adaptive threshold
    float adaptiveThreshold = computeAdaptiveThreshold(uv, params.threshold);
    
    // Calculate brightness using maximum channel for better bloom detection
    float brightness = max(color.r, max(color.g, color.b));
    
    // Enhanced soft threshold with smoother knee curve
    float knee = adaptiveThreshold * params.softKnee;
    float soft = brightness - adaptiveThreshold + knee;
    soft = clamp(soft, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 0.00001);
    
    float contribution = max(soft, brightness - adaptiveThreshold);
    contribution /= max(brightness, 0.00001);
    
    // Apply contribution with intensity
    vec3 bloomColor = color * contribution * params.intensity;
    
    // Apply saturation adjustment
    bloomColor = adjustSaturation(bloomColor, params.saturation);
    
    // Apply color tint
    bloomColor = applyTint(bloomColor, params.tint);
    
    // Optional lens dirt effect
    if (params.enableLensDirt != 0) {
        vec3 dirtColor = texture(lensDirtTexture, uv).rgb;
        bloomColor += dirtColor * contribution * 0.5; // Subtle dirt effect
    }
    
    // Additional processing for very bright areas to prevent over-bloom
    float maxBrightness = 10.0; // Cap maximum brightness
    if (brightness > maxBrightness) {
        float attenuation = maxBrightness / brightness;
        bloomColor *= attenuation;
    }
    
    imageStore(thresholdOutput, coord, vec4(bloomColor, 1.0));
}
