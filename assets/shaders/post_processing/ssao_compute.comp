#version 450

// Screen-Space Ambient Occlusion (SSAO) Compute Shader
// Horizon-based SSAO using GPU compute shaders

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D depthBuffer;
layout(binding = 1) uniform sampler2D normalBuffer;
layout(rgba16f) uniform image2D outputImage;

layout(push_constant) uniform SSAOParams {
    vec2 texelSize;
    float radius;          // World space radius
    float intensity;       // AO intensity
    float bias;            // Depth bias
    u32 sampleCount;       // Number of samples
    vec2 projectionParams; // x = near, y = far
} params;

// Random rotation texture for sample directions
layout(binding = 2) uniform sampler2D noiseTexture;

// Shared memory for depth samples
shared float depthSamples[18][18];
shared vec3 normalSamples[18][18];

// Reconstruct world position from depth
vec3 reconstructWorldPosition(vec2 uv, float depth) {
    // Simple reconstruction assuming orthographic projection
    // For perspective, would need camera matrices
    float ndc_x = uv.x * 2.0 - 1.0;
    float ndc_y = uv.y * 2.0 - 1.0;
    
    // Linearize depth
    float depthLinear = 2.0 * params.projectionParams.x * params.projectionParams.y / 
                       (params.projectionParams.y + params.projectionParams.x - 
                        ndc_y * (params.projectionParams.y - params.projectionParams.x));
    
    return vec3(ndc_x * depthLinear, depthLinear, ndc_y * depthLinear);
}

// Generate hemisphere samples
vec3 generateSample(int index, vec3 normal, vec2 random) {
    float angle = 2.0 * 3.14159 * (float(index) + random.x) / float(params.sampleCount);
    float radius = sqrt(float(index) / float(params.sampleCount));
    
    // Create hemisphere sample
    vec3 sample;
    sample.x = cos(angle) * radius;
    sample.y = sin(angle) * radius;
    sample.z = sqrt(max(0.0, 1.0 - radius * radius));
    
    // Align with normal
    vec3 tangent = normalize(cross(normal, vec3(0.0, 1.0, 0.0)));
    if (length(cross(normal, tangent)) < 0.001) {
        tangent = normalize(cross(normal, vec3(1.0, 0.0, 0.0)));
    }
    vec3 bitangent = cross(normal, tangent);
    
    return tangent * sample.x + bitangent * sample.y + normal * sample.z;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    
    // Load depth and normal
    float depth = texture(depthBuffer, uv).r;
    vec3 normal = normalize(texture(normalBuffer, uv).rgb * 2.0 - 1.0);
    
    // Store in shared memory for neighborhood access
    ivec2 tileCoord = ivec2(gl_LocalInvocationID.xy) + ivec2(1);
    depthSamples[tileCoord.x][tileCoord.y] = depth;
    normalSamples[tileCoord.x][tileCoord.y] = normal;
    
    // Load neighborhood (each thread loads multiple pixels)
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 sampleCoord = coord + ivec2(dx, dy);
            ivec2 sharedCoord = tileCoord + ivec2(dx, dy);
            
            if (sampleCoord.x >= 0 && sampleCoord.x < size.x &&
                sampleCoord.y >= 0 && sampleCoord.y < size.y) {
                vec2 sampleUV = (vec2(sampleCoord) + 0.5) / vec2(size);
                depthSamples[sharedCoord.x][sharedCoord.y] = texture(depthBuffer, sampleUV).r;
                normalSamples[sharedCoord.x][sharedCoord.y] = texture(normalBuffer, sampleUV).rgb * 2.0 - 1.0;
            }
        }
    }
    
    // Synchronize
    barrier();
    
    // Skip background pixels
    if (depth >= 0.999) {
        imageStore(outputImage, coord, vec4(1.0, 1.0, 1.0, 1.0));
        return;
    }
    
    // Reconstruct world position
    vec3 worldPos = reconstructWorldPosition(uv, depth);
    
    // Get random rotation
    vec2 noiseUV = uv * vec2(size.x, size.y) / 4.0; // Scale to noise texture size
    vec3 random = texture(noiseTexture, noiseUV).rgb;
    
    // Calculate AO
    float occlusion = 0.0;
    
    for (int i = 0; i < params.sampleCount; i++) {
        // Generate sample direction
        vec3 sampleDir = generateSample(i, normal, random.xy);
        vec3 samplePos = worldPos + sampleDir * params.radius;
        
        // Project sample back to screen space
        vec2 sampleUV = vec2(samplePos.x / samplePos.y * 0.5 + 0.5,
                           samplePos.z / samplePos.y * 0.5 + 0.5);
        
        // Check if sample is valid
        if (sampleUV.x >= 0.0 && sampleUV.x <= 1.0 && 
            sampleUV.y >= 0.0 && sampleUV.y <= 1.0) {
            
            // Sample depth at this position
            float sampleDepth = texture(depthBuffer, sampleUV).r;
            vec3 sampleWorldPos = reconstructWorldPosition(sampleUV, sampleDepth);
            
            // Check if sample is occluded
            float distance = length(samplePos - sampleWorldPos);
            
            if (distance > params.bias) {
                occlusion += 1.0;
            }
        }
    }
    
    // Normalize and apply intensity
    occlusion = 1.0 - (occlusion / float(params.sampleCount)) * params.intensity;
    occlusion = clamp(occlusion, 0.0, 1.0);
    
    // Apply bilateral blur using shared memory
    float blurredOcclusion = 0.0;
    float weightSum = 0.0;
    
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            ivec2 neighborCoord = coord + ivec2(x, y);
            ivec2 sharedCoord = tileCoord + ivec2(x, y);
            
            if (neighborCoord.x >= 0 && neighborCoord.x < size.x &&
                neighborCoord.y >= 0 && neighborCoord.y < size.y) {
                
                float neighborDepth = depthSamples[sharedCoord.x][sharedCoord.y];
                vec3 neighborNormal = normalSamples[sharedCoord.x][sharedCoord.y];
                
                // Weight by depth and normal similarity
                float depthDiff = abs(depth - neighborDepth);
                float normalDiff = 1.0 - dot(normal, neighborNormal);
                
                float weight = exp(-depthDiff * 50.0) * exp(-normalDiff * 10.0);
                
                // Simple occlusion calculation for neighbor
                float neighborOcclusion = occlusion; // Would need full calculation
                
                blurredOcclusion += neighborOcclusion * weight;
                weightSum += weight;
            }
        }
    }
    
    if (weightSum > 0.0) {
        occlusion = blurredOcclusion / weightSum;
    }
    
    imageStore(outputImage, coord, vec4(occlusion, occlusion, occlusion, 1.0));
}
