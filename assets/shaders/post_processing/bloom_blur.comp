#version 450

// Bloom Blur Compute Shader
// High-performance separable Gaussian blur using shared memory

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D inputTexture;
layout(rgba16f) uniform image2D outputImage;

layout(push_constant) uniform BloomBlurParams {
    vec2 texelSize;
    vec2 direction;  // (1,0) for horizontal, (0,1) for vertical
    float sigma;
} params;

// Shared memory for 18x18 tile (16x16 + 1 pixel border)
shared vec3 tile[18][18];

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    
    // Calculate tile position in shared memory
    ivec2 tileCoord = ivec2(gl_LocalInvocationID.xy) + ivec2(1);
    
    // Load 18x18 tile into shared memory (each thread loads multiple pixels)
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 sampleCoord = coord + ivec2(dx, dy);
            ivec2 sharedCoord = tileCoord + ivec2(dx, dy);
            
            vec3 sampleColor = vec3(0.0);
            if (sampleCoord.x >= 0 && sampleCoord.x < size.x &&
                sampleCoord.y >= 0 && sampleCoord.y < size.y) {
                vec2 uv = (vec2(sampleCoord) + 0.5) / vec2(size);
                sampleColor = texture(inputTexture, uv).rgb;
            }
            
            tile[sharedCoord.x][sharedCoord.y] = sampleColor;
        }
    }
    
    // Synchronize all threads in workgroup
    barrier();
    
    // Calculate Gaussian weights
    const int KERNEL_SIZE = 9;
    float weights[KERNEL_SIZE];
    float weightSum = 0.0;
    
    for (int i = 0; i < KERNEL_SIZE; i++) {
        float offset = float(i - KERNEL_SIZE / 2);
        weights[i] = exp(-(offset * offset) / (2.0 * params.sigma * params.sigma));
        weightSum += weights[i];
    }
    
    // Normalize weights
    for (int i = 0; i < KERNEL_SIZE; i++) {
        weights[i] /= weightSum;
    }
    
    // Apply separable Gaussian blur
    vec3 blurredColor = vec3(0.0);
    
    for (int i = 0; i < KERNEL_SIZE; i++) {
        int offset = i - KERNEL_SIZE / 2;
        ivec2 sampleCoord = tileCoord + ivec2(offset * params.direction);
        blurredColor += tile[sampleCoord.x][sampleCoord.y] * weights[i];
    }
    
    // Write result
    imageStore(outputImage, coord, vec4(blurredColor, 1.0));
}
