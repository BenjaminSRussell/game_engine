#version 450

// Enhanced Screen-Space Ambient Occlusion (SSAO) Compute Shader
// Advanced SSAO with multi-scale sampling, temporal accumulation, and quality improvements

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D depthBuffer;
layout(binding = 1) uniform sampler2D normalBuffer;
layout(binding = 2) uniform sampler2D roughnessBuffer;
layout(binding = 3) uniform sampler2D noiseTexture;
layout(binding = 4) uniform sampler2D historyAO; // Temporal accumulation
layout(rgba16f) uniform image2D outputImage;
layout(rgba16f) uniform image2D historyOutput; // For next frame

layout(push_constant) uniform SSAOParams {
    vec2 texelSize;
    float radius;              // World space radius
    float intensity;           // AO intensity
    float bias;                // Depth bias
    u32 sampleCount;           // Number of samples
    vec2 projectionParams;     // x = near, y = far
    float temporalWeight;      // Temporal accumulation weight
    u32 enableTemporal;        // Enable temporal accumulation
    u32 enableMultiScale;      // Enable multi-scale sampling
    u32 qualityLevel;          // 0=low, 1=medium, 2=high, 3=ultra
} params;

// Shared memory for neighborhood samples
shared float depthSamples[18][18];
shared vec3 normalSamples[18][18];
shared float roughnessSamples[18][18];

// Utility functions
vec3 reconstructWorldPosition(vec2 uv, float depth) {
    float ndc_x = uv.x * 2.0 - 1.0;
    float ndc_y = uv.y * 2.0 - 1.0;
    
    // Linearize depth with better precision
    float depthLinear = 2.0 * params.projectionParams.x * params.projectionParams.y / 
                       (params.projectionParams.y + params.projectionParams.x - 
                        ndc_y * (params.projectionParams.y - params.projectionParams.x));
    
    return vec3(ndc_x * depthLinear, depthLinear, ndc_y * depthLinear);
}

vec3 reconstructViewPosition(vec2 uv, float depth) {
    vec3 worldPos = reconstructWorldPosition(uv, depth);
    // Transform to view space (simplified - would need camera matrices)
    return worldPos; // Assuming camera at origin for now
}

// Improved hemisphere sampling with better distribution
vec3 generateSample(int index, vec3 normal, vec2 random, float radiusScale) {
    // Use Fibonacci spiral for better distribution
    float goldenRatio = 1.61803398875;
    float angle = 2.0 * 3.14159 * (float(index) * goldenRatio) + random.x * 2.0 * 3.14159;
    
    // Use cosine-weighted hemisphere sampling
    float cosTheta = sqrt(float(index) / float(params.sampleCount));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    
    vec3 sample;
    sample.x = cos(angle) * sinTheta;
    sample.y = sin(angle) * sinTheta;
    sample.z = cosTheta;
    
    // Apply radius scaling for multi-scale sampling
    sample *= radiusScale;
    
    // Create tangent-space basis
    vec3 tangent = normalize(cross(normal, abs(normal.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    
    return tangent * sample.x + bitangent * sample.y + normal * sample.z;
}

// Multi-scale sampling for better quality
float calculateMultiScaleAO(vec3 worldPos, vec3 normal, vec2 random) {
    float totalOcclusion = 0.0;
    float totalWeight = 0.0;
    
    // Multiple scales for different detail levels
    float scales[3] = {0.5, 1.0, 2.0};
    float weights[3] = {0.25, 0.5, 0.25};
    
    for (int scale = 0; scale < 3; scale++) {
        float scaleOcclusion = 0.0;
        float samplesPerScale = float(params.sampleCount) / 3.0;
        
        for (int i = 0; i < int(samplesPerScale); i++) {
            int sampleIndex = scale * int(samplesPerScale) + i;
            vec3 sampleDir = generateSample(sampleIndex, normal, random, scales[scale]);
            vec3 samplePos = worldPos + sampleDir * params.radius;
            
            // Project to screen space
            vec3 screenPos = vec3(samplePos.x / samplePos.y * 0.5 + 0.5,
                                  samplePos.z / samplePos.y * 0.5 + 0.5,
                                  samplePos.y);
            
            if (screenPos.x >= 0.0 && screenPos.x <= 1.0 && 
                screenPos.y >= 0.0 && screenPos.y <= 1.0 &&
                screenPos.z > 0.0) {
                
                float sampleDepth = texture(depthBuffer, screenPos.xy).r;
                vec3 sampleWorldPos = reconstructWorldPosition(screenPos.xy, sampleDepth);
                
                float distance = length(samplePos - sampleWorldPos);
                float rangeCheck = smoothstep(0.0, params.radius, distance);
                
                // Improved occlusion calculation
                float occlusion = 1.0 - smoothstep(params.bias, params.radius, distance);
                occlusion *= rangeCheck;
                
                // Angle-based attenuation
                float angleFactor = max(0.0, dot(normal, normalize(sampleWorldPos - worldPos)));
                occlusion *= angleFactor;
                
                scaleOcclusion += occlusion;
            }
        }
        
        totalOcclusion += scaleOcclusion * weights[scale];
        totalWeight += weights[scale];
    }
    
    return totalWeight > 0.0 ? totalOcclusion / totalWeight : 0.0;
}

// Standard single-scale AO calculation
float calculateStandardAO(vec3 worldPos, vec3 normal, vec2 random) {
    float occlusion = 0.0;
    
    for (int i = 0; i < params.sampleCount; i++) {
        vec3 sampleDir = generateSample(i, normal, random, 1.0);
        vec3 samplePos = worldPos + sampleDir * params.radius;
        
        // Project to screen space
        vec3 screenPos = vec3(samplePos.x / samplePos.y * 0.5 + 0.5,
                              samplePos.z / samplePos.y * 0.5 + 0.5,
                              samplePos.y);
        
        if (screenPos.x >= 0.0 && screenPos.x <= 1.0 && 
            screenPos.y >= 0.0 && screenPos.y <= 1.0 &&
            screenPos.z > 0.0) {
            
            float sampleDepth = texture(depthBuffer, screenPos.xy).r;
            vec3 sampleWorldPos = reconstructWorldPosition(screenPos.xy, sampleDepth);
            
            float distance = length(samplePos - sampleWorldPos);
            
            // Improved occlusion with better falloff
            float occlusionFactor = 1.0 - smoothstep(params.bias, params.radius, distance);
            
            // Angle-based attenuation
            float angleFactor = max(0.0, dot(normal, normalize(sampleWorldPos - worldPos)));
            occlusionFactor *= angleFactor;
            
            occlusion += occlusionFactor;
        }
    }
    
    return occlusion / float(params.sampleCount);
}

// Bilateral filter for noise reduction
float bilateralFilter(ivec2 coord, float centerAO, float centerDepth, vec3 centerNormal) {
    float totalWeight = 0.0;
    float totalAO = 0.0;
    
    const int kernelSize = 3;
    const float sigmaDepth = 0.01;
    const float sigmaNormal = 0.5;
    
    for (int x = -kernelSize; x <= kernelSize; x++) {
        for (int y = -kernelSize; y <= kernelSize; y++) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            ivec2 sharedCoord = ivec2(gl_LocalInvocationID.xy) + ivec2(x, y) + ivec2(1);
            
            if (sharedCoord.x >= 0 && sharedCoord.x < 18 &&
                sharedCoord.y >= 0 && sharedCoord.y < 18) {
                
                float sampleDepth = depthSamples[sharedCoord.x][sharedCoord.y];
                vec3 sampleNormal = normalSamples[sharedCoord.x][sharedCoord.y];
                
                // Calculate weights
                float spatialWeight = exp(-(x*x + y*y) / (2.0 * kernelSize * kernelSize));
                float depthWeight = exp(-abs(centerDepth - sampleDepth) / sigmaDepth);
                float normalWeight = pow(max(0.0, dot(centerNormal, sampleNormal)), 1.0 / sigmaNormal);
                
                float weight = spatialWeight * depthWeight * normalWeight;
                totalWeight += weight;
                
                // Sample AO from neighboring threads (simplified - would need shared AO)
                totalAO += centerAO * weight; // Simplified for now
            }
        }
    }
    
    return totalWeight > 0.0 ? totalAO / totalWeight : centerAO;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    
    // Load depth, normal, and roughness
    float depth = texture(depthBuffer, uv).r;
    vec3 normal = normalize(texture(normalBuffer, uv).rgb * 2.0 - 1.0);
    float roughness = texture(roughnessBuffer, uv).r;
    
    // Store in shared memory for neighborhood access
    ivec2 tileCoord = ivec2(gl_LocalInvocationID.xy) + ivec2(1);
    depthSamples[tileCoord.x][tileCoord.y] = depth;
    normalSamples[tileCoord.x][tileCoord.y] = normal;
    roughnessSamples[tileCoord.x][tileCoord.y] = roughness;
    
    // Load neighborhood (each thread loads multiple pixels)
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 sampleCoord = coord + ivec2(dx, dy);
            ivec2 sharedCoord = tileCoord + ivec2(dx, dy);
            
            if (sampleCoord.x >= 0 && sampleCoord.x < size.x &&
                sampleCoord.y >= 0 && sampleCoord.y < size.y) {
                vec2 sampleUV = (vec2(sampleCoord) + 0.5) / vec2(size);
                depthSamples[sharedCoord.x][sharedCoord.y] = texture(depthBuffer, sampleUV).r;
                normalSamples[sharedCoord.x][sharedCoord.y] = texture(normalBuffer, sampleUV).rgb * 2.0 - 1.0;
                roughnessSamples[sharedCoord.x][sharedCoord.y] = texture(roughnessBuffer, sampleUV).r;
            }
        }
    }
    
    // Synchronize
    barrier();
    
    // Skip background pixels
    if (depth >= 0.999) {
        imageStore(outputImage, coord, vec4(1.0, 1.0, 1.0, 1.0));
        imageStore(historyOutput, coord, vec4(1.0, 1.0, 1.0, 1.0));
        return;
    }
    
    // Reconstruct world position
    vec3 worldPos = reconstructWorldPosition(uv, depth);
    
    // Get random rotation from noise texture
    vec2 noiseUV = uv * vec2(size.x, size.y) / 4.0;
    vec3 random = texture(noiseTexture, noiseUV).rgb;
    
    // Calculate AO based on quality settings
    float ao;
    if (params.enableMultiScale != 0 && params.qualityLevel >= 2) {
        ao = calculateMultiScaleAO(worldPos, normal, random.xy);
    } else {
        ao = calculateStandardAO(worldPos, normal, random.xy);
    }
    
    // Apply intensity and clamp
    ao = 1.0 - ao * params.intensity;
    ao = clamp(ao, 0.0, 1.0);
    
    // Apply bilateral filter for quality level 2+
    if (params.qualityLevel >= 2) {
        ao = bilateralFilter(coord, ao, depth, normal);
    }
    
    // Roughness-based AO modification
    // Rougher surfaces should have less pronounced AO
    float roughnessFactor = 1.0 - roughness * 0.3;
    ao = mix(ao, 1.0, roughness * 0.2); // Reduce AO on very rough surfaces
    
    // Temporal accumulation
    float finalAO = ao;
    if (params.enableTemporal != 0) {
        // Sample history AO
        vec4 historyAO = texture(historyAO, uv);
        
        // Calculate temporal weight based on various factors
        float temporalWeight = params.temporalWeight;
        
        // Reduce temporal weight for high roughness (less stable)
        temporalWeight *= 1.0 - roughness * 0.5;
        
        // Reduce temporal weight for edges (more prone to ghosting)
        vec2 depthGradient = vec2(
            texture(depthBuffer, uv + vec2(params.texelSize.x, 0.0)).r - 
            texture(depthBuffer, uv - vec2(params.texelSize.x, 0.0)).r,
            texture(depthBuffer, uv + vec2(0.0, params.texelSize.y)).r - 
            texture(depthBuffer, uv - vec2(0.0, params.texelSize.y)).r
        );
        float edgeStrength = length(depthGradient);
        temporalWeight *= 1.0 - clamp(edgeStrength * 100.0, 0.0, 0.8);
        
        // Blend with history
        finalAO = mix(ao, historyAO.r, temporalWeight);
    }
    
    // Write results
    imageStore(outputImage, coord, vec4(finalAO, finalAO, finalAO, 1.0));
    imageStore(historyOutput, coord, vec4(finalAO, finalAO, finalAO, 1.0));
}
