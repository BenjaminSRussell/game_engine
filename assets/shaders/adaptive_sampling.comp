#version 460
#extension GL_EXT_ray_tracing : require

// Adaptive sampling shader - optimizes raytracing performance by varying sample count
// Uses variance estimation to determine where more samples are needed

layout(local_size_x = 8, local_size_y = 8) in;

// Input/output images
layout(binding = 0, rgba16f) uniform image2D input_image;        // Current frame samples
layout(binding = 1, rgba16f) uniform image2D variance_image;    // Variance estimation
layout(binding = 2, rgba16f) uniform image2D sample_count_image; // Sample count per pixel
layout(binding = 3, rgba16f) uniform image2D output_image;       // Final accumulated result

// G-buffer data for importance sampling
layout(binding = 4, r16f) uniform sampler2D depth_buffer;
layout(binding = 5, rgba16f) uniform sampler2D normal_buffer;
layout(binding = 6, rgba16f) uniform sampler2D roughness_buffer;
layout(binding = 7, rgba16f) uniform sampler2D motion_vector_buffer;

// Adaptive sampling parameters
layout(binding = 8) uniform AdaptiveParams {
    vec2 resolution;
    u32 min_samples;           // Minimum samples per pixel
    u32 max_samples;           // Maximum samples per pixel
    float variance_threshold;  // Threshold for increasing samples
    float importance_weight;   // Weight for importance-based sampling
    float temporal_weight;      // Weight for temporal reprojection
    u32 frame_count;
    bool enable_importance_sampling;
    bool enable_temporal_reprojection;
    bool enable_variance_clamping;
    float max_variance;
} adaptive_params;

// Random number generator
uint wang_hash(uint seed) {
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

float rand_float(inout uint seed) {
    seed = wang_hash(seed);
    return float(seed) / 4294967296.0;
}

// Calculate pixel importance based on various factors
float calculate_importance(vec2 uv, float depth, vec3 normal, float roughness) {
    float importance = 1.0;
    
    // Depth-based importance (closer objects are more important)
    float depth_importance = 1.0 - clamp(depth * 2.0, 0.0, 1.0);
    importance = mix(importance, 1.0, depth_importance * adaptive_params.importance_weight);
    
    // Normal-based importance (surfaces facing camera are more important)
    vec3 view_dir = normalize(vec3(0.5, 0.5, 1.0)); // Simplified view direction
    float normal_importance = max(dot(normal, view_dir), 0.0);
    importance = mix(importance, 1.0, normal_importance * adaptive_params.importance_weight);
    
    // Roughness-based importance (rough surfaces need more samples)
    float roughness_importance = roughness;
    importance = mix(importance, 1.0, roughness_importance * adaptive_params.importance_weight);
    
    // Edge detection for importance
    vec2 pixel_size = 1.0 / adaptive_params.resolution;
    float depth_left = texture(depth_buffer, uv + vec2(-pixel_size.x, 0.0)).r;
    float depth_right = texture(depth_buffer, uv + vec2(pixel_size.x, 0.0)).r;
    float depth_top = texture(depth_buffer, uv + vec2(0.0, -pixel_size.y)).r;
    float depth_bottom = texture(depth_buffer, uv + vec2(0.0, pixel_size.y)).r;
    
    float depth_gradient = abs(depth_left - depth_right) + abs(depth_top - depth_bottom);
    float edge_importance = clamp(depth_gradient * 10.0, 0.0, 1.0);
    importance = mix(importance, 1.0, edge_importance * adaptive_params.importance_weight);
    
    return importance;
}

// Estimate local variance
vec3 estimate_variance(vec2 uv) {
    vec3 sum = vec3(0.0);
    vec3 sum_sq = vec3(0.0);
    int count = 0;
    
    // Sample neighboring pixels in a 3x3 window
    for (int x = -1; x <= 1; ++x) {
        for (int y = -1; y <= 1; ++y) {
            vec2 sample_uv = uv + vec2(x, y) / adaptive_params.resolution;
            if (sample_uv.x >= 0.0 && sample_uv.x <= 1.0 && 
                sample_uv.y >= 0.0 && sample_uv.y <= 1.0) {
                vec3 sample_color = imageLoad(input_image, ivec2(sample_uv * adaptive_params.resolution)).rgb;
                sum += sample_color;
                sum_sq += sample_color * sample_color;
                count++;
            }
        }
    }
    
    if (count > 0) {
        vec3 mean = sum / float(count);
        vec3 mean_sq = sum_sq / float(count);
        return mean_sq - mean * mean;
    }
    
    return vec3(0.0);
}

// Determine required sample count based on variance and importance
u32 calculate_sample_count(vec3 variance, float importance, u32 current_samples) {
    // Calculate variance magnitude
    float variance_magnitude = length(variance);
    
    // Clamp variance to prevent excessive sampling
    if (adaptive_params.enable_variance_clamping) {
        variance_magnitude = min(variance_magnitude, adaptive_params.max_variance);
    }
    
    // Base sample count on variance
    float variance_samples = variance_magnitude / adaptive_params.variance_threshold;
    
    // Adjust based on importance
    float importance_samples = variance_samples * importance;
    
    // Convert to integer sample count
    u32 required_samples = uint(ceil(importance_samples));
    
    // Clamp to min/max range
    required_samples = clamp(required_samples, adaptive_params.min_samples, adaptive_params.max_samples);
    
    // Only increase samples, never decrease during frame
    return max(current_samples, required_samples);
}

// Perform temporal reprojection to reuse previous samples
vec3 temporal_reprojection(vec2 uv, vec2 motion_vector) {
    if (!adaptive_params.enable_temporal_reprojection) {
        return vec3(0.0);
    }
    
    // Reproject to previous frame
    vec2 history_uv = uv - motion_vector;
    
    // Check if reprojected UV is valid
    if (history_uv.x < 0.0 || history_uv.x > 1.0 || 
        history_uv.y < 0.0 || history_uv.y > 1.0) {
        return vec3(0.0);
    }
    
    // Get previous frame sample
    ivec2 history_coord = ivec2(history_uv * adaptive_params.resolution);
    vec3 history_color = imageLoad(output_image, history_coord).rgb;
    
    // Get previous frame sample count
    u32 history_samples = uint(imageLoad(sample_count_image, history_coord).r);
    
    // Blend with temporal weight
    return history_color * adaptive_params.temporal_weight * float(history_samples) / float(adaptive_params.max_samples);
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(pixel_coord) + 0.5) / adaptive_params.resolution;
    
    // Check if we're within bounds
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
        return;
    }
    
    // Get current pixel data
    vec3 current_color = imageLoad(input_image, pixel_coord).rgb;
    float depth = texture(depth_buffer, uv).r;
    vec3 normal = normalize(texture(normal_buffer, uv).rgb);
    float roughness = texture(roughness_buffer, uv).r;
    vec2 motion_vector = texture(motion_vector_buffer, uv).rg;
    
    // Skip if no valid depth (background)
    if (depth >= 1.0) {
        imageStore(output_image, pixel_coord, vec4(current_color, 1.0));
        imageStore(sample_count_image, pixel_coord, vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }
    
    // Calculate importance for this pixel
    float importance = 1.0;
    if (adaptive_params.enable_importance_sampling) {
        importance = calculate_importance(uv, depth, normal, roughness);
    }
    
    // Estimate variance
    vec3 variance = estimate_variance(uv);
    imageStore(variance_image, pixel_coord, vec4(variance, 1.0));
    
    // Get current sample count
    u32 current_samples = uint(imageLoad(sample_count_image, pixel_coord).r);
    
    // Calculate required sample count
    u32 required_samples = calculate_sample_count(variance, importance, current_samples);
    
    // Perform temporal reprojection
    vec3 reprojected_color = temporal_reprojection(uv, motion_vector);
    
    // Accumulate samples
    vec3 accumulated_color = current_color + reprojected_color;
    
    // Normalize by sample count
    if (required_samples > 0) {
        accumulated_color /= float(required_samples);
    }
    
    // Store results
    imageStore(output_image, pixel_coord, vec4(accumulated_color, 1.0));
    imageStore(sample_count_image, pixel_coord, vec4(float(required_samples), 0.0, 0.0, 1.0));
}
