{
  "weather_preset": {
    "name": "rainy_day",
    "version": "1.0",
    "description": "Moderate rain with overcast skies",
    
    "sky": {
      "skybox": "textures/sky/overcast.hdr",
      "sun_color": [0.7, 0.7, 0.8],
      "sun_intensity": 0.5,
      "ambient_color": [0.4, 0.45, 0.5],
      "fog_color": [0.6, 0.65, 0.7],
      "fog_density": 0.01,
      "cloud_coverage": 0.8,
      "cloud_speed": 2.0
    },
    
    "precipitation": {
      "type": "rain",
      "intensity": 0.6,
      "particle_count": 5000,
      "wind_direction": [1.0, -0.5, 0.5],
      "wind_strength": 3.0,
      "splash_effects": true,
      "puddle_formation": true
    },
    
    "audio": {
      "ambient": "sounds/ambient/rain_moderate.mp3",
      "volume": 0.5,
      "thunder_enabled": true,
      "thunder_frequency": 30.0,
      "thunder_sounds": [
        "sounds/ambient/thunder_01.mp3",
        "sounds/ambient/thunder_02.mp3",
        "sounds/ambient/thunder_03.mp3"
      ]
    },
    
    "lighting": {
      "directional_light_intensity": 0.5,
      "ambient_light_intensity": 0.3,
      "shadow_strength": 0.6,
      "lightning_flashes": true
    },
    
    "effects": {
      "wet_surfaces": true,
      "wetness_accumulation_rate": 0.1,
      "wetness_dry_rate": 0.02,
      "rainbow_enabled": false,
      "fog_enabled": true
    },
    
    "transition": {
      "blend_time": 10.0,
      "from_weather": "clear_day"
    }
  }
}
