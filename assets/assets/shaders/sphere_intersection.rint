#version 460
#extension GL_EXT_ray_tracing : require

// Intersection shader for procedural sphere primitives (particles, effects)
// This allows for efficient ray-sphere intersection without mesh geometry

hitAttributeEXT vec3 hitNormal;

struct Sphere {
    vec3 center;
    float radius;
    vec3 color;
};

// Sphere data buffer
layout(binding = 4, set = 0, std430) readonly buffer SphereData {
    Sphere spheres[];
};

void main() {
    // Get instance ID to determine which sphere to test
    uint instanceId = gl_InstanceID;
    
    // Get sphere data from buffer
    Sphere sphere = spheres[instanceId];

    // Ray-sphere intersection
    vec3 oc = gl_ObjectRayOriginEXT - sphere.center;
    float a = dot(gl_ObjectRayDirectionEXT, gl_ObjectRayDirectionEXT);
    float b = 2.0 * dot(oc, gl_ObjectRayDirectionEXT);
    float c = dot(oc, oc) - sphere.radius * sphere.radius;
    float discriminant = b * b - 4.0 * a * c;

    if (discriminant >= 0.0) {
        // Ray intersects sphere
        float t = (-b - sqrt(discriminant)) / (2.0 * a);

        if (t > gl_RayTminEXT && t < gl_RayTmaxEXT) {
            // Calculate hit point and normal
            vec3 hitPoint = gl_ObjectRayOriginEXT + t * gl_ObjectRayDirectionEXT;
            hitNormal = normalize(hitPoint - sphere.center);

            // Report intersection
            reportIntersectionEXT(t, 0);
        }
    }
}
