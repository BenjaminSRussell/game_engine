# Issue #443: particle compute init must not read assets/shaders/spv/ when
# that directory is not in the tree. The real shaders are the GLSL sources.
# Do not invent SPIR-V binaries or pass those sources to vkCreateShaderModule.
if(NOT DEFINED PARTICLE_C OR PARTICLE_C STREQUAL "")
    message(FATAL_ERROR "PARTICLE_C is required")
endif()
if(NOT DEFINED SHADER_DIR OR SHADER_DIR STREQUAL "")
    message(FATAL_ERROR "SHADER_DIR is required")
endif()
if(NOT EXISTS "${PARTICLE_C}")
    message(FATAL_ERROR "particle_system_gpu.c not found: ${PARTICLE_C}")
endif()

foreach(src particle_simulate.comp particle_emission.comp)
    set(_shader "${SHADER_DIR}/${src}")
    if(NOT EXISTS "${_shader}")
        message(FATAL_ERROR "real particle shader missing: ${_shader}")
    endif()
    file(READ "${_shader}" _body)
    if(NOT _body MATCHES "^#version 450")
        message(FATAL_ERROR "${src} is not the repo GLSL compute shader")
    endif()
endforeach()

if(EXISTS "${SHADER_DIR}/spv")
    message(FATAL_ERROR "do not invent ${SHADER_DIR}/spv")
endif()
file(GLOB_RECURSE _spv_bins "${SHADER_DIR}/*.spv")
if(_spv_bins)
    message(FATAL_ERROR "do not invent shader binaries: ${_spv_bins}")
endif()

file(READ "${PARTICLE_C}" _content)
foreach(_bad
        "assets/shaders/spv/particle_simulate.comp.spv"
        "assets/shaders/spv/particle_emission.comp.spv")
    string(FIND "${_content}" "${_bad}" _at)
    if(NOT _at EQUAL -1)
        message(FATAL_ERROR "${PARTICLE_C} still references missing ${_bad}")
    endif()
endforeach()

file(STRINGS "${PARTICLE_C}" _lines)
set(_sim 0)
set(_emit 0)
set(_loads 0)
set(_dir_line -1)
set(_null_line -1)
set(_create_line -1)
set(_i 0)
foreach(_line IN LISTS _lines)
    math(EXPR _i "${_i} + 1")
    if(_line MATCHES "create_shader_module\\(.*\\.comp")
        message(FATAL_ERROR "GLSL passed to create_shader_module: ${_line}")
    endif()
    string(STRIP "${_line}" _stripped)
    if(_stripped STREQUAL "\"assets/shaders/particle_simulate.comp\",")
        math(EXPR _sim "${_sim} + 1")
    endif()
    if(_stripped STREQUAL "\"assets/shaders/particle_emission.comp\",")
        math(EXPR _emit "${_emit} + 1")
    endif()
    if(_line MATCHES "load_particle_compute_shader\\(")
        math(EXPR _loads "${_loads} + 1")
    endif()
    if(_stripped STREQUAL "if (stat(\"assets/shaders/spv\", &st) != 0 || !S_ISDIR(st.st_mode)) {")
        set(_dir_line ${_i})
    endif()
    if(_dir_line GREATER 0 AND _null_line LESS 0 AND _stripped STREQUAL "return VK_NULL_HANDLE;")
        set(_null_line ${_i})
    endif()
    if(_stripped STREQUAL "return create_shader_module(device, spv_path);")
        set(_create_line ${_i})
    endif()
endforeach()

if(NOT _sim EQUAL 2)
    message(FATAL_ERROR "expected particle_simulate.comp at both init paths, found ${_sim}")
endif()
if(NOT _emit EQUAL 2)
    message(FATAL_ERROR "expected particle_emission.comp at both init paths, found ${_emit}")
endif()
if(NOT _loads EQUAL 5)
    message(FATAL_ERROR "expected 4 load calls plus the helper, found ${_loads}")
endif()
if(_dir_line LESS 0 OR _null_line LESS 0 OR _create_line LESS 0)
    message(FATAL_ERROR "missing spv-directory failure path in ${PARTICLE_C}")
endif()
if(NOT _null_line GREATER _dir_line OR NOT _create_line GREATER _null_line)
    message(FATAL_ERROR "shader module creation must happen only after the missing-directory check")
endif()

message(STATUS "particle shaders use repo GLSL and fail cleanly without assets/shaders/spv")
