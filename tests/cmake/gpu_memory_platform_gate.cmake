# Issue #179: gpu_memory.c is compiled on non-Apple and excluded on Apple,
# matching the Vulkan backend. Fails if the exclude is unconditional or the
# source is never added to ENGINE_SOURCES.
cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED SOURCE_CMAKE)
    set(SOURCE_CMAKE "${CMAKE_CURRENT_LIST_DIR}/../../cmake/sources.cmake")
endif()
if(NOT EXISTS "${SOURCE_CMAKE}")
    message(FATAL_ERROR "sources.cmake not found: ${SOURCE_CMAKE}")
endif()

file(STRINGS "${SOURCE_CMAKE}" LINES)
set(MODES "root")
set(path_ok FALSE)
set(exclude_apple FALSE)
set(exclude_unconditional FALSE)

foreach(LINE IN LISTS LINES)
    string(STRIP "${LINE}" T)
    if(T MATCHES "^if[ \t]*\\(.*\\)[ \t]*$")
        list(GET MODES -1 PARENT)
        if(T MATCHES "^if[ \t]*\\([ \t]*APPLE[ \t]*\\)[ \t]*$")
            list(APPEND MODES "apple")
        elseif(T MATCHES "^if[ \t]*\\([ \t]*NOT[ \t]+APPLE[ \t]*\\)[ \t]*$")
            list(APPEND MODES "notapple")
        else()
            list(APPEND MODES "${PARENT}")
        endif()
    elseif(T MATCHES "^else[ \t]*\\([ \t]*\\)[ \t]*$")
        list(GET MODES -1 TOP)
        list(POP_BACK MODES)
        if(TOP STREQUAL "apple")
            list(APPEND MODES "notapple")
        elseif(TOP STREQUAL "notapple")
            list(APPEND MODES "apple")
        else()
            list(APPEND MODES "${TOP}")
        endif()
    elseif(T MATCHES "^endif[ \t]*\\(")
        list(LENGTH MODES MLEN)
        if(MLEN LESS 2)
            message(FATAL_ERROR "endif without if while parsing ${SOURCE_CMAKE}")
        endif()
        list(POP_BACK MODES)
    endif()

    list(GET MODES -1 HERE)

    string(FIND "${T}" "src/engine/core/memory/gpu_memory.c\"" QUOTED)
    if(NOT QUOTED EQUAL -1)
        if(HERE STREQUAL "apple")
            message(FATAL_ERROR "gpu_memory.c is listed only inside if(APPLE)")
        endif()
        set(path_ok TRUE)
    endif()

    if(T MATCHES "EXCLUDE" AND T MATCHES "gpu_memory")
        if(HERE STREQUAL "apple")
            set(exclude_apple TRUE)
        elseif(HERE STREQUAL "root")
            set(exclude_unconditional TRUE)
        elseif(HERE STREQUAL "notapple")
            message(FATAL_ERROR "gpu_memory.c is excluded on non-Apple platforms")
        endif()
    endif()
endforeach()

if(exclude_unconditional)
    message(FATAL_ERROR "gpu_memory.c is excluded unconditionally")
endif()
if(NOT path_ok)
    message(FATAL_ERROR "gpu_memory.c is not listed for non-Apple ENGINE_SOURCES")
endif()
if(NOT exclude_apple)
    message(FATAL_ERROR "gpu_memory.c is not excluded when APPLE is true")
endif()

message(STATUS "gpu_memory platform gate OK")
